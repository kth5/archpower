  pkgdesc="Poppler Qt6 bindings"
  depends=("poppler=${pkgver}" 'qt6-base' 'lcms2' 'freetype2' 'libgcc' 'libstdc++' 'glibc')
  provides=('libpoppler-qt6.so')

  cd build

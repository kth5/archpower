# POWER Maintainer: Alexander Baldeck <alex.bldck@gmail.com>
# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=perl-io-compress-brotli
epoch=1
pkgver=0.023
pkgrel=1
pkgdesc='Read/write Brotli buffers/streams'
url="https://metacpan.org/release/IO-Compress-Brotli"
arch=(x86_64 powerpc64le powerpc64 powerpc espresso)
license=('Artistic-1.0-Perl' 'GPL-1.0-or-later')
options=('!emptydirs')
depends=('perl' 'brotli' 'perl-file-slurper')
source=("https://search.cpan.org/CPAN/authors/id/T/TI/TIMLEGGE/IO-Compress-Brotli-$pkgver.tar.gz"
        use-system-brotli.patch)
sha512sums=('e1e0d22013cd514da82241ded6b46153a7c94b88489aa3cb3d8a1c0c948dfe3b51c9fd3e10162f62b47d72ee57563436d48c5d58383507affffce01f656169fe'
            '76b94281a1f8a88bdd62d19527626636064bb6174d7c8e7fa83b6bb8ea6f8bd91c632a336e62e9d6d2ee70345243b0fdc8f227e3b87d0dd482c1b46c4dcf269e')

prepare() {
  cd IO-Compress-Brotli-$pkgver
  # Link against system Brotli instead of building the bundled static libraries.
  patch -p0 -i ../use-system-brotli.patch
}

build() {
  cd IO-Compress-Brotli-$pkgver
  perl Makefile.PL INSTALLDIRS=vendor
  make
}

check() {
  cd IO-Compress-Brotli-$pkgver
  make test
}

package() {
  cd IO-Compress-Brotli-$pkgver
  make install DESTDIR="$pkgdir"
}


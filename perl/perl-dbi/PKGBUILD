# POWER Maintainer: Alexander Baldeck <alex.bldck@gmail.com>
# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=perl-dbi
pkgver=1.656
pkgrel=2
pkgdesc="Database independent interface for Perl"
arch=(x86_64 powerpc64le powerpc64 powerpc espresso)
url="https://metacpan.org/release/DBI"
license=('GPL-1.0-or-later' 'Artistic-1.0-Perl')
depends=('perl')
options=('!emptydirs')
source=("https://cpan.metacpan.org/authors/id/H/HM/HMBRAND/DBI-$pkgver.tgz")
sha512sums=('c509df515706123f2bb5576708eca92d2ce9b3cf556671c762733f23ab2ec917146ba6ebf41638477c6e2bc53c1208ec64bdbe4467396a78aa252a5bde7ccf4c')

build() {
  cd DBI-$pkgver
  perl Makefile.PL INSTALLDIRS=vendor
  make
}

check() {
  cd DBI-$pkgver
  make test
}

package() {
  cd DBI-$pkgver
  make DESTDIR="$pkgdir" install
}

# Contributor: Solomon Choina <shlomochoina@gmail.com>

pkgname=dht
pkgver=0.28
pkgrel=1
pkgdesc='BitTorrent DHT library'
arch=(x86_64 powerpc64le powerpc64 powerpc espresso)
url='https://github.com/jech/dht'
license=(MIT)
makedepends=(cmake)
source=(https://github.com/jech/dht/archive/refs/tags/$pkgname-$pkgver.tar.gz
        dht-cmake-1.patch::https://github.com/transmission/dht/commit/015585510e402a057ec17142711ba2b568b5fd62.patch
        dht-cmake-2.patch::https://github.com/transmission/dht/commit/38c9f261d9b58b76b9eaf85f84ec1b35151a1eac.patch)
sha256sums=('2f91db29636ca84503b4bb59d7a4a6a681c3a547e12ef775f83e99b69be92f2d'
            'd0ae373f650a96b579a6a1aac824fbcb0041254d1bc1bdcc7e09cd854f1d5b38'
            'f767d6a1c01b426b1717686b9329e89df798ae93e13a84b81be224211e189d4f')

prepare() {
  # Add cmake support
  patch -d dht-dht-$pkgver -p1 < dht-cmake-1.patch
  patch -d dht-dht-$pkgver -p1 < dht-cmake-2.patch
}

build() {
  cmake -B build -S dht-dht-$pkgver \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_C_FLAGS="$CFLAGS -ffat-lto-objects"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 dht-dht-$pkgver/LICENCE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}

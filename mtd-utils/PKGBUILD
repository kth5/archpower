pkgname=mtd-utils
pkgver=2.3.1
pkgrel=1
pkgdesc='Utilities for dealing with MTD devices'
url='http://www.linux-mtd.infradead.org/'
arch=(x86_64 powerpc64le powerpc64 powerpc espresso)
license=(GPL-2.0-only)
depends=(
  bash
  glibc
  lzo
  openssl
  util-linux-libs
  zlib
  zstd
)
makedepends=(
  cmocka
  git
)
source=("git+git://git.infradead.org/mtd-utils.git#tag=v${pkgver}?signed")
b2sums=('c6deafa0be8575b7f1f03107d7b46966535996d1ea90b9fbc2f007dd25246c30ed61eda272ca27ca3cffd64cd877fd9d54f76bcef0ea8edf9c3030ccc297e9fb')
validpgpkeys=('13063F723C9E584AEACD5B9BBCE5DC3C741A02D1') # David Oberhollenzer <david.oberhollenzer@sigma-star.at>

prepare() {
  cd ${pkgname}
  autoreconf -fiv
}

build() {
  cd ${pkgname}
  # Tests fail with fortification enabled
  export CFLAGS="${CFLAGS/-Wp,-D_FORTIFY_SOURCE=?/}"
  ./configure \
    --prefix=/usr \
    --libexecdir=/usr/lib \
    --sbindir=/usr/bin \
    --enable-unit-tests \
    --with-tests
  make
}

check() {
  case "${CARCH}" in
    powerpc*) return 0 ;;
  esac

  cd ${pkgname}
  make check -j1
}

package() {
  cd ${pkgname}
  make DESTDIR="${pkgdir}" install
}


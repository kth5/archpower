pkgname=opensc
pkgver=0.27.1
pkgrel=3
pkgdesc='Tools and libraries for smart cards'
arch=(x86_64 powerpc64le powerpc64 powerpc espresso)
url='https://github.com/OpenSC/OpenSC/wiki'
license=('LGPL')
depends=(
  glib2
  openpace
  pcsclite
)
makedepends=(
  docbook-xsl
  git
)
backup=('etc/opensc.conf')
options=(!emptydirs !lto)
source=("git+https://github.com/OpenSC/OpenSC.git#tag=${pkgver}")
sha512sums=('67fca998cd4915ea85db87db1f7d99dc3e4f2d85273bea69edbd7d702882b8a1fbfb19c4dbeaf594271edafd1af8d815f9e487a76bf5361382e7de742711d158')

prepare() {
  # Fix build failure with OpenSSL 4
  git -C OpenSC cherry-pick -n 8ad96adc5fea0cef923a2a679600f3a5c4c5bfce 86c5005b246360f8e0ab1edfac19d568a949bfa1
}

build() {
  cd OpenSC

  _sheetdir=(/usr/share/xml/docbook/xsl-stylesheets-*-nons)

  ./bootstrap
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --with-completiondir=/usr/share/bash-completion/completions \
    --enable-man \
    --enable-doc \
    --enable-readline \
    --enable-openpace \
    --enable-openssl \
    --enable-pcsc \
    --enable-zlib \
    --enable-sm \
    --disable-strict \
    --with-xsl-stylesheetsdir="$_sheetdir"

  sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool

  make
}

package(){
  cd OpenSC

  make DESTDIR="$pkgdir" install

  install -D -m644 etc/opensc.conf "$pkgdir/etc/opensc.conf"
}


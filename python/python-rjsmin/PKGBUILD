# POWER Maintainer: Alexander Baldeck <alex.bldck@gmail.com>
# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=python-rjsmin
_name="${pkgname#python-}"
pkgver=1.3.0
pkgrel=1
pkgdesc="Fast javascript minifier for Python"
arch=(x86_64 powerpc64le powerpc64 powerpc espresso)
url="https://github.com/ndparker/rjsmin"
license=(Apache-2.0)
depends=(
  glibc
  python
)
makedepends=(
  python-build
  python-installer
  python-setuptools
  python-wheel
)
checkdepends=(python-pytest)
source=($_name-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz)
sha512sums=('6db8a71820109ea764cf80226f50b9bbc61c2eb040dd66a73833afa2237d66c5f670f3d557e1e0b98dbecbbb9b5b34d6d839ef5aa903fd0c791e8dec31664ab3')
b2sums=('3d5f0f9793118434897736b14c04fe9c5ce10669bc1b4257c534f09dc2c773b00f0f7e4764ee2cb0889da6abd8deb1481949d49a37e16f73dbeab03958b9d313')

build() {
  cd $_name-$pkgver
  python -m build --wheel --no-isolation
}

check() {
  local _site_packages=$(python -c "import site; print(site.getsitepackages()[0])")

  cd $_name-$pkgver
  # install to temporary location, as importlib is used
  python -m installer --destdir=test_dir dist/*.whl
  export PYTHONPATH="test_dir/$_site_packages:$PYTHONPATH"
  pytest -vv
}

package() {
  cd $_name-$pkgver
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -vDm 644 {docs/DESCRIPTION,CHANGES,README.md} -t "$pkgdir/usr/share/doc/$pkgname/"
}

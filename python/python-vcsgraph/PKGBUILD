# Maintainer:

pkgname=python-vcsgraph
pkgver=0.3.2
pkgrel=1
pkgdesc='VCS graph operations'
arch=(x86_64 powerpc64le powerpc64 powerpc espresso)
url='https://github.com/breezy-team/vcsgraph'
license=(GPL-2.0-or-later)
depends=(glibc
         libgcc
         python)
makedepends=(git
             python-build
             python-installer
             python-setuptools-rust)
source=(git+https://github.com/breezy-team/vcsgraph#tag=v$pkgver)
sha256sums=('7f507930fd75eecbc1cfa249df8c68e899091b203605175efa756559f9df9b8d')

build() {
  cd vcsgraph
  python -m build --wheel --no-isolation
}

package() {
  cd vcsgraph
  python -m installer --destdir="$pkgdir" dist/*.whl
}

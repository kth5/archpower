pkgname=pypy
pkgver=8.0.1
pkgrel=2
pkgdesc="A Python implementation written in Python, JIT enabled"
url="https://pypy.org"
arch=(x86_64 powerpc64le)
depends=('expat' 'bzip2' 'gdbm' 'openssl' 'libffi' 'zlib' 'ncurses')
makedepends=('pypy' 'tk' 'sqlite' 'mercurial')
optdepends=('sqlite: sqlite module'
            'tk: tk module')
license=('MIT')
source=("https://downloads.python.org/pypy/pypy2.7-v${pkgver}-src.tar.gz"
        "pypy-openssl-4.patch::https://github.com/pypy/pypy/compare/89d59559f278da492b27b562dc812789a3bbbf0f...fc2f20bd2152b9155af0a854fbbfef9c24d19e57.patch")
sha512sums=('18455b0509117e742ee29dfe3b8ae4fbde6fa5ed9f8271c7220995775a4f570134809b62a1ff25402d1275aae67b8ec3bfc5bd80a83e95f0058ca18d0eb6f994'
            '1bf3ad7434d638835b2b0afb692435eb67ab4e316bb52feb9b4f3f9be7b355cdc9c405440a2d7837909ead06d854e6df259fa7b82ce514e5ac009a184a4cfd82')

prepare() {
  cd pypy2.7-v${pkgver}-src

  # Fix SSL bindings for the API changes in OpenSSL 4.
  # https://github.com/pypy/pypy/pull/5489
  patch -Np1 -i ../pypy-openssl-4.patch
}

build() {
  cd pypy2.7-v${pkgver}-src/pypy/goal

  pypy ../../rpython/bin/rpython -Ojit --shared targetpypystandalone

  # Compile binary modules
  PYTHONPATH=../.. ./pypy-c ../../lib_pypy/pypy_tools/build_cffi_imports.py
}

package() {
  cd pypy2.7-v${pkgver}-src

  # Prepare installation
  pypy pypy/tool/release/package.py --archive-name pypy --targetdir .
  mkdir unpacked
  tar xf pypy.tar.gz -C unpacked

  # Install pypy
  cd unpacked
  install -Dm755 pypy/bin/pypy "${pkgdir}"/opt/pypy/bin/pypy
  install -Dm755 pypy/bin/libpypy-c.so "${pkgdir}"/opt/pypy/bin/libpypy-c.so
  cp -r pypy/include pypy/lib_pypy pypy/lib-python pypy/site-packages "${pkgdir}"/opt/pypy/
  cd ..

  # Install symlink
  mkdir -p "${pkgdir}"/usr/bin "${pkgdir}"/usr/lib
  ln -s /opt/pypy/bin/pypy "${pkgdir}"/usr/bin/pypy
  ln -s /opt/pypy/bin/libpypy-c.so "${pkgdir}"/usr/lib/libpypy-c.so

  # Install misc stuff
  install -Dm644 README.rst "${pkgdir}"/opt/pypy/README.rst
  install -Dm644 LICENSE "${pkgdir}"/opt/pypy/LICENSE
  install -Dm644 LICENSE "${pkgdir}"/usr/share/licenses/pypy/LICENSE
}

pkgname=libxrender
pkgver=0.9.13
pkgrel=1
pkgdesc="X Rendering Extension client library"
arch=(x86_64 powerpc64le powerpc64 powerpc espresso)
url="https://xorg.freedesktop.org/"
license=('HPND-sell-variant')
depends=('libx11' 'glibc' 'xorgproto')
makedepends=('git' 'xorg-util-macros')
source=(git+https://gitlab.freedesktop.org/xorg/lib/libxrender.git?signed#tag=libXrender-${pkgver})
sha512sums=('6291d3c95642ed44561991f9900f0f734dddee039be55c1b189700754f64548cd3c27beb71600f7b72e2e795ef58b3fc7407424d06973b19510e4ef7a064ba60')
validpgpkeys=('3AB285232C46AE43D8E192F4DAB0F78EA6E7E2D2') # Alan Coopersmith <alan.coopersmith@oracle.com>
#validpgpkeys+=('C41C985FDCF1E5364576638B687393EE37D128F8') # Matthieu Herrb <matthieu.herrb@laas.fr>

prepare() {
  cd libxrender
  autoreconf -fiv
}

build() {
  cd libxrender
  ./configure --prefix=/usr --disable-static
  make
}

package() {
  cd libxrender
  make DESTDIR="${pkgdir}" install
  install -Dm644 COPYING "${pkgdir}/usr/share/licenses/${pkgname}/COPYING"
}

pkgname=xorg-xload
pkgver=1.2.1
pkgrel=1
pkgdesc="System load average display for X"
arch=(x86_64 powerpc64le powerpc64 powerpc espresso)
url="https://xorg.freedesktop.org/"
license=('X11')
depends=('libxaw' 'libxmu' 'libxt' 'libx11' 'glibc')
makedepends=('xorg-util-macros')
source=(https://xorg.freedesktop.org/archive/individual/app/xload-${pkgver}.tar.xz{,.sig})
sha512sums=('55bdf254d7521a54a9dc771a7e8d3d2750a64d8ec8274c3d2394cbe40358b03525a39d1e10c637bd9e66ee7f956d9aa55ae6c416a2611a35718e01f3b491fde1'
            'SKIP')
validpgpkeys=('3AB285232C46AE43D8E192F4DAB0F78EA6E7E2D2') # "Alan Coopersmith <alan.coopersmith@oracle.com>"

build() {
  cd xload-${pkgver}
  ./configure --prefix=/usr
  make
}

package() {
  cd xload-${pkgver}
  make DESTDIR="${pkgdir}" install
  install -Dm644 COPYING "${pkgdir}/usr/share/licenses/${pkgname}/COPYING"
}

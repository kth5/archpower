# Contributor: Jan de Groot <jgc@archlinux.org>

pkgname=libxtst
pkgver=1.2.6
pkgrel=1
pkgdesc="library for XTEST & RECORD extensions"
arch=(x86_64 powerpc64le powerpc64 powerpc espresso)
url="https://gitlab.freedesktop.org/xorg/lib/libxtst"
license=('MIT-open-group'
         'HPND-sell-variant'
         'X11'
         'HPND-doc'
         'HPND-doc-sell')
depends=('libxext' 'libxi' 'libx11' 'glibc' 'xorgproto')
makedepends=('git' 'xorg-util-macros')
source=(git+https://gitlab.freedesktop.org/xorg/lib/libxtst.git?signed#tag=libXtst-${pkgver})
sha512sums=('fd5e1e3c81d4876730f47b4051954d19ca9ffc42a5fa0b0381db1ae9e642a119440187ae4bb307f0c54b823a3ef591d6b87cb414aedc9d348f7f217a4cf97570')
#validpgpkeys=('C41C985FDCF1E5364576638B687393EE37D128F8') # Matthieu Herrb <matthieu.herrb@laas.fr>
validpgpkeys=('3AB285232C46AE43D8E192F4DAB0F78EA6E7E2D2') # Alan Coopersmith <alan.coopersmith@oracle.com>

prepare() {
  cd libxtst
  autoreconf -fiv
}

build() {
  cd libxtst
  ./configure --prefix=/usr --disable-static
  sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool
  make
}

package() {
  cd libxtst
  make DESTDIR="${pkgdir}" install

  install -m755 -d "${pkgdir}/usr/share/licenses/${pkgname}"
  install -m644 COPYING "${pkgdir}/usr/share/licenses/${pkgname}/"
}

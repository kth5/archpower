case "${CARCH}" in
  powerpc64le|powerpc) options+=(!debug !lto) ;;
esac

prepare() {
  cd webkitgtk-$pkgver
  patch -Np1 -i ${srcdir}/reduce-memory-overheads.patch
  patch -Np1 -i ${srcdir}/2.52.1-documentloader-eventloop-h.patch
  patch -Np1 -i ${srcdir}/2.54.2-libpas-32bit.patch
  patch -Np1 -i ${srcdir}/2.54.2-skia-big-endian.patch
  patch -Np1 -i ${srcdir}/2.54.2-sequencelocked-32bit.patch
}

build() {
  local cmake_options=(
    -D CMAKE_BUILD_TYPE=Release
    -D CMAKE_INSTALL_LIBDIR=lib
    -D CMAKE_INSTALL_LIBEXECDIR=lib
    -D CMAKE_INSTALL_PREFIX=/usr
    -D CMAKE_SKIP_RPATH=ON
    -D ENABLE_DOCUMENTATION=ON
    -D ENABLE_MINIBROWSER=ON
    -D ENABLE_SPEECH_SYNTHESIS=OFF
    -D PORT=GTK
    -D USE_FLITE=OFF
    -D USE_GTK4=OFF
    -D USE_LIBBACKTRACE=OFF
    -D USE_SOUP2=OFF
  )

  case "${CARCH}" in
    powerpc64le)
      export CXXFLAGS+=' -DSKCMS_HAS_MUSTTAIL=0 -mminimal-toc'
      export CFLAGS+=' -DSKCMS_HAS_MUSTTAIL=0 -mminimal-toc'
      export LDFLAGS+=' -Wl,--no-keep-memory'
    ;;
    powerpc64)
      export CFLAGS='-mcpu=powerpc64 -O2 -pipe -mminimal-toc'
      export CXXFLAGS='-mcpu=powerpc64 -O2 -pipe -mminimal-toc'
      export LDFLAGS+=' -Wl,--no-keep-memory'
    ;;
    powerpc)
      export LDFLAGS+=" -Wl,--no-keep-memory"
      export CXXFLAGS+=' -mminimal-toc'
      export LDFLAGS+=' -Wl,--no-keep-memory'
      export PATH=/usr/lib/distcc:$PATH
    ;;
    x86_64)
      # Upstream prefers Clang
      # https://gitlab.archlinux.org/archlinux/packaging/packages/webkitgtk-6.0/-/issues/4
      export CC=clang CXX=clang++
      LDFLAGS+=" -fuse-ld=lld"

      # JITted code crashes when CET is used
      CFLAGS+=' -fcf-protection=none'
      CXXFLAGS+=' -fcf-protection=none'
    ;;
  esac

  # Skia uses malloc_usable_size
  CFLAGS="${CFLAGS/_FORTIFY_SOURCE=?/_FORTIFY_SOURCE=2}"
  CXXFLAGS="${CXXFLAGS/_FORTIFY_SOURCE=?/_FORTIFY_SOURCE=2}"

  # JITted code crashes when CET is used
  CFLAGS+=' -fcf-protection=none'
  CXXFLAGS+=' -fcf-protection=none'

  cmake -S webkitgtk-$pkgver -B build -G Ninja "${cmake_options[@]}"
  cmake --build build ${MAKEFLAGS}
}

package_webkit2gtk-4.1() {
  optdepends=(
    'geoclue: Geolocation support'
    'gst-libav: nonfree media decoding'
    'gst-plugins-bad: media decoding'
    'gst-plugins-good: media decoding'
  )
  provides=(
    libjavascriptcoregtk-4.1.so
    libwebkit2gtk-4.1.so
  )

  DESTDIR="$pkgdir" cmake --install build

  rm -r "$pkgdir/usr/bin"

  mkdir -p doc/usr/share
  mv {"$pkgdir",doc}/usr/share/doc

  cd webkitgtk-$pkgver
  find Source -name 'COPYING*' -or -name 'LICENSE*' -print0 | sort -z |
    while IFS= read -d $'\0' -r _f; do
      echo "### $_f ###"
      cat "$_f"
      echo
    done |
    install -Dm644 /dev/stdin "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

package_webkit2gtk-4.1-docs() {
  pkgdesc+=" (documentation)"
  depends=()

  mv doc/* "$pkgdir"
}


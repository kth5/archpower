pkgname=x265
pkgver=4.3
pkgrel=1
pkgdesc='Open Source H265/HEVC video encoder'
arch=(x86_64 powerpc64le powerpc64 powerpc espresso)
url=https://www.x265.org/
license=(GPL-2.0-or-later)
depends=(
  glibc
  libgcc
  libstdc++
)
makedepends=(
  cmake
  git
  ninja
)
makedepends_x86_64=(nasm)
provides=(libx265.so)
source=(
  "git+https://github.com/Multicorewareinc/x265.git#tag=${pkgver}"
  0001-Fix-build-with-GCC-15.patch
  "${pkgname}-${pkgver}-32bit-atomics.patch::https://patch-diff.githubusercontent.com/raw/pavel-odintsov/fastnetmon/pull/705.patch"
)
b2sums=('bbbe9e0e595c1de114ddc08c4f13f6ce1e7490837749cb389682a9aaa28fe42707abcdea856aebb5fe805ea5c0500c4350c35afe90b7280fd1ea295fd5d469ab'
        'af2ee0460c0c2f6f36e4f124a9ac16610e3884001262a6f08043fa1de4a85e2b5fd4fb12c64b8c94cfb59c3031bb7a1324e307fa2049e3378e2add9a58f5bd9e'
        '2f846c706345da170ee0209d12b34e05281f0d93671d56e1cd19cecdea559439fb932cc7a025cc8f4ffbe3b7830cd170c752a49a3bf877df1dd01ca89433af34')

prepare() {
  cd x265

  # 32bit lacks _sync_atomic_add_fetch_8 # PR932
  git cherry-pick --no-commit c023445b884cc949dde26e9b1ea1ce32bf289c9d 

  # Fix build with GCC 15
  git apply -3 ../0001-Fix-build-with-GCC-15.patch
}

build() {
  case "${CARCH}" in
    powerpc64le) 
      cmake_options_12=(-DENABLE_ALTIVEC=OFF -DCPU_POWER8=ON)
      cmake_options_10=(-DENABLE_ALTIVEC=OFF -DCPU_POWER8=ON)
      cmake_options=(-DENABLE_ALTIVEC=ON -DCPU_POWER8=ON -DENABLE_PIC=ON)
    ;;
    powerpc64)
      cmake_options_12=(-DENABLE_ALTIVEC=OFF -DCPU_POWER8=OFF)
      cmake_options_10=(-DENABLE_ALTIVEC=OFF -DCPU_POWER8=OFF)
      cmake_options=(-DENABLE_ALTIVEC=OFF -DCPU_POWER8=OFF -DENABLE_PIC=ON)
    ;;
    powerpc)
      cmake_options_12=(-DENABLE_ALTIVEC=OFF -DCPU_POWER8=OFF)
      cmake_options_10=(-DENABLE_ALTIVEC=OFF -DCPU_POWER8=OFF)
      cmake_options=(-DENABLE_ALTIVEC=ON -DCPU_POWER8=OFF -DENABLE_PIC=ON)
    ;;
  esac


  cmake -S x265/source -B build-12 -G Ninja \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DHIGH_BIT_DEPTH=TRUE \
    -DMAIN12=TRUE \
    -DEXPORT_C_API=FALSE \
    -DENABLE_CLI=FALSE \
    -DENABLE_SHARED=FALSE \
    -Wno-dev ${cmake_options_12[@]}
  ninja -C build-12

  cmake -S x265/source -B build-10 -G Ninja \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DHIGH_BIT_DEPTH=TRUE \
    -DEXPORT_C_API=FALSE \
    -DENABLE_CLI=FALSE \
    -DENABLE_SHARED=FALSE \
    -Wno-dev ${cmake_options_10[@]}
  ninja -C build-10

  cmake -S x265/source -B build -G Ninja \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DENABLE_SHARED=TRUE \
    -DENABLE_HDR10_PLUS=TRUE \
    -DEXTRA_LIB='x265_main10.a;x265_main12.a' \
    -DEXTRA_LINK_FLAGS='-L .' \
    -DLINKED_10BIT=TRUE \
    -DLINKED_12BIT=TRUE \
    -Wno-dev ${cmake_options[@]}
  ln -s ../build-10/libx265.a build/libx265_main10.a
  ln -s ../build-12/libx265.a build/libx265_main12.a
  ninja -C build
}

package() {
  DESTDIR="${pkgdir}" ninja -C build install
}


pkgname=audacious
pkgver=4.6.2
pkgrel=1
pkgdesc='Lightweight, advanced audio player focused on audio quality'
arch=(x86_64 powerpc64le powerpc64 powerpc espresso)
url='https://audacious-media-player.org/'
license=(BSD-2-Clause)
depends=(
  cairo
  gdk-pixbuf2
  glib2
  glibc
  gtk3
  hicolor-icon-theme
  libgcc
  libstdc++
  pango
  qt6-base
  qt6-imageformats
  qt6-svg
)
makedepends=(
  git
  glib2-devel
  meson
)
optdepends=('unzip: zipped skins support')
source=("git+https://github.com/audacious-media-player/audacious.git#tag=$pkgname-$pkgver")
b2sums=(b73d439799bcdf9f48462c7a7765fffa8ef6e0e13c90c179a5371bb526c772a5a0817b3a86bae1fad43895ba990774f822ffbb6dfc8f47e3cacc355d5137c07c)

build() {
  _PRETTY_NAME=`sed -n 's/^PRETTY_NAME="\([^"]*\)"/\1/p' /etc/os-release`
  arch-meson $pkgname build \
    -D buildstamp="$_PRETTY_NAME"
  meson compile -C build
}

package() {
  depends+=(audacious-plugins)

  meson install -C build --destdir "$pkgdir"
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname/" $pkgname/COPYING
}

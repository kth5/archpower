pkgname = postfix
	install = postfix.install
	depends = glibc
	depends = icu
	depends = libicuuc.so
	depends = libnsl
	depends = libnsl.so
	depends = libsasl
	depends = libsasl2.so
	depends = libtlsrpt
	depends = libtlsrpt.so
	depends = openssl
	depends = libcrypto.so
	depends = libssl.so
	depends = postfix-lmdb
	depends = sh
	optdepends = perl: for postfix-collate.pl, postfix-tlstype.pl and qshape
	optdepends = postfix-cdb: for CDB integration
	optdepends = postfix-ldap: for LDAP integration
	optdepends = postfix-lmdb: for LMDB integration
	optdepends = postfix-mongodb: for MongoDB integration
	optdepends = postfix-mysql: for MySQL integration
	optdepends = postfix-pcre: for PCRE integration
	optdepends = postfix-pgsql: for PostgreSQL integration
	optdepends = postfix-sqlite: for SQLite integration
	provides = smtp-server
	provides = smtp-forwarder
	conflicts = smtp-server
	conflicts = smtp-forwarder
	backup = etc/postfix/access
	backup = etc/postfix/aliases
	backup = etc/postfix/canonical
	backup = etc/postfix/generic
	backup = etc/postfix/header_checks
	backup = etc/postfix/main.cf
	backup = etc/postfix/master.cf
	backup = etc/postfix/relocated
	backup = etc/postfix/transport
	backup = etc/postfix/virtual

pkgname = postfix-cdb
	pkgdesc = Fast, easy to administer, secure mail server (CDB integration)
	depends = glibc
	depends = postfix
	depends = tinycdb
	depends = libcdb.so

pkgname = postfix-ldap
	pkgdesc = Fast, easy to administer, secure mail server (LDAP integration)
	depends = glibc
	depends = libldap
	depends = postfix

pkgname = postfix-lmdb
	pkgdesc = Fast, easy to administer, secure mail server (LMDB integration)
	depends = glibc
	depends = lmdb
	depends = postfix

pkgname = postfix-mongodb
	pkgdesc = Fast, easy to administer, secure mail server (MongoDB integration)
	depends = glibc
	depends = mongo-c-driver
	depends = postfix

pkgname = postfix-mysql
	pkgdesc = Fast, easy to administer, secure mail server (MySQL integration)
	depends = glibc
	depends = mariadb-libs
	depends = libmariadb.so
	depends = postfix

pkgname = postfix-pcre
	pkgdesc = Fast, easy to administer, secure mail server (PCRE integration)
	depends = glibc
	depends = pcre2
	depends = libpcre2-8.so
	depends = postfix

pkgname = postfix-pgsql
	pkgdesc = Fast, easy to administer, secure mail server (PostgreSQL integration)
	depends = glibc
	depends = postfix
	depends = postgresql-libs
	depends = libpq.so

pkgname = postfix-sqlite
	pkgdesc = Fast, easy to administer, secure mail server (SQLite integration)
	depends = glibc
	depends = postfix
	depends = sqlite
	depends = libsqlite3.so

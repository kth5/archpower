pkgname=socat
pkgver=1.8.1.3
pkgrel=2
pkgdesc='Multipurpose relay'
url='http://www.dest-unreach.org/socat/'
license=('GPL-2.0-only')
arch=(x86_64 powerpc64le powerpc64 powerpc espresso)
depends=(
  'glibc'
  'openssl' 'libssl.so'
  'readline' 'libreadline.so'
)
checkdepends=(
  'bash'
  'net-tools'
  'procps-ng'
)
source=("http://www.dest-unreach.org/socat/download/${pkgname}-${pkgver}.tar.gz"
        "socat-1.8.1.3-openssl4_fixes-1.patch")
sha256sums=('06602ffd591e98c75b3dc1d66f0f19136cc666b0b2d95caad987d6ab2cb28097'
            '7f2827c929bbd1441893780c35c929dd3631cd19a8fa14e993a3e8b10e63c2c2')
b2sums=('5d62f45d0d16ac23218c288d2c31ef85fb5f78de68e8612bb6ae647c4e1af9382f80b575bb4f38f458180813b2a6c762dedd6579eec99b355ca608a4c98e18cd'
        'c272fdacc3074eb114a3de53eb0769ea3e3643a0809b183df866d42a7206c749f9b2ae001109989fa1630d49bd5b0343df281f46224abeb31c3d9a66409b12db')

prepare() {
  cd "${pkgname}-${pkgver}"
  patch -Np1 -i ../socat-1.8.1.3-openssl4_fixes-1.patch
}

build() {
  cd "${pkgname}-${pkgver}"
  ./configure \
    --prefix=/usr \
    --mandir=/usr/share/man \

  make
}

check() {
  cd "${pkgname}-${pkgver}"
  # TODO: one of the tests always fails, but lets keep
  # it for manual sanity check
  make test||true
}

package() {
  cd "${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" install
}


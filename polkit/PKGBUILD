pkgname=polkit
pkgver=128
pkgrel=1
pkgdesc="Application development toolkit for controlling system-wide privileges"
url="https://github.com/polkit-org/polkit"
arch=(x86_64 powerpc64le powerpc64 powerpc espresso)
license=(LGPL-2.0-or-later)
depends=(
  duktape
  expat
  glib2
  glibc
  libgcc
  pam
  systemd # required by polkit.install
  systemd-libs
)
makedepends=(
  dbus
  git
  glib2-devel
  gobject-introspection
  gtk-doc
  meson
)
checkdepends=(python-dbusmock)
provides=(libpolkit-{agent,gobject}-1.so)
install=polkit.install
source=(
  "git+$url#tag=$pkgver"
  0001-meson-support-explicit-GID.patch
  0002-meson-support-installing-agent-helper-as-socket-acti.patch
  0003-meson-support-os_type-arch-and-detect-Arch-Linux.patch
)
b2sums=('c14ca008a1f2ba5c04fff3d0c0fd6cc4c4114fdd46709fca756f00ceb894ed0f9b8ff55df3656035172d9e6753fe862371e9ceb5368fdcba198b0359f574ec33'
        '451e9c1d7edcc18e62e9ede23bde6ef0dfac0b41b9482be038721e22a5c038a1cff361e3ec14f0f5de172255d96b84ac228d805f7026f24731d719f598e6367b'
        'af70bff9c13a300b3f28cd6f04b9e33841daa38c7602588872f625a7bf7daf19415c27c4dd5f6aa34d648c493d3b39692e83629d29057baa28f0db2e1cb88635'
        '368614b9f56b232e175ffa1b0474b087b782005afab4a126d0640b17145a7728ff9de3788b9a6daab3146cc570fdc3c34f1170bc58c03b4cae524e00ce01ae17')

prepare() {
  cd polkit

  # Arch-specific adjustments
  git apply -3 ../0001-meson-support-explicit-GID.patch
  git apply -3 ../0002-meson-support-installing-agent-helper-as-socket-acti.patch
  git apply -3 ../0003-meson-support-os_type-arch-and-detect-Arch-Linux.patch
}

build() {
  local meson_options=(
    -D examples=true
    -D gettext=true
    -D gtk_doc=true
    -D man=true
    -D tests=true
  )

  arch-meson polkit build "${meson_options[@]}"
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs -t 3
}

package() {
  meson install -C build --destdir "$pkgdir"
}


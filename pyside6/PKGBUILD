pkgbase=pyside6
pkgname=(
  pyside6
  pyside6-tools
  shiboken6
  shiboken6-generator
)
pkgver=6.12.0
pkgrel=3
arch=(x86_64 powerpc64le powerpc64 powerpc espresso)
url='https://www.qt.io'
license=(GPL-3.0-only
         LGPL-3.0-only
         LicenseRef-Qt-Commercial
         Qt-GPL-exception-1.0)
makedepends=(
  clang
  cmake
  git
  llvm
  ninja
  python-numpy
  python-setuptools
  qt6-3d
  qt6-canvaspainter
  qt6-charts
  qt6-connectivity
  qt6-datavis3d
  qt6-graphs
  qt6-httpserver
  qt6-location
  qt6-multimedia
  qt6-networkauth
  qt6-positioning
  qt6-quick3d
  qt6-remoteobjects
  qt6-scxml
  qt6-sensors
  qt6-serialbus
  qt6-serialport
  qt6-shadertools
  qt6-speech
  qt6-svg
  qt6-tools
  qt6-webchannel
  qt6-websockets
)
makedepends_x86_64=(
  qt6-webengine
  qt6-webview
)
source=(
  git+https://code.qt.io/pyside/pyside-setup#tag=v$pkgver
  pyside-6.11.0-find-cmake-helpers.patch
  pyside-6.11.2-fix-llvm-version.patch
  pyside-6.11.3-libcxx23.patch
  shiboken-32bit-typesystemparser.patch
)
sha256sums=('0265a43f5717dde0b303909863b3d800f57e6528bd9283f6c15ba23bcca2eab8'
            '836242885e2779b64a05ac3197074a9de6cfcdbe7f2db4409aa1d2e5dcf37d9d'
            'e0da8404d287cabf78a37daf2d4fbf38a28ebe4e226a61438827593af1db28a6'
            '039ad4c0f3d662ed0450010b1a6298eeb881b9b30d7f3e5e6a490cc8f245e36c'

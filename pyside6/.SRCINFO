	sha256sums = 4f8c8416ceceaca24d7b75d0007d5c1979c5b40827743b7b734a4674be9a1b70

pkgname = pyside6
	pkgdesc = Enables the use of Qt6 APIs in Python applications
	depends = glibc
	depends = libgcc
	depends = libstdc++
	depends = python
	depends = qt6-base
	depends = qt6-declarative
	depends = shiboken6
	optdepends = qt6-3d: Qt3D bindings
	optdepends = qt6-canvaspainter: QtCanvasPainter bindings
	optdepends = qt6-charts: QtCharts bindings
	optdepends = qt6-connectivity: QtBluetooth and QtNfc bindings
	optdepends = qt6-datavis3d: QtDataVisualization bindings
	optdepends = qt6-graphs: QtGraphs bindings
	optdepends = qt6-httpserver: QtHttpServer bindings
	optdepends = qt6-location: QtLocation bindings
	optdepends = qt6-multimedia: QtMultimedia bindings
	optdepends = qt6-networkauth: QtNetworkAuth bindings
	optdepends = qt6-positioning: QtPositioning bindings
	optdepends = qt6-quick3d: QtQuick3D bindings
	optdepends = qt6-remoteobjects: QtRemoteObjects bindings
	optdepends = qt6-scxml: QtScxml bindings
	optdepends = qt6-sensors: QtSensors bindings
	optdepends = qt6-serialbus: QtSerialBus bindings
	optdepends = qt6-serialport: QtSerialPort bindings
	optdepends = qt6-speech: QtTextToSpeech bindings
	optdepends = qt6-svg: QtSvg bindings
	optdepends = qt6-tools: QtHelp, QtUiTools bindings
	optdepends = qt6-webchannel: QtWebChannel bindings
	optdepends = qt6-webengine: QtWebEngine bindings
	optdepends = qt6-websockets: QtWebSockets bindings
	provides = qt6-python-bindings

pkgname = pyside6-tools
	pkgdesc = Tools for pyside6
	depends = pyside6
	depends = python

pkgname = shiboken6
	pkgdesc = Python/C++ bindings helper module
	depends = glibc
	depends = libgcc
	depends = libstdc++
	depends = python

pkgname = shiboken6-generator
	pkgdesc = Python/C++ bindings generator
	depends = clang
	depends = glibc
	depends = libgcc
	depends = libstdc++
	depends = libxml2
	depends = libxslt
	depends = llvm
	depends = python
	depends = qt6-base

	makedepends = clang
	makedepends = cmake
	makedepends = git
	makedepends = llvm
	makedepends = ninja
	makedepends = python-numpy
	makedepends = python-setuptools
	makedepends = qt6-3d
	makedepends = qt6-canvaspainter
	makedepends = qt6-charts
	makedepends = qt6-connectivity
	makedepends = qt6-datavis3d

pkgname=libconfig
pkgver=1.8.3
pkgrel=1
pkgdesc="C/C++ Configuration File Library"
arch=(x86_64 powerpc64le powerpc64 powerpc espresso)
url="https://github.com/hyperrealm/libconfig"
license=(LGPL-2.1-only)
depends=(
  libgcc
  libstdc++
  glibc
)
makedepends=(texinfo)
provides=(
  libconfig++.so
  libconfig.so
)
source=($url/archive/v$pkgver/$pkgname-v$pkgver.tar.gz)
sha512sums=('c9e6e77e5f89e7ddc866c6fd22f5a4d968b55e07b55875757c48ad381d0236240f49a99f2b639d585cb72f2f938dfcfe7bbca46ac7f02f8dedf5593cea791c7f')
b2sums=('d198991d584e6b02970b8c39cb481516be486c5af7d751aa6de4e2efa1c62bea2acae71d407d2cfbf6c8db89a6d5fd70cc43a297ebe74215137170de30cae52c')

prepare() {
  cd $pkgname-$pkgver
  autoreconf -fiv
}

build() {
  cd $pkgname-$pkgver
  ./configure --prefix=/usr
  # prevent excessive overlinking due to libtool
  sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool
  make
}

package() {
  make DESTDIR="$pkgdir" install -C $pkgname-$pkgver
  rm "$pkgdir/usr/share/info/dir"
  install -vDm 644 $pkgname-$pkgver/{AUTHORS,ChangeLog,NEWS,README,TODO} -t "$pkgdir/usr/share/doc/$pkgname/"
}
# vim:set ts=2 sw=2 et:

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "Jan Alexander Steffens (heftig)" <heftig@archlinux.org>
Date: Wed, 18 Nov 2026 21:43:08 +0100
Subject: [PATCH] install pkg-config file into datadir

The product seems to be architecture-independent.
---
 meson.build | 1 +
 1 file changed, 1 insertion(+)

diff --git a/meson.build b/meson.build
index ed927fe78c01..d540db72315d 100644
--- a/meson.build
+++ b/meson.build
@@ -184,6 +184,7 @@ if not_subproj
     description: 'Venus Vulkan protocol',
     version: meson.project_version(),
     subdirs: [meson.project_name()],
+    install_dir: get_option('datadir') / 'pkgconfig',
   )
 
   subdir('tests')

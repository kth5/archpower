# POWER Maintainer: Alexander Baldeck <alex.bldck@gmail.com>
# Maintainer: Jan Alexander Steffens (heftig) <heftig@archlinux.org>

pkgname=venus-protocol
pkgver=1.1.3
pkgrel=2
pkgdesc="Vulkan protocol for Virtio-GPU (Venus)"
url="https://gitlab.freedesktop.org/virgl/venus-protocol"
arch=(any)
license=(MIT)
makedepends=(
  git
  meson
  python-mako
)
source=(
  "git+$url.git#tag=v$pkgver"
  0001-install-pkg-config-file-into-datadir.patch
)
b2sums=('c3ba7576af2e181783e8b3f36b28639a221616433bb2fc356c9960d0362bb48d541e7f8930bbbfa8b969672084a83c8672fe3b99eb62006e3b36607f831557df'
        '4565b21207f2b42ba09f988b9a43385de16ece1a1c3587a33c6490f4b4c78a3e40b7fa7fe5d1a0610024d7f35cb0935d965a27044b8e33228b2889ad4096d656')

prepare() {
  cd $pkgname

  # Add license
  git cherry-pick -n 02c03c815fd07f2237d7f1161bbafcf6a829373c

  # For lib32-mesa
  git apply -3 ../0001-install-pkg-config-file-into-datadir.patch
}

build() {
  arch-meson $pkgname build
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 $pkgname/LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}


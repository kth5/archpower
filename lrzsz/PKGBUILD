pkgname=lrzsz
pkgver=0.13.1
pkgrel=1
pkgdesc="xmodem, ymodem and zmodem file transfer protocols"
url="https://www.ohse.de/uwe/software/lrzsz.html"
license=('GPL-2.0-only')
arch=(x86_64 powerpc64le powerpc64 powerpc espresso)
source=(https://www.ohse.de/uwe/releases/$pkgname-$pkgver.tar.gz
        lrzsz-0.13.1-32bit.patch)
sha512sums=('3742fed1b8d7ad78551eb55ebe5f179a7a93d8e600f74c9e8541abf1dbd48651f886e96f0307479de7b20016772533dce756329526f5dc779fc40b983357b61c'
            '91974057843e3253fb974010187bd2941223ce75afbbd50a787aef5a237a893b99180ccb896c3562a2deacc76c0a91d3d7de27dd1982124714beb83d873533df')

prepare() {
  cd "$srcdir"/$pkgname-$pkgver
  patch -Np1 -i "$srcdir"/lrzsz-0.13.1-32bit.patch
}

build() {
  case "${CARCH}" in
    powerpc) CFLAGS+=' -Wno-error=inline' ;;
  esac

  cd "$srcdir"/$pkgname-$pkgver
  ./configure --prefix=/usr --mandir=/usr/share/man \
    --program-transform-name=s/l/lrzsz-/
  make
}

package() {
  cd "$srcdir"/$pkgname-$pkgver
  make DESTDIR="$pkgdir" install
}

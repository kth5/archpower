Fix the lrzsz 0.13.1 build on 32-bit powerpc.

size_t is unsigned int there, so the debug prints must use %zu.
linesimulator's xorshift64 state does not fit in unsigned long; keep it
in uint64_t.

--- lrzsz-0.13.1/src/zreadline.c
+++ lrzsz-0.13.1/src/zreadline.c
@@ -53,7 +53,7 @@
 	struct timeval *tvp;
 	int rc;
 
-	DPRINTF(DEBUG_READLINE, "Calling read: timeout=%u/10s  readnum=%lu ",
+	DPRINTF(DEBUG_READLINE, "Calling read: timeout=%u/10s  readnum=%zu ",
 	  timeout, readline_readnum);
 
 	if (no_timeout) {
--- lrzsz-0.13.1/src/zm.c
+++ lrzsz-0.13.1/src/zm.c
@@ -476,7 +476,7 @@
 	int c;
 	unsigned long crc;
 	int i;
-	DPRINTF(DEBUG_PROTOCOL, "zsdat32: %lu %s", length, Zendnames[(frameend-ZCRCE)&3]);
+	DPRINTF(DEBUG_PROTOCOL, "zsdat32: %zu %s", length, Zendnames[(frameend-ZCRCE)&3]);
 
 	crc = 0xFFFFFFFFL;
         stats_msg_valid(length);
--- lrzsz-0.13.1/src/lsz.c
+++ lrzsz-0.13.1/src/lsz.c
@@ -1426,7 +1426,7 @@
 				blklen = Rxbuflen;
 			if (blkopt && blklen > blkopt)
 				blklen = blkopt;
-			DPRINTF(DEBUG_WINDOWHANDLING, "Rxbuflen=%u blklen=%lu\n", Rxbuflen, blklen);
+			DPRINTF(DEBUG_WINDOWHANDLING, "Rxbuflen=%u blklen=%zu\n", Rxbuflen, blklen);
 			DPRINTF(DEBUG_WINDOWHANDLING, "Txwindow = %u Txwspac = %u\n", Txwindow, Txwspac);
 			Rxtimeout=old_timeout;
                         if (debugmode & DEBUG_WINDOWHANDLING) {

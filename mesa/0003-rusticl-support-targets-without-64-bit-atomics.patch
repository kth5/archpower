+    fn store(&self, value: cl_ulong) {
+        self.0.store(value, Ordering::SeqCst);
+    }
+
+    #[cfg(not(target_has_atomic = "64"))]
+    fn store(&self, value: cl_ulong) {
+        *self.0.lock().unwrap() = value;
+    }
+}
 

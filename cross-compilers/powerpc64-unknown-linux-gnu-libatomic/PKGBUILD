_target=powerpc64-unknown-linux-gnu
pkgname=${_target}-libatomic
pkgver=16.1.1+r346+g4e03491b401d
_commit=4e03491b401dce0658543dd90524ddb92063836e
pkgrel=2
pkgdesc="The GNU Compiler Collection. Stage 2 for toolchain building (${_target})"
arch=(any)
license=(
  'GPL-3.0-or-later WITH GCC-exception-3.1'
  GFDL-1.3-or-later
)
url='http://gcc.gnu.org'
depends=("${_target}-binutils>=2.41" "${_target}-glibc-headers>=2.38" libmpc zlib)
makedepends=(git "${_target}-gcc-stage2>=16.1.1")
options=(!debug !emptydirs !lto !strip)
conflicts=("${_target}-gcc-stage1")
replaces=("${_target}-gcc-stage1")
provides=("${_target}-gcc-stage1=${pkgver}")
source=(git+https://sourceware.org/git/gcc.git#commit=${_commit}
        gcc11-Wno-format-security.patch)
validpgpkeys=(F3691687D867B81B51CE07D9BBE43771487328A9  # bpiotrowski@archlinux.org
              86CFFCA918CF3AF47147588051E8B148A9999C34  # evangelos@foutrelis.com
              13975A70E63C361C73AE69EF6EEB81F8981C74C7  # richard.guenther@gmail.com
              D3A93CAD751C2AF4F8C7AD516C35B99309B5FA62) # Jakub Jelinek <jakub@redhat.com>
sha256sums=('73dca834e44d5e4501efa3f68a190a902d0a83c66f4cf4fd5b3da24e2cefdaf4'
            '504e4b5a08eb25b6c35f19fdbe0c743ae4e9015d0af4759e74150006c283585e')

pkgver() {
  cd gcc
  echo "$(cat gcc/BASE-VER)+$(git describe --abbrev=12 --tags | sed 's/[^-]*-[^-]*-//;s/[^-]*-/r&/;s/-/+/g;s/_/./')"
}

prepare() {
  [[ ! -d gcc ]] && ln -s gcc-${pkgver/+/-} gcc
  cd gcc

  # on Arch we do not use lib64/
  sed -i 's@/lib64@/lib@g' gcc/config/rs6000/t-*

  # Do not run fixincludes
  sed -i 's@\./fixinc\.sh@-c true@' gcc/Makefile.in

  # hack! - some configure tests for header files using "$CPP $CPPFLAGS"
  sed -i "/ac_cpp=/s/\$CPPFLAGS/\$CPPFLAGS -O2/" {libiberty,gcc}/configure

  # configure.ac: When adding -Wno-format, also add -Wno-format-security
  patch -Np0 < "$srcdir/gcc11-Wno-format-security.patch"

  mkdir -p "$srcdir/libatomic-build"
}

build() {
  cd libatomic-build

  # using -pipe causes spurious test-suite failures
  # http://gcc.gnu.org/bugzilla/show_bug.cgi?id=48565
  CFLAGS=${CFLAGS/-pipe}
  CFLAGS=${CFLAGS/-Wformat -Werror=format-security/}
  CXXFLAGS=${CXXFLAGS/-pipe/}
  CXXFLAGS=${CXXFLAGS/ -Wformat -Werror=format-security/}

  CC=${_target}-gcc \
  "$srcdir/gcc/libatomic/configure" --prefix=/usr/${_target}/usr \
      --enable-shared \
      --disable-multilib \
      --disable-werror \
      --target=${_target} \
      --host=${_target} \
      --build=${CHOST} || cat config.log
}

package() {
  cd "$srcdir"/libatomic-build

  DESTDIR="$pkgdir" make STAGE1_CFLAGS="-O2" install-asneeded
}

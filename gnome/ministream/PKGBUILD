# POWER Maintainer: Alexander Baldeck <alex.bldck@gmail.com>
# Maintainer: Fabian Bornschein <fabiscafe@archlinux.org>

pkgname=ministream
pkgver=0.99.1
pkgrel=1
pkgdesc="Lightweight alternative to AppStream"
url="https://gitlab.gnome.org/GNOME/ministream"
arch=(x86_64 powerpc64le powerpc64 powerpc espresso)
license=(LGPL-2.1-only)
depends=(
  glibc
  glib2
)
makedepends=(
  appstream
  git
  gobject-introspection
  meson
)
source=(
  "git+https://gitlab.gnome.org/GNOME/ministream.git?signed#tag=${pkgver}"
)
b2sums=('2eda0968342c4513ce293713e3764821c81e37185cb8a2a47294c565512cf6605dbcc96f959b961dc8472d97a2fc70e43d5af25ea27f044c404bdc3a86de8d88')
validpgpkeys=(
  BBDE032EAAFBFC627FB7E635B1F4055D8460CE34 # Florian Leander Singer <sp1rit@national.shitposting.agency>
)

prepare() {
  cd $pkgname
}

build() {
  arch-meson $pkgname build
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
}


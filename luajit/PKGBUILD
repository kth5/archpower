pkgname=luajit
pkgver="2.1.0+20260724"
pkgrel=1
epoch=1
pkgdesc='Just-in-time compiler and drop-in replacement for Lua 5.1'
arch=(x86_64 powerpc64le powerpc64 powerpc espresso)
url='https://luajit.org/'
license=('MIT')
depends=('gcc-libs')
makedepends=('git')
source=("http://ftp.de.debian.org/debian/pool/main/l/luajit/luajit_2.1.0+openresty20260724.orig.tar.xz")
md5sums=('bc16c9dfdd954f867f3dd9905bc54b0d')
sha256sums=('5e64ee758252618cb016d82ee41f9ccef99dfea798b5f5aa4730ee5294bb4229')
b2sums=('8c0b3a3ad495ba12c22e5724d106a18e7b6f6e5bec533c277312496b55e6e3a579c6c2bed18899a4ff8f935914f45b0de328fd31012e1c6a65db705f55052965')

build() {
  cd "luajit2-2.1-20260724"
  # Avoid early stripping
  make amalg PREFIX=/usr BUILDMODE=dynamic TARGET_STRIP=" @:"
}

package() {
  cd "luajit2-2.1-20260724"

  make install DESTDIR="$pkgdir" PREFIX=/usr
  install -Dm644 COPYRIGHT "$pkgdir/usr/share/licenses/$pkgname/COPYRIGHT"

  ln -sf luajit-2.1.0-beta3 "$pkgdir/usr/bin/luajit"
}

+                                 int filterLength,
+                                 unsigned char* const* sourceDataRows,
+                                 int pixelWidth, unsigned char* outRow,
+                                 bool hasAlpha) {
   if (hasAlpha) {
     ConvolveVertically<true>(filterValues, filterLength, sourceDataRows,
                              pixelWidth, outRow);

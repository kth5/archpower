diff --git a/dom/media/gmp/widevine-proxy/build_proxy.py b/dom/media/gmp/widevine-proxy/build_proxy.py
new file mode 100644
index 0000000000..f9bd581cae
--- /dev/null
+++ b/dom/media/gmp/widevine-proxy/build_proxy.py
@@ -0,0 +1,156 @@
+# This Source Code Form is subject to the terms of the Mozilla Public
+# License, v. 2.0. If a copy of the MPL was not distributed with this
+# file, You can obtain one at http://mozilla.org/MPL/2.0/.
+
+# Builds the Widevine proxy bundle: the native proxy CDM, and the x86_64
+# helper and runtime library that box64 runs. Everything is freestanding, so
+# the x86_64 parts need only clang and lld, not an x86_64 sysroot.
+
+import os
+import shlex
+import subprocess
+import tempfile
+
+import buildconfig
+
+X86_64 = "--target=x86_64-linux-gnu"
+
+FLAGS = [
+    "-O2",
+    "-ffreestanding",
+    "-nostdinc",
+    "-fno-stack-protector",
+    "-Wall",
+]
+
+CXX_FLAGS = [
+    "-fno-exceptions",
+    "-fno-rtti",
+    "-fno-threadsafe-statics",
+    "-Wno-unused-private-field",
+]
+
+X86_64_LINK = [
+    "-nostdlib",
+    "-fuse-ld=lld",
+    "-Wl,-z,now",
+    "-Wl,-z,noexecstack",
+    "-Wl,--build-id",
+]
+
+
+def configured(name):
+    value = buildconfig.substs[name]
+    return shlex.split(value) if isinstance(value, str) else list(value)
+
+
+def retarget(compiler):
+    """The configured compiler, targeting x86_64 instead."""
+    args = []
+    skip = False
+    for arg in compiler:
+        if skip:
+            skip = False
+        elif arg == "-target":
+            skip = True
+        elif not arg.startswith("--target="):
+            args.append(arg)
+    return args + [X86_64]
+
+
+def run(args):
+    print(shlex.join(args), flush=True)
+    subprocess.check_call(args)
+
+
+def main(output, *inputs):
+    """Builds the bundle into the directory of |output|; |inputs| are its
+    sources, the first being wvproxy.cc."""
+    srcdir = os.path.dirname(inputs[0])
+    cc = configured("CC")
+    cxx = configured("CXX")
+    out_dir = os.path.dirname(os.path.abspath(output.name))
+    resource_dir = subprocess.check_output(
+        cxx + ["-print-resource-dir"], text=True
+    ).strip()
+    builtin = ["-isystem", os.path.join(resource_dir, "include")]
+    includes = builtin + [
+        "-isystem",
+        os.path.join(srcdir, "shim"),
+        "-I",
+        srcdir,
+        "-I",
+        os.path.join(srcdir, "..", "widevine-adapter"),
+    ]
+
+    with tempfile.TemporaryDirectory(dir=out_dir) as tmp:
+        # The native proxy CDM, which Firefox loads as libwidevinecdm.so.
+        proxy = os.path.join(tmp, "libwidevinecdm.so")
+        run(
+            cxx
+            + FLAGS
+            + CXX_FLAGS
+            + includes
+            + [
+                "-fPIC",
+                "-fvisibility=hidden",
+                "-shared",
+                "-nostdlib++",
+                "-Wl,--no-undefined",
+                "-Wl,--version-script=" + os.path.join(srcdir, "wvproxy.map"),
+                os.path.join(srcdir, "wvproxy.cc"),
+                "-o",
+                proxy,
+            ]
+        )
+
+        # Empty libc.so.6 and libdl.so.2 for the helper to link against, so
+        # that it records them as needed; box64 supplies the real ones.
+        empty = os.path.join(tmp, "empty.c")
+        open(empty, "w").close()
+        stubs = []
+        for soname in ("libc.so.6", "libdl.so.2"):
+            stub = os.path.join(tmp, soname)
+            run(
+                retarget(cc)
+                + X86_64_LINK
+                + ["-shared", "-Wl,-soname," + soname, empty, "-o", stub]
+            )
+            stubs.append(stub)
+
+        # The helper box64 runs to load the real CDM.
+        run(
+            retarget(cxx)
+            + FLAGS
+            + CXX_FLAGS
+            + includes
+            + ["-fPIE", "-fno-asynchronous-unwind-tables", "-pie"]
+            + X86_64_LINK
+            + [
+                "-Wl,--dynamic-linker=/lib64/ld-linux-x86-64.so.2",
+                "-Wl,--unresolved-symbols=ignore-all",
+                os.path.join(srcdir, "start.S"),
+                os.path.join(srcdir, "wvhost.cc"),
+            ]
+            + stubs
+            + ["-o", os.path.join(out_dir, "wvhost")]
+        )
+
+        # The one x86_64 runtime library the real CDM needs besides libc.
+        run(
+            retarget(cc)
+            + FLAGS
+            + builtin
+            + ["-fPIC", "-shared"]
+            + X86_64_LINK
+            + [
+                "-Wl,-soname,libgcc_s.so.1",
+                "-Wl,--version-script=" + os.path.join(srcdir, "libgcc_s.map"),
+                os.path.join(srcdir, "libgcc_s.c"),
+                "-o",
+                os.path.join(out_dir, "libgcc_s.so.1"),
+            ]
+        )
+
+        with open(proxy, "rb") as f:
+            output.write(f.read())
diff --git a/dom/media/gmp/widevine-proxy/gmp-helper b/dom/media/gmp/widevine-proxy/gmp-helper
new file mode 100755
index 0000000000..b589a3eaae
--- /dev/null
+++ b/dom/media/gmp/widevine-proxy/gmp-helper
@@ -0,0 +1,15 @@
+#!/bin/sh
+# This Source Code Form is subject to the terms of the Mozilla Public
+# License, v. 2.0. If a copy of the MPL was not distributed with this
+# file, You can obtain one at http://mozilla.org/MPL/2.0/.
+
+# Started by Firefox's GMP child, before its sandbox engages, with the helper
+# end of the proxy's socket as the only argument. Runs the x86_64 helper and
+# the real CDM under box64.
+d=$(dirname "$(readlink -f "$0")")
+# box64 is packaged separately from the proxy, so it comes from PATH unless
+# WV_BOX64 names one. GMPUtils.box64Path in Firefox resolves it the same way.
+box64=${WV_BOX64:-box64}
+export BOX64_LD_LIBRARY_PATH="${BOX64_LD_LIBRARY_PATH:-$d/x64lib}"
+export BOX64_NOBANNER=1
+exec "$box64" "$d/wvhost" "$d/libwidevinecdm-x86_64.so" "$1"
diff --git a/dom/media/gmp/widevine-proxy/libgcc_s.c b/dom/media/gmp/widevine-proxy/libgcc_s.c
new file mode 100644
index 0000000000..7c565b1011
--- /dev/null
+++ b/dom/media/gmp/widevine-proxy/libgcc_s.c
@@ -0,0 +1,79 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// The x86_64 libgcc_s.so.1 the Widevine CDM is linked against, for box64 to
+// load in place of the system's (there is none on ppc64le). The CDM imports
+// only these GCC_3.0 symbols.
+//
+// The CDM is built without exceptions, so nothing in it catches one: with the
+// real unwinder a throw finds no handler and the C++ runtime calls
+// std::terminate. _Unwind_RaiseException reports that outcome directly, and
+// the remaining unwinder entry points are only reached while unwinding to a
+// handler, which never happens.
+
+#include <stddef.h>
+#include <stdint.h>
+
+#define EXPORT __attribute__((visibility("default")))
+
+typedef enum {
+  _URC_NO_REASON = 0,
+  _URC_FOREIGN_EXCEPTION_CAUGHT = 1,
+  _URC_END_OF_STACK = 5,
+} _Unwind_Reason_Code;
+
+struct _Unwind_Exception;
+typedef void (*_Unwind_Exception_Cleanup_Fn)(_Unwind_Reason_Code,
+                                             struct _Unwind_Exception*);
+struct _Unwind_Exception {
+  uint64_t exception_class;
+  _Unwind_Exception_Cleanup_Fn exception_cleanup;
+  uint64_t private_1;
+  uint64_t private_2;
+};
+struct _Unwind_Context;
+
+EXPORT _Unwind_Reason_Code
+_Unwind_RaiseException(struct _Unwind_Exception* exc) {
+  return _URC_END_OF_STACK;
+}
+
+EXPORT void _Unwind_Resume(struct _Unwind_Exception* exc) { __builtin_trap(); }
+
+EXPORT void _Unwind_DeleteException(struct _Unwind_Exception* exc) {
+  if (exc->exception_cleanup) {
+    exc->exception_cleanup(_URC_FOREIGN_EXCEPTION_CAUGHT, exc);
+  }
+}
+
+EXPORT uintptr_t _Unwind_GetIP(struct _Unwind_Context* ctx) { return 0; }
+
+EXPORT uintptr_t _Unwind_GetLanguageSpecificData(struct _Unwind_Context* ctx) {
+  return 0;
+}
+
+EXPORT uintptr_t _Unwind_GetRegionStart(struct _Unwind_Context* ctx) {
+  return 0;
+}
+
+EXPORT void _Unwind_SetGR(struct _Unwind_Context* ctx, int reg,
+                          uintptr_t value) {}
+
+EXPORT void _Unwind_SetIP(struct _Unwind_Context* ctx, uintptr_t value) {}
+
+// Shift-and-subtract, so that the compiler has no reason to call __udivti3.
+EXPORT unsigned __int128 __udivti3(unsigned __int128 n, unsigned __int128 d) {
+  if (d == 0) {
+    __builtin_trap();
+  }
+  unsigned __int128 q = 0, r = 0;
+  for (int i = 127; i >= 0; i--) {
+    r = (r << 1) | ((n >> i) & 1);
+    if (r >= d) {
+      r -= d;
+      q |= (unsigned __int128)1 << i;
+    }
+  }
+  return q;
+}

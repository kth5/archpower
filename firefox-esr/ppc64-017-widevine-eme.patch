+# Linux ppc64le runs the x86_64 Widevine CDM through a native proxy CDM and a
+# helper under box64 (see dom/media/gmp/widevine-proxy). The helper parts are
+# built for x86_64, which needs clang.
+@depends(eme_modules, target, c_compiler, when=eme_choices)
+def widevine_proxy(modules, target, c_compiler):
+    if (
+        "widevine" in modules
+        and target.kernel == "Linux"
+        and target.cpu == "ppc64"
+        and target.endianness == "little"
+        and c_compiler.type == "clang"
+    ):
+        return True
+
+
+set_config("MOZ_WIDEVINE_PROXY", True, when=widevine_proxy)
+set_define("MOZ_WIDEVINE_PROXY", True, when=widevine_proxy)

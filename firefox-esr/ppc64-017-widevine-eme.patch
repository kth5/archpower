+
+# Minimal x86_64 _start: the same hand-off to __libc_start_main as glibc's crt1.
+	.text
+	.globl _start
+	.type _start, @function
+_start:
+	xorl %ebp, %ebp
+	movq %rdx, %r9
+	popq %rsi
+	movq %rsp, %rdx
+	andq $-16, %rsp
+	pushq %rax
+	pushq %rsp
+	xorl %r8d, %r8d
+	xorl %ecx, %ecx
+	leaq main(%rip), %rdi
+	call *__libc_start_main@GOTPCREL(%rip)
+	hlt
+	.section .note.GNU-stack,"",@progbits
diff --git a/dom/media/gmp/widevine-proxy/wvhost.cc b/dom/media/gmp/widevine-proxy/wvhost.cc
new file mode 100644
index 0000000000..b1c33895f7
--- /dev/null
+++ b/dom/media/gmp/widevine-proxy/wvhost.cc
@@ -0,0 +1,522 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// x86_64 helper run under box64 for the native proxy CDM (wvproxy.cc). It
+// loads the real CDM, executes the proxy's requests on it and forwards the
+// CDM's Host_10 callbacks over the socket. It serves every CDM instance the
+// proxy creates and exits when the socket closes. See wvipc.h for the
+// protocol.
+//
+// usage: wvhost <libwidevinecdm.so> <socket fd>
+
+#include "wvinput.h"
+
+using namespace wvipc;
+
+extern "C" void __cxa_pure_virtual() { _exit(70); }
+
+namespace {
+
+int gFd = -1;
+uint32_t gInstance = kNoInstance;
+
+void Fail(const char* what) {
+  printf("wvhost: %s\n", what);
+  fflush(nullptr);
+  _exit(1);
+}
+
+void Callback(uint32_t type, const Writer& w) {
+  if (!Send(gFd, type, gInstance, w)) Fail("lost the proxy");
+}
+
+void Callback(uint32_t type) {
+  Writer w;
+  Callback(type, w);
+}
+
+class LocalBuffer final : public cdm::Buffer {
+ public:
+  explicit LocalBuffer(uint32_t cap)
+      : mData(static_cast<uint8_t*>(malloc(cap ? cap : 1))), mCap(cap) {}
+  void Destroy() override {
+    free(mData);
+    free(this);
+  }
+  uint32_t Capacity() const override { return mCap; }
+  uint8_t* Data() override { return mData; }
+  void SetSize(uint32_t size) override { mSize = size; }
+  uint32_t Size() const override { return mSize; }
+
+ private:
+  uint8_t* mData;
+  uint32_t mCap;
+  uint32_t mSize = 0;
+};
+
+class LocalDecryptedBlock final : public cdm::DecryptedBlock {
+ public:
+  void SetDecryptedBuffer(cdm::Buffer* buffer) override { mBuffer = buffer; }
+  cdm::Buffer* DecryptedBuffer() override { return mBuffer; }
+  void SetTimestamp(int64_t timestamp) override { mTimestamp = timestamp; }
+  int64_t Timestamp() const override { return mTimestamp; }
+
+ private:
+  cdm::Buffer* mBuffer = nullptr;
+  int64_t mTimestamp = 0;
+};
+
+class LocalVideoFrame final : public cdm::VideoFrame {
+ public:
+  void SetFormat(cdm::VideoFormat format) override { mFormat = format; }
+  cdm::VideoFormat Format() const override { return mFormat; }
+  void SetSize(cdm::Size size) override { mSize = size; }
+  cdm::Size Size() const override { return mSize; }
+  void SetFrameBuffer(cdm::Buffer* buffer) override { mBuffer = buffer; }
+  cdm::Buffer* FrameBuffer() override { return mBuffer; }
+  void SetPlaneOffset(cdm::VideoPlane plane, uint32_t offset) override {
+    mOffset[plane] = offset;
+  }
+  uint32_t PlaneOffset(cdm::VideoPlane plane) override {
+    return mOffset[plane];
+  }
+  void SetStride(cdm::VideoPlane plane, uint32_t stride) override {
+    mStride[plane] = stride;
+  }
+  uint32_t Stride(cdm::VideoPlane plane) override { return mStride[plane]; }
+  void SetTimestamp(int64_t timestamp) override { mTimestamp = timestamp; }
+  int64_t Timestamp() const override { return mTimestamp; }
+
+  cdm::VideoFormat mFormat = cdm::kUnknownVideoFormat;
+  cdm::Size mSize = {0, 0};
+  cdm::Buffer* mBuffer = nullptr;
+  uint32_t mOffset[3] = {0, 0, 0};
+  uint32_t mStride[3] = {0, 0, 0};
+  int64_t mTimestamp = 0;
+};
+
+class LocalAudioFrames final : public cdm::AudioFrames {
+ public:
+  void SetFrameBuffer(cdm::Buffer* buffer) override { mBuffer = buffer; }
+  cdm::Buffer* FrameBuffer() override { return mBuffer; }
+  void SetFormat(cdm::AudioFormat format) override { mFormat = format; }
+  cdm::AudioFormat Format() const override { return mFormat; }
+
+  cdm::Buffer* mBuffer = nullptr;
+  cdm::AudioFormat mFormat = cdm::kUnknownAudioFormat;
+};
+
+// The CDM's storage, backed by a FileIO the proxy creates on Firefox's host.
+constexpr uint32_t kMaxFiles = 64;
+cdm::FileIOClient* gFileClients[kMaxFiles];
+
+class RemoteFileIO final : public cdm::FileIO {
+ public:
+  explicit RemoteFileIO(uint32_t id) : mId(id) {}
+  void Open(const char* name, uint32_t size) override {
+    Writer w;
+    w.U32(mId);
+    w.Bytes(name, size);
+    Callback(kFileOpen, w);
+  }
+  void Read() override {
+    Writer w;
+    w.U32(mId);
+    Callback(kFileRead, w);
+  }
+  void Write(const uint8_t* data, uint32_t size) override {
+    Writer w;
+    w.U32(mId);
+    w.Bytes(data, size);
+    Callback(kFileWrite, w);
+  }
+  void Close() override {
+    Writer w;
+    w.U32(mId);
+    Callback(kFileClose, w);
+    gFileClients[mId] = nullptr;
+    free(this);
+  }
+
+ private:
+  uint32_t mId;
+};
+
+class HostProxy final : public cdm::Host_10 {
+ public:
+  cdm::Buffer* Allocate(uint32_t capacity) override {
+    return new (malloc(sizeof(LocalBuffer))) LocalBuffer(capacity);
+  }
+  void SetTimer(int64_t delay_ms, void* context) override {
+    Writer w;
+    w.I64(delay_ms);
+    w.U64(reinterpret_cast<uint64_t>(context));
+    Callback(kSetTimer, w);
+  }
+  cdm::Time GetCurrentWallTime() override {
+    timespec ts;
+    clock_gettime(CLOCK_REALTIME, &ts);
+    return ts.tv_sec + ts.tv_nsec / 1e9;
+  }
+  void OnInitialized(bool success) override {
+    Writer w;
+    w.U32(success);
+    Callback(kOnInitialized, w);
+  }
+  void OnResolveKeyStatusPromise(uint32_t id, cdm::KeyStatus s) override {
+    Writer w;
+    w.U32(id);
+    w.U32(s);
+    Callback(kOnResolveKeyStatusPromise, w);
+  }
+  void OnResolveNewSessionPromise(uint32_t id, const char* sid,
+                                  uint32_t len) override {
+    Writer w;
+    w.U32(id);
+    w.Bytes(sid, len);
+    Callback(kOnResolveNewSessionPromise, w);
+  }
+  void OnResolvePromise(uint32_t id) override {
+    Writer w;
+    w.U32(id);
+    Callback(kOnResolvePromise, w);
+  }
+  void OnRejectPromise(uint32_t id, cdm::Exception e, uint32_t code,
+                       const char* msg, uint32_t len) override {
+    Writer w;
+    w.U32(id);
+    w.U32(e);
+    w.U32(code);
+    w.Bytes(msg, len);
+    Callback(kOnRejectPromise, w);
+  }
+  void OnSessionMessage(const char* sid, uint32_t sidlen, cdm::MessageType t,
+                        const char* msg, uint32_t len) override {
+    Writer w;
+    w.Bytes(sid, sidlen);
+    w.U32(t);
+    w.Bytes(msg, len);
+    Callback(kOnSessionMessage, w);
+  }
+  void OnSessionKeysChange(const char* sid, uint32_t sidlen, bool more,
+                           const cdm::KeyInformation* keys,
+                           uint32_t count) override {
+    Writer w;
+    w.Bytes(sid, sidlen);
+    w.U32(more);
+    w.U32(count);
+    for (uint32_t i = 0; i < count; i++) {
+      w.Bytes(keys[i].key_id, keys[i].key_id_size);
+      w.U32(keys[i].status);
+      w.U32(keys[i].system_code);
+    }
+    Callback(kOnSessionKeysChange, w);
+  }
+  void OnExpirationChange(const char* sid, uint32_t len, cdm::Time t) override {
+    Writer w;
+    w.Bytes(sid, len);
+    w.F64(t);
+    Callback(kOnExpirationChange, w);
+  }
+  void OnSessionClosed(const char* sid, uint32_t len) override {
+    Writer w;
+    w.Bytes(sid, len);
+    Callback(kOnSessionClosed, w);
+  }
+  void SendPlatformChallenge(const char* service, uint32_t serviceLen,
+                             const char* challenge,
+                             uint32_t challengeLen) override {
+    Writer w;
+    w.Bytes(service, serviceLen);
+    w.Bytes(challenge, challengeLen);
+    Callback(kSendPlatformChallenge, w);
+  }
+  void EnableOutputProtection(uint32_t mask) override {
+    Writer w;
+    w.U32(mask);
+    Callback(kEnableOutputProtection, w);
+  }
+  void QueryOutputProtectionStatus() override {
+    Callback(kQueryOutputProtectionStatus);
+  }
+  void OnDeferredInitializationDone(cdm::StreamType type,
+                                    cdm::Status status) override {
+    Writer w;
+    w.U32(type);
+    w.U32(status);
+    Callback(kOnDeferredInitializationDone, w);
+  }
+  cdm::FileIO* CreateFileIO(cdm::FileIOClient* client) override {
+    for (uint32_t id = 0; id < kMaxFiles; id++) {
+      if (!gFileClients[id]) {
+        gFileClients[id] = client;
+        Writer w;
+        w.U32(id);
+        Callback(kFileCreate, w);
+        return new (malloc(sizeof(RemoteFileIO))) RemoteFileIO(id);
+      }
+    }
+    return nullptr;
+  }
+  void RequestStorageId(uint32_t version) override {
+    Writer w;
+    w.U32(version);
+    Callback(kRequestStorageId, w);
+  }
+};
+
+HostProxy* gHost;
+
+void* GetHost(int version, void*) {
+  return version == cdm::Host_10::kVersion ? gHost : nullptr;
+}
+
+cdm::FileIOClient* FileClient(uint32_t id) {
+  return id < kMaxFiles ? gFileClients[id] : nullptr;
+}
+
+typedef void (*InitFn)();
+typedef void* (*CreateFn)(int, const char*, uint32_t, GetCdmHostFunc, void*);
+
+// Runs one request on the CDM and fills |out| with the kDone payload.
+// Returns false once the CDM has been destroyed.
+bool Handle(cdm::ContentDecryptionModule_10* cdm, uint32_t type, Reader& r,
+            Writer& out) {
+  static cdm::SubsampleEntry* subs;
+  static uint32_t subsCap;
+  uint32_t n, m, k;
+  const uint8_t *a, *b, *c;
+  switch (type) {
+    case kInitialize: {
+      uint32_t x = r.U32(), y = r.U32(), z = r.U32();
+      cdm->Initialize(x, y, z);
+      break;
+    }
+    case kGetStatusForPolicy: {
+      uint32_t id = r.U32();
+      cdm::Policy policy = {cdm::HdcpVersion(r.U32())};
+      cdm->GetStatusForPolicy(id, policy);
+      break;
+    }
+    case kSetServerCertificate: {
+      uint32_t id = r.U32();
+      a = r.Bytes(&n);
+      cdm->SetServerCertificate(id, a, n);
+      break;
+    }
+    case kCreateSessionAndGenerateRequest: {
+      uint32_t id = r.U32();
+      auto st = cdm::SessionType(r.U32());
+      auto it = cdm::InitDataType(r.U32());
+      a = r.Bytes(&n);
+      cdm->CreateSessionAndGenerateRequest(id, st, it, a, n);
+      break;
+    }
+    case kLoadSession: {
+      uint32_t id = r.U32();
+      auto st = cdm::SessionType(r.U32());
+      a = r.Bytes(&n);
+      cdm->LoadSession(id, st, reinterpret_cast<const char*>(a), n);
+      break;
+    }
+    case kUpdateSession: {
+      uint32_t id = r.U32();
+      a = r.Bytes(&n);
+      b = r.Bytes(&m);
+      cdm->UpdateSession(id, reinterpret_cast<const char*>(a), n, b, m);
+      break;
+    }
+    case kCloseSession:
+    case kRemoveSession: {
+      uint32_t id = r.U32();
+      a = r.Bytes(&n);
+      auto sid = reinterpret_cast<const char*>(a);
+      if (type == kCloseSession) {
+        cdm->CloseSession(id, sid, n);
+      } else {
+        cdm->RemoveSession(id, sid, n);
+      }
+      break;
+    }
+    case kTimerExpired:
+      cdm->TimerExpired(reinterpret_cast<void*>(r.U64()));
+      break;
+    case kDecrypt: {
+      cdm::InputBuffer_2 in;
+      if (!ReadInput(r, in, &subs, &subsCap)) Fail("bad decrypt request");
+      LocalDecryptedBlock block;
+      cdm::Status st = cdm->Decrypt(in, &block);
+      cdm::Buffer* buf = block.DecryptedBuffer();
+      out.U32(st);
+      out.Bytes(buf ? buf->Data() : nullptr, buf ? buf->Size() : 0);
+      out.I64(block.Timestamp());
+      if (buf) buf->Destroy();
+      break;
+    }
+    case kInitializeAudioDecoder: {
+      cdm::AudioDecoderConfig_2 cfg = {};
+      cfg.codec = cdm::AudioCodec(r.U32());
+      cfg.channel_count = int32_t(r.U32());
+      cfg.bits_per_channel = int32_t(r.U32());
+      cfg.samples_per_second = int32_t(r.U32());
+      cfg.extra_data = const_cast<uint8_t*>(r.Bytes(&cfg.extra_data_size));
+      cfg.encryption_scheme = cdm::EncryptionScheme(r.U32());
+      out.U32(cdm->InitializeAudioDecoder(cfg));
+      break;
+    }
+    case kInitializeVideoDecoder: {
+      cdm::VideoDecoderConfig_2 cfg = {};
+      cfg.codec = cdm::VideoCodec(r.U32());
+      cfg.profile = cdm::VideoCodecProfile(r.U32());
+      cfg.format = cdm::VideoFormat(r.U32());
+      cfg.coded_size.width = int32_t(r.U32());
+      cfg.coded_size.height = int32_t(r.U32());
+      cfg.extra_data = const_cast<uint8_t*>(r.Bytes(&cfg.extra_data_size));
+      cfg.encryption_scheme = cdm::EncryptionScheme(r.U32());
+      out.U32(cdm->InitializeVideoDecoder(cfg));
+      break;
+    }
+    case kDeinitializeDecoder:
+      cdm->DeinitializeDecoder(cdm::StreamType(r.U32()));
+      break;
+    case kResetDecoder:
+      cdm->ResetDecoder(cdm::StreamType(r.U32()));
+      break;
+    case kDecryptAndDecodeFrame: {
+      cdm::InputBuffer_2 in;
+      if (!ReadInput(r, in, &subs, &subsCap)) Fail("bad decode request");
+      LocalVideoFrame frame;
+      cdm::Status st = cdm->DecryptAndDecodeFrame(in, &frame);
+      cdm::Buffer* buf = frame.mBuffer;
+      out.U32(st);
+      out.U32(frame.mFormat);
+      out.U32(uint32_t(frame.mSize.width));
+      out.U32(uint32_t(frame.mSize.height));
+      for (int i = 0; i < 3; i++) {
+        out.U32(frame.mOffset[i]);
+        out.U32(frame.mStride[i]);
+      }
+      out.I64(frame.mTimestamp);
+      out.Bytes(buf ? buf->Data() : nullptr, buf ? buf->Size() : 0);
+      if (buf) buf->Destroy();
+      break;
+    }
+    case kDecryptAndDecodeSamples: {
+      cdm::InputBuffer_2 in;
+      if (!ReadInput(r, in, &subs, &subsCap)) Fail("bad decode request");
+      LocalAudioFrames frames;
+      cdm::Status st = cdm->DecryptAndDecodeSamples(in, &frames);
+      cdm::Buffer* buf = frames.mBuffer;
+      out.U32(st);
+      out.U32(frames.mFormat);
+      out.Bytes(buf ? buf->Data() : nullptr, buf ? buf->Size() : 0);
+      if (buf) buf->Destroy();
+      break;
+    }
+    case kOnPlatformChallengeResponse: {
+      cdm::PlatformChallengeResponse resp = {};
+      a = r.Bytes(&n);
+      b = r.Bytes(&m);
+      c = r.Bytes(&k);
+      resp.signed_data = a;
+      resp.signed_data_length = n;
+      resp.signed_data_signature = b;
+      resp.signed_data_signature_length = m;
+      resp.platform_key_certificate = c;
+      resp.platform_key_certificate_length = k;
+      cdm->OnPlatformChallengeResponse(resp);
+      break;
+    }
+    case kOnQueryOutputProtectionStatus: {
+      auto result = cdm::QueryResult(r.U32());
+      uint32_t links = r.U32(), mask = r.U32();
+      cdm->OnQueryOutputProtectionStatus(result, links, mask);
+      break;
+    }
+    case kOnStorageId: {
+      uint32_t version = r.U32();
+      a = r.Bytes(&n);
+      cdm->OnStorageId(version, a, n);
+      break;
+    }
+    case kFileOpenComplete:
+    case kFileWriteComplete: {
+      cdm::FileIOClient* client = FileClient(r.U32());
+      auto st = cdm::FileIOClient::Status(r.U32());
+      if (client && type == kFileOpenComplete) client->OnOpenComplete(st);
+      if (client && type == kFileWriteComplete) client->OnWriteComplete(st);
+      break;
+    }
+    case kFileReadComplete: {
+      cdm::FileIOClient* client = FileClient(r.U32());
+      auto st = cdm::FileIOClient::Status(r.U32());
+      a = r.Bytes(&n);
+      if (client) client->OnReadComplete(st, a, n);
+      break;
+    }
+    case kDestroy:
+      cdm->Destroy();
+      return false;
+    default:
+      Fail("unknown request");
+  }
+  if (!r.Ok()) Fail("short request");
+  return true;
+}
+
+}  // namespace
+
+extern "C" int main(int argc, char** argv) {
+  if (argc != 3) {
+    printf("usage: %s cdm.so fd\n", argv[0]);
+    return 2;
+  }
+  gFd = 0;
+  for (const char* p = argv[2]; *p; p++) gFd = gFd * 10 + (*p - '0');
+
+  void* h = dlopen(argv[1], RTLD_NOW);
+  if (!h) {
+    printf("wvhost: dlopen %s failed: %s\n", argv[1], dlerror());
+    return 1;
+  }
+  auto init = reinterpret_cast<InitFn>(dlsym(h, "InitializeCdmModule_4"));
+  auto create = reinterpret_cast<CreateFn>(dlsym(h, "CreateCdmInstance"));
+  if (!init || !create) Fail("missing CDM entry points");
+  init();
+
+  HostProxy host;
+  gHost = &host;
+  cdm::ContentDecryptionModule_10* cdms[kMaxInstances] = {};
+
+  uint8_t* buf = nullptr;
+  uint32_t cap = 0, len = 0, type = 0, instance = 0;
+  while (Receive(gFd, &type, &instance, &buf, &cap, &len)) {
+    Reader r(buf, len);
+    Writer out;
+    if (type == kCreate) {
+      uint32_t ksLen;
+      const uint8_t* ks = r.Bytes(&ksLen);
+      uint32_t id = 0;
+      while (id < kMaxInstances && cdms[id]) id++;
+      if (id < kMaxInstances) {
+        gInstance = id;
+        cdms[id] = static_cast<cdm::ContentDecryptionModule_10*>(
+            create(cdm::ContentDecryptionModule_10::kVersion,
+                   reinterpret_cast<const char*>(ks), ksLen, GetHost, nullptr));
+      }
+      bool ok = id < kMaxInstances && cdms[id];
+      out.U32(ok);
+      out.U32(id);
+      gInstance = kNoInstance;
+      Send(gFd, kDone, kNoInstance, out);
+      continue;
+    }
+    if (instance >= kMaxInstances || !cdms[instance]) Fail("bad instance");
+    gInstance = instance;
+    if (!Handle(cdms[instance], type, r, out)) cdms[instance] = nullptr;
+    Send(gFd, kDone, instance, out);
+    gInstance = kNoInstance;
+  }
+  return 0;
+}
diff --git a/dom/media/gmp/widevine-proxy/wvinput.h b/dom/media/gmp/widevine-proxy/wvinput.h
new file mode 100644
index 0000000000..1bf6b523a5
--- /dev/null
+++ b/dom/media/gmp/widevine-proxy/wvinput.h
@@ -0,0 +1,55 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// Serialisation of cdm::InputBuffer_2, shared by the proxy and the helper.
+#pragma once
+#include "wvipc.h"
+#include "content_decryption_module.h"
+
+namespace wvipc {
+
+inline void WriteInput(Writer& w, const cdm::InputBuffer_2& in) {
+  w.Bytes(in.data, in.data_size);
+  w.U32(uint32_t(in.encryption_scheme));
+  w.Bytes(in.key_id, in.key_id_size);
+  w.Bytes(in.iv, in.iv_size);
+  w.U32(in.num_subsamples);
+  for (uint32_t i = 0; i < in.num_subsamples; i++) {
+    w.U32(in.subsamples[i].clear_bytes);
+    w.U32(in.subsamples[i].cipher_bytes);
+  }
+  w.U32(in.pattern.crypt_byte_block);
+  w.U32(in.pattern.skip_byte_block);
+  w.I64(in.timestamp);
+}
+
+// |*subs| is grown as needed and owned by the caller. The pointers in |in|
+// point into the message payload.
+inline bool ReadInput(Reader& r, cdm::InputBuffer_2& in,
+                      cdm::SubsampleEntry** subs, uint32_t* subsCap) {
+  in = {};
+  in.data = r.Bytes(&in.data_size);
+  in.encryption_scheme = cdm::EncryptionScheme(r.U32());
+  in.key_id = r.Bytes(&in.key_id_size);
+  in.iv = r.Bytes(&in.iv_size);
+  uint32_t n = r.U32();
+  if (n > 65536) return false;
+  if (n > *subsCap) {
+    *subsCap = n;
+    *subs = static_cast<cdm::SubsampleEntry*>(
+        realloc(*subs, n * sizeof(cdm::SubsampleEntry)));
+  }
+  for (uint32_t i = 0; i < n; i++) {
+    (*subs)[i].clear_bytes = r.U32();
+    (*subs)[i].cipher_bytes = r.U32();
+  }
+  in.subsamples = n ? *subs : nullptr;
+  in.num_subsamples = n;
+  in.pattern.crypt_byte_block = r.U32();
+  in.pattern.skip_byte_block = r.U32();
+  in.timestamp = r.I64();
+  return r.Ok();
+}
+
+}  // namespace wvipc
diff --git a/dom/media/gmp/widevine-proxy/wvipc.h b/dom/media/gmp/widevine-proxy/wvipc.h
new file mode 100644
index 0000000000..b747e6a35f
--- /dev/null
+++ b/dom/media/gmp/widevine-proxy/wvipc.h
@@ -0,0 +1,190 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// Wire protocol between the native proxy CDM (wvproxy.cc) and the x86_64
+// helper that runs the real CDM under box64 (wvhost.cc).
+//
+// The CDM interface is single-threaded, so the protocol is a synchronous RPC
+// over a socketpair. Each proxy -> helper message is a request (a CDM call, a
+// timer, or a FileIO completion). While handling it the helper sends any number
+// of Host_10 callbacks, then one kDone message with the call's results. The
+// proxy forwards the callbacks to Firefox's host as they arrive.
+//
+// One helper serves every CDM instance of a GMP process: kCreate returns an
+// instance id and each later request names the instance it is for.
+//
+// Message: u32 type, u32 instance, u32 payload length, payload. Payload fields
+// are written in order with Writer and read back with Reader; both ends are
+// little-endian.
+#pragma once
+#include "minilibc.h"
+
+namespace wvipc {
+
+enum Type : uint32_t {
+  // Requests, proxy -> helper. kCreate is the first message and names the
+  // key system; the helper answers it with kDone carrying a success flag.
+  kCreate = 0,
+  kInitialize = 1,
+  kGetStatusForPolicy,
+  kSetServerCertificate,
+  kCreateSessionAndGenerateRequest,
+  kLoadSession,
+  kUpdateSession,
+  kCloseSession,
+  kRemoveSession,
+  kTimerExpired,
+  kDecrypt,
+  kInitializeAudioDecoder,
+  kInitializeVideoDecoder,
+  kDeinitializeDecoder,
+  kResetDecoder,
+  kDecryptAndDecodeFrame,
+  kDecryptAndDecodeSamples,
+  kOnPlatformChallengeResponse,
+  kOnQueryOutputProtectionStatus,
+  kOnStorageId,
+  kDestroy,
+  kFileOpenComplete,
+  kFileReadComplete,
+  kFileWriteComplete,
+
+  // Callbacks, helper -> proxy.
+  kDone = 100,
+  kSetTimer,
+  kOnInitialized,
+  kOnResolveKeyStatusPromise,
+  kOnResolveNewSessionPromise,
+  kOnResolvePromise,
+  kOnRejectPromise,
+  kOnSessionMessage,
+  kOnSessionKeysChange,
+  kOnExpirationChange,
+  kOnSessionClosed,
+  kSendPlatformChallenge,
+  kEnableOutputProtection,
+  kQueryOutputProtectionStatus,
+  kOnDeferredInitializationDone,
+  kRequestStorageId,
+  kFileCreate,
+  kFileOpen,
+  kFileRead,
+  kFileWrite,
+  kFileClose,
+};
+
+constexpr uint32_t kMaxMessage = 64 << 20;
+constexpr uint32_t kMaxInstances = 16;
+constexpr uint32_t kNoInstance = 0xffffffff;
+
+class Writer {
+ public:
+  ~Writer() { free(mData); }
+  void U32(uint32_t v) { Raw(&v, 4); }
+  void U64(uint64_t v) { Raw(&v, 8); }
+  void I64(int64_t v) { Raw(&v, 8); }
+  void F64(double v) { Raw(&v, 8); }
+  void Bytes(const void* p, uint32_t n) {
+    U32(n);
+    Raw(p, n);
+  }
+  void Raw(const void* p, uint32_t n) {
+    if (mLen + n > mCap) {
+      while (mLen + n > mCap) mCap = mCap ? mCap * 2 : 256;
+      mData = static_cast<uint8_t*>(realloc(mData, mCap));
+    }
+    if (n) memcpy(mData + mLen, p, n);
+    mLen += n;
+  }
+  const uint8_t* Data() const { return mData; }
+  uint32_t Length() const { return mLen; }
+
+ private:
+  uint8_t* mData = nullptr;
+  uint32_t mLen = 0, mCap = 0;
+};
+
+// Reads fields from a received payload. A short payload sets mBad and yields
+// zeros, so callers check Ok() once at the end.
+class Reader {
+ public:
+  Reader(const uint8_t* p, uint32_t n) : mP(p), mEnd(p + n) {}
+  uint32_t U32() { return Get<uint32_t>(); }
+  uint64_t U64() { return Get<uint64_t>(); }
+  int64_t I64() { return Get<int64_t>(); }
+  double F64() { return Get<double>(); }
+  // Returns a pointer into the payload, valid until the next message.
+  const uint8_t* Bytes(uint32_t* n) {
+    *n = U32();
+    if (uint32_t(mEnd - mP) < *n) {
+      mBad = true;
+      *n = 0;
+      return nullptr;
+    }
+    const uint8_t* p = mP;
+    mP += *n;
+    return p;
+  }
+  bool Ok() const { return !mBad; }
+
+ private:
+  template <typename T>
+  T Get() {
+    T v{};
+    if (uint32_t(mEnd - mP) < sizeof(T)) {
+      mBad = true;
+      return v;
+    }
+    memcpy(&v, mP, sizeof(T));
+    mP += sizeof(T);
+    return v;
+  }
+  const uint8_t* mP;
+  const uint8_t* mEnd;
+  bool mBad = false;
+};
+
+inline bool WriteAll(int fd, const void* p, uint32_t n) {
+  const uint8_t* c = static_cast<const uint8_t*>(p);
+  while (n) {
+    long w = write(fd, c, n);
+    if (w <= 0) return false;
+    c += w;
+    n -= uint32_t(w);
+  }
+  return true;
+}
+
+inline bool ReadAll(int fd, void* p, uint32_t n) {
+  uint8_t* c = static_cast<uint8_t*>(p);
+  while (n) {
+    long r = read(fd, c, n);
+    if (r <= 0) return false;
+    c += r;
+    n -= uint32_t(r);
+  }
+  return true;
+}
+
+inline bool Send(int fd, uint32_t type, uint32_t instance, const Writer& w) {
+  uint32_t hdr[3] = {type, instance, w.Length()};
+  return WriteAll(fd, hdr, 12) && WriteAll(fd, w.Data(), w.Length());
+}
+
+// Receives one message into |*buf| (grown as needed).
+inline bool Receive(int fd, uint32_t* type, uint32_t* instance, uint8_t** buf,
+                    uint32_t* cap, uint32_t* len) {
+  uint32_t hdr[3];
+  if (!ReadAll(fd, hdr, 12) || hdr[2] > kMaxMessage) return false;
+  if (hdr[2] > *cap) {
+    *cap = hdr[2];
+    *buf = static_cast<uint8_t*>(realloc(*buf, *cap));
+  }
+  *type = hdr[0];
+  *instance = hdr[1];
+  *len = hdr[2];
+  return ReadAll(fd, *buf, hdr[2]);
+}
+
+}  // namespace wvipc
diff --git a/dom/media/gmp/widevine-proxy/wvproxy.cc b/dom/media/gmp/widevine-proxy/wvproxy.cc
new file mode 100644
index 0000000000..bede04c175
--- /dev/null
+++ b/dom/media/gmp/widevine-proxy/wvproxy.cc
@@ -0,0 +1,786 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// Native proxy CDM. Firefox loads it as libwidevinecdm.so and it forwards every
+// ContentDecryptionModule_10/11 call to the x86_64 helper (wvhost), which runs
+// the real CDM under box64. See wvipc.h for the protocol.
+//
+// Inside Firefox the GMP child starts the helper before its sandbox engages
+// (through the gmp-helper program beside this library) and passes the socket
+// in MOZ_GMP_HELPER_FD; that one helper serves every CDM instance. Without
+// that variable the proxy starts a helper of its own per instance, for use
+// outside Firefox. Paths for that case, overridable through the environment:
+//   WV_BOX64               box64 (default: box64 from PATH)
+//   WV_HOST                x86_64 helper (default: <this dir>/wvhost)
+//   WV_REAL_CDM            real x86_64 CDM
+//                          (default: <this dir>/libwidevinecdm-x86_64.so)
+//   BOX64_LD_LIBRARY_PATH  (default: <this dir>/x64lib)
+
+#include "wvinput.h"
+
+using namespace wvipc;
+
+extern "C" {
+int execvp(const char* file, char* const argv[]);
+}
+
+extern "C" void __cxa_pure_virtual() { _exit(70); }
+
+#define WV_EXPORT extern "C" __attribute__((visibility("default")))
+
+namespace {
+
+// Firefox passes a Host_10 or a Host_11; they differ only in ReportMetrics,
+// which the real CDM (driven as a CDM 10) never calls.
+class HostRef {
+ public:
+  virtual ~HostRef() {}
+  virtual cdm::Buffer* Allocate(uint32_t capacity) = 0;
+  virtual void SetTimer(int64_t delay_ms, void* context) = 0;
+  virtual void OnInitialized(bool success) = 0;
+  virtual void OnResolveKeyStatusPromise(uint32_t id, cdm::KeyStatus s) = 0;
+  virtual void OnResolveNewSessionPromise(uint32_t id, const char* sid,
+                                          uint32_t len) = 0;
+  virtual void OnResolvePromise(uint32_t id) = 0;
+  virtual void OnRejectPromise(uint32_t id, cdm::Exception e, uint32_t code,
+                               const char* msg, uint32_t len) = 0;
+  virtual void OnSessionMessage(const char* sid, uint32_t sidlen,
+                                cdm::MessageType t, const char* msg,
+                                uint32_t len) = 0;
+  virtual void OnSessionKeysChange(const char* sid, uint32_t sidlen, bool more,
+                                   const cdm::KeyInformation* keys,
+                                   uint32_t count) = 0;
+  virtual void OnExpirationChange(const char* sid, uint32_t len,
+                                  cdm::Time t) = 0;
+  virtual void OnSessionClosed(const char* sid, uint32_t len) = 0;
+  virtual void SendPlatformChallenge(const char* service, uint32_t serviceLen,
+                                     const char* challenge,
+                                     uint32_t challengeLen) = 0;
+  virtual void EnableOutputProtection(uint32_t mask) = 0;
+  virtual void QueryOutputProtectionStatus() = 0;
+  virtual void OnDeferredInitializationDone(cdm::StreamType type,
+                                            cdm::Status status) = 0;
+  virtual cdm::FileIO* CreateFileIO(cdm::FileIOClient* client) = 0;
+  virtual void RequestStorageId(uint32_t version) = 0;
+};
+
+template <typename H>
+class HostImpl final : public HostRef {
+ public:
+  explicit HostImpl(H* h) : mH(h) {}
+  cdm::Buffer* Allocate(uint32_t c) override { return mH->Allocate(c); }
+  void SetTimer(int64_t d, void* ctx) override { mH->SetTimer(d, ctx); }
+  void OnInitialized(bool ok) override { mH->OnInitialized(ok); }
+  void OnResolveKeyStatusPromise(uint32_t id, cdm::KeyStatus s) override {
+    mH->OnResolveKeyStatusPromise(id, s);
+  }
+  void OnResolveNewSessionPromise(uint32_t id, const char* sid,
+                                  uint32_t len) override {
+    mH->OnResolveNewSessionPromise(id, sid, len);
+  }
+  void OnResolvePromise(uint32_t id) override { mH->OnResolvePromise(id); }
+  void OnRejectPromise(uint32_t id, cdm::Exception e, uint32_t code,
+                       const char* msg, uint32_t len) override {
+    mH->OnRejectPromise(id, e, code, msg, len);
+  }
+  void OnSessionMessage(const char* sid, uint32_t sidlen, cdm::MessageType t,
+                        const char* msg, uint32_t len) override {
+    mH->OnSessionMessage(sid, sidlen, t, msg, len);
+  }
+  void OnSessionKeysChange(const char* sid, uint32_t sidlen, bool more,
+                           const cdm::KeyInformation* keys,
+                           uint32_t count) override {
+    mH->OnSessionKeysChange(sid, sidlen, more, keys, count);
+  }
+  void OnExpirationChange(const char* sid, uint32_t len, cdm::Time t) override {
+    mH->OnExpirationChange(sid, len, t);
+  }
+  void OnSessionClosed(const char* sid, uint32_t len) override {
+    mH->OnSessionClosed(sid, len);
+  }
+  void SendPlatformChallenge(const char* s, uint32_t sl, const char* c,
+                             uint32_t cl) override {
+    mH->SendPlatformChallenge(s, sl, c, cl);
+  }
+  void EnableOutputProtection(uint32_t mask) override {
+    mH->EnableOutputProtection(mask);
+  }
+  void QueryOutputProtectionStatus() override {
+    mH->QueryOutputProtectionStatus();
+  }
+  void OnDeferredInitializationDone(cdm::StreamType t, cdm::Status s) override {
+    mH->OnDeferredInitializationDone(t, s);
+  }
+  cdm::FileIO* CreateFileIO(cdm::FileIOClient* c) override {
+    return mH->CreateFileIO(c);
+  }
+  void RequestStorageId(uint32_t v) override { mH->RequestStorageId(v); }
+
+ private:
+  H* mH;
+};
+
+class ProxyCdm;
+class Connection;
+
+// Forwards Firefox's FileIO completions for one helper-side FileIO.
+class ProxyFileClient final : public cdm::FileIOClient {
+ public:
+  ProxyFileClient(ProxyCdm* cdm, uint32_t id) : mCdm(cdm), mId(id) {}
+  void OnOpenComplete(Status status) override;
+  void OnReadComplete(Status status, const uint8_t* data,
+                      uint32_t size) override;
+  void OnWriteComplete(Status status) override;
+
+  cdm::FileIO* mFile = nullptr;
+
+ private:
+  ProxyCdm* mCdm;
+  uint32_t mId;
+};
+
+constexpr uint32_t kMaxFiles = 64;
+
+// A request raised while a call to the helper is in progress (a synchronous
+// FileIO completion, for instance); it is sent once that call has returned.
+struct PendingRequest {
+  ProxyCdm* cdm;
+  uint32_t type;
+  Writer* payload;
+  PendingRequest* next;
+};
+
+template <typename T, typename... Args>
+T* New(Args... args) {
+  return new (malloc(sizeof(T))) T(args...);
+}
+
+template <typename T>
+void Delete(T* p) {
+  if (p) {
+    p->~T();
+    free(p);
+  }
+}
+
+const char* Env(const char* name, const char* fallback) {
+  const char* v = getenv(name);
+  return v && *v ? v : fallback;
+}
+
+// Directory this library was loaded from, with a trailing slash.
+void SelfDir(char* buf, size_t n) {
+  Dl_info info;
+  buf[0] = 0;
+  if (dladdr(reinterpret_cast<void*>(&SelfDir), &info) && info.dli_fname) {
+    const char* slash = strrchr(info.dli_fname, '/');
+    size_t len = slash ? size_t(slash - info.dli_fname + 1) : 0;
+    if (len < n) {
+      memcpy(buf, info.dli_fname, len);
+      buf[len] = 0;
+    }
+  }
+}
+
+void PathFrom(char* buf, size_t n, const char* env, const char* dir,
+              const char* leaf) {
+  const char* v = getenv(env);
+  if (v && *v) {
+    snprintf(buf, n, "%s", v);
+  } else {
+    snprintf(buf, n, "%s%s", dir, leaf);
+  }
+}
+
+// The socket to one helper, shared by the CDM instances it serves.
+class Connection {
+ public:
+  // The helper Firefox started, or null outside Firefox.
+  static Connection* Shared();
+  // A helper of our own under box64; null if it could not be started.
+  static Connection* Spawn();
+
+  Connection(int fd, int pid) : mFd(fd), mPid(pid) {}
+  ~Connection() {
+    if (mFd >= 0) close(mFd);
+    if (mPid > 0) {
+      int status;
+      waitpid(mPid, &status, 0);
+    }
+    free(mBuf);
+  }
+
+  // Sends one request for |who| and serves the helper's callbacks until its
+  // kDone, whose payload the returned Reader covers (until the next call).
+  Reader Call(ProxyCdm* who, uint32_t type, const Writer& w);
+  // Sends a request now, or queues it while a call is in progress.
+  void Request(ProxyCdm* who, uint32_t type, Writer* w);
+  void Flush();
+
+ private:
+  void Dispatch(uint32_t type, Reader& r);
+  HostRef* Host();
+
+  int mFd;
+  int mPid;
+  bool mDead = false;
+  ProxyCdm* mInCall = nullptr;
+  uint8_t* mBuf = nullptr;
+  uint32_t mCap = 0, mLen = 0;
+  PendingRequest* mPending = nullptr;
+  PendingRequest** mPendingTail = &mPending;
+  ProxyFileClient* mFiles[kMaxFiles] = {};
+};
+
+class ProxyCdm final : public cdm::ContentDecryptionModule_10,
+                       public cdm::ContentDecryptionModule_11 {
+ public:
+  ProxyCdm(HostRef* host, Connection* conn, bool ownsConn)
+      : mHost(host), mConn(conn), mOwnsConn(ownsConn) {}
+  ~ProxyCdm() {
+    if (mOwnsConn) Delete(mConn);
+    Delete(mHost);
+  }
+
+  bool Create(const char* keySystem, uint32_t len) {
+    Writer w;
+    w.Bytes(keySystem, len);
+    Reader r = mConn->Call(this, kCreate, w);
+    bool ok = r.U32() != 0;
+    mId = r.U32();
+    return ok && r.Ok();
+  }
+
+  HostRef* Host() const { return mHost; }
+  uint32_t Id() const { return mId; }
+
+  // cdm::ContentDecryptionModule_10 and _11 (identical method sets).
+  void Initialize(bool distinctive, bool persistent, bool hw) override {
+    Writer w;
+    w.U32(distinctive);
+    w.U32(persistent);
+    w.U32(hw);
+    Call(kInitialize, w);
+  }
+  void GetStatusForPolicy(uint32_t id, const cdm::Policy& policy) override {
+    Writer w;
+    w.U32(id);
+    w.U32(policy.min_hdcp_version);
+    Call(kGetStatusForPolicy, w);
+  }
+  void SetServerCertificate(uint32_t id, const uint8_t* cert,
+                            uint32_t len) override {
+    Writer w;
+    w.U32(id);
+    w.Bytes(cert, len);
+    Call(kSetServerCertificate, w);
+  }
+  void CreateSessionAndGenerateRequest(uint32_t id, cdm::SessionType st,
+                                       cdm::InitDataType it,
+                                       const uint8_t* data,
+                                       uint32_t len) override {
+    Writer w;
+    w.U32(id);
+    w.U32(st);
+    w.U32(it);
+    w.Bytes(data, len);
+    Call(kCreateSessionAndGenerateRequest, w);
+  }
+  void LoadSession(uint32_t id, cdm::SessionType st, const char* sid,
+                   uint32_t len) override {
+    Writer w;
+    w.U32(id);
+    w.U32(st);
+    w.Bytes(sid, len);
+    Call(kLoadSession, w);
+  }
+  void UpdateSession(uint32_t id, const char* sid, uint32_t sidlen,
+                     const uint8_t* resp, uint32_t len) override {
+    Writer w;
+    w.U32(id);
+    w.Bytes(sid, sidlen);
+    w.Bytes(resp, len);
+    Call(kUpdateSession, w);
+  }
+  void CloseSession(uint32_t id, const char* sid, uint32_t len) override {
+    SessionCall(kCloseSession, id, sid, len);
+  }
+  void RemoveSession(uint32_t id, const char* sid, uint32_t len) override {
+    SessionCall(kRemoveSession, id, sid, len);
+  }
+  void TimerExpired(void* context) override {
+    Writer* w = New<Writer>();
+    w->U64(reinterpret_cast<uint64_t>(context));
+    mConn->Request(this, kTimerExpired, w);
+  }
+  cdm::Status Decrypt(const cdm::InputBuffer_2& in,
+                      cdm::DecryptedBlock* block) override {
+    Writer w;
+    WriteInput(w, in);
+    Reader r = mConn->Call(this, kDecrypt, w);
+    auto st = cdm::Status(r.U32());
+    uint32_t n;
+    const uint8_t* data = r.Bytes(&n);
+    int64_t ts = r.I64();
+    if (!r.Ok()) st = cdm::kDecryptError;
+    if (st == cdm::kSuccess) {
+      block->SetDecryptedBuffer(CopyOut(data, n));
+      block->SetTimestamp(ts);
+    }
+    mConn->Flush();
+    return st;
+  }
+  cdm::Status InitializeAudioDecoder(
+      const cdm::AudioDecoderConfig_2& cfg) override {
+    Writer w;
+    w.U32(cfg.codec);
+    w.U32(uint32_t(cfg.channel_count));
+    w.U32(uint32_t(cfg.bits_per_channel));
+    w.U32(uint32_t(cfg.samples_per_second));
+    w.Bytes(cfg.extra_data, cfg.extra_data_size);
+    w.U32(uint32_t(cfg.encryption_scheme));
+    return StatusCall(kInitializeAudioDecoder, w);
+  }
+  cdm::Status InitializeVideoDecoder(
+      const cdm::VideoDecoderConfig_2& cfg) override {
+    Writer w;
+    w.U32(cfg.codec);
+    w.U32(cfg.profile);
+    w.U32(cfg.format);
+    w.U32(uint32_t(cfg.coded_size.width));
+    w.U32(uint32_t(cfg.coded_size.height));
+    w.Bytes(cfg.extra_data, cfg.extra_data_size);
+    w.U32(uint32_t(cfg.encryption_scheme));
+    return StatusCall(kInitializeVideoDecoder, w);
+  }
+  void DeinitializeDecoder(cdm::StreamType type) override {
+    Writer w;
+    w.U32(type);
+    Call(kDeinitializeDecoder, w);
+  }
+  void ResetDecoder(cdm::StreamType type) override {
+    Writer w;
+    w.U32(type);
+    Call(kResetDecoder, w);
+  }
+  cdm::Status DecryptAndDecodeFrame(const cdm::InputBuffer_2& in,
+                                    cdm::VideoFrame* frame) override {
+    Writer w;
+    WriteInput(w, in);
+    Reader r = mConn->Call(this, kDecryptAndDecodeFrame, w);
+    auto st = cdm::Status(r.U32());
+    auto format = cdm::VideoFormat(r.U32());
+    cdm::Size size;
+    size.width = int32_t(r.U32());
+    size.height = int32_t(r.U32());
+    uint32_t offset[3], stride[3];
+    for (int i = 0; i < 3; i++) {
+      offset[i] = r.U32();
+      stride[i] = r.U32();
+    }
+    int64_t ts = r.I64();
+    uint32_t n;
+    const uint8_t* data = r.Bytes(&n);
+    if (!r.Ok()) st = cdm::kDecodeError;
+    if (st == cdm::kSuccess) {
+      frame->SetFormat(format);
+      frame->SetSize(size);
+      frame->SetFrameBuffer(CopyOut(data, n));
+      for (int i = 0; i < 3; i++) {
+        frame->SetPlaneOffset(cdm::VideoPlane(i), offset[i]);
+        frame->SetStride(cdm::VideoPlane(i), stride[i]);
+      }
+      frame->SetTimestamp(ts);
+    }
+    mConn->Flush();
+    return st;
+  }
+  cdm::Status DecryptAndDecodeSamples(const cdm::InputBuffer_2& in,
+                                      cdm::AudioFrames* frames) override {
+    Writer w;
+    WriteInput(w, in);
+    Reader r = mConn->Call(this, kDecryptAndDecodeSamples, w);
+    auto st = cdm::Status(r.U32());
+    auto format = cdm::AudioFormat(r.U32());
+    uint32_t n;
+    const uint8_t* data = r.Bytes(&n);
+    if (!r.Ok()) st = cdm::kDecodeError;
+    if (st == cdm::kSuccess) {
+      frames->SetFormat(format);
+      frames->SetFrameBuffer(CopyOut(data, n));
+    }
+    mConn->Flush();
+    return st;
+  }
+  void OnPlatformChallengeResponse(
+      const cdm::PlatformChallengeResponse& resp) override {
+    Writer* w = New<Writer>();
+    w->Bytes(resp.signed_data, resp.signed_data_length);
+    w->Bytes(resp.signed_data_signature, resp.signed_data_signature_length);
+    w->Bytes(resp.platform_key_certificate,
+             resp.platform_key_certificate_length);
+    mConn->Request(this, kOnPlatformChallengeResponse, w);
+  }
+  void OnQueryOutputProtectionStatus(cdm::QueryResult result, uint32_t links,
+                                     uint32_t mask) override {
+    Writer* w = New<Writer>();
+    w->U32(result);
+    w->U32(links);
+    w->U32(mask);
+    mConn->Request(this, kOnQueryOutputProtectionStatus, w);
+  }
+  void OnStorageId(uint32_t version, const uint8_t* id, uint32_t len) override {
+    Writer* w = New<Writer>();
+    w->U32(version);
+    w->Bytes(id, len);
+    mConn->Request(this, kOnStorageId, w);
+  }
+  void Destroy() override {
+    Writer w;
+    Call(kDestroy, w);
+    Delete(this);
+  }
+
+  // Called by ProxyFileClient.
+  void FileComplete(uint32_t type, uint32_t id, uint32_t status,
+                    const uint8_t* data, uint32_t len) {
+    Writer* w = New<Writer>();
+    w->U32(id);
+    w->U32(status);
+    if (type == kFileReadComplete) w->Bytes(data, len);
+    mConn->Request(this, type, w);
+  }
+
+ private:
+  void Call(uint32_t type, const Writer& w) {
+    mConn->Call(this, type, w);
+    mConn->Flush();
+  }
+  void SessionCall(uint32_t type, uint32_t id, const char* sid, uint32_t len) {
+    Writer w;
+    w.U32(id);
+    w.Bytes(sid, len);
+    Call(type, w);
+  }
+  cdm::Status StatusCall(uint32_t type, const Writer& w) {
+    Reader r = mConn->Call(this, type, w);
+    auto st = cdm::Status(r.U32());
+    if (!r.Ok()) st = cdm::kInitializationError;
+    mConn->Flush();
+    return st;
+  }
+  cdm::Buffer* CopyOut(const uint8_t* data, uint32_t n) {
+    cdm::Buffer* buf = mHost->Allocate(n);
+    if (!buf) return nullptr;
+    if (n) memcpy(buf->Data(), data, n);
+    buf->SetSize(n);
+    return buf;
+  }
+
+  HostRef* mHost;
+  Connection* mConn;
+  bool mOwnsConn;
+  uint32_t mId = kNoInstance;
+};

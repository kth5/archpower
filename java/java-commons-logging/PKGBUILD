package() {
  cd "$srcdir"/commons-logging-$pkgver/
  install -d "$pkgdir"/usr/share/java/commons-logging/
  install -m0644 commons-logging-$pkgver.jar \
    "$pkgdir"/usr/share/java/commons-logging/commons-logging.jar
}

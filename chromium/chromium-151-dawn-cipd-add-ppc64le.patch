Dawn's cipd_deps.get_cipd_compatible_current_arch() only knows arm64/amd64
and raises "Unable to determine architecture" on ppc64le, which trips the
//third_party/dawn/src/tint:generate_sources action during the ninja build.

Add ppc64le as a recognized native architecture so the Dawn tint code
generator can locate its go toolchain under the matching subdirectory.

The PKGBUILD places /usr/bin/go under
third_party/dawn/tools/golang/linux-ppc64le/bin/go on this arch.

--- a/third_party/dawn/tools/python/cipd_deps.py
+++ b/third_party/dawn/tools/python/cipd_deps.py
@@ -74,4 +74,7 @@ def get_cipd_compatible_current_arch() -> str:
     native_x86 = platform.machine().lower() in ('x86', 'x86_64', 'amd64')
     if native_x86:
         return 'amd64'
+    native_ppc64le = platform.machine().lower() in ('ppc64le', 'ppcle')
+    if native_ppc64le:
+        return 'ppc64le'
     raise ValueError('Unable to determine architecture')

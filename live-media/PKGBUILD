pkgname=live-media
pkgver=2026.11.08
pkgrel=1
pkgdesc='Set of C++ libraries for multimedia streaming'
url='http://live555.com/liveMedia'
arch=(x86_64 powerpc64le powerpc64 powerpc espresso)
license=('LGPL')
depends=(
  'libgcc'
  'libstdc++'
  'openssl'
)
source=(https://download.live555.com/live.$pkgver.tar.gz)
sha256sums=('95eb2ad572a5f88d817717c00c534dbdfdeb2df0afaa0e0052a52c4f9f041a7c')
sha512sums=('9bcc15ab3becc0f9091b177c397c09744bf14b3738bfebf6feb12e284cb7c01bb81ea74eff4a42e61b02616a873f39c55d6f981606b4de2c7df292f8a06e1b22')

prepare() {
  cd live
  find . -name Makefile.head | xargs sed -e 's|/local||g' -i # Fix prefix
}

build() {
  cd live
  sed -E 's|(-DSOCKLEN_T=socklen_t)|\1 -fPIC -DRTSPCLIENT_SYNCHRONOUS_INTERFACE=1|g' -i config.linux-with-shared-libraries
  ./genMakefiles linux-with-shared-libraries
  CXXFLAGS+=' -std=c++20' \
  make
}

package() {
  cd live
  make DESTDIR="$pkgdir" install
}


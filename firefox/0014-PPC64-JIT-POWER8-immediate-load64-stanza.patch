@@ -848,6 +848,14 @@
                                           CodeLocationLabel target) {
   Instruction* inst = (Instruction*)loc.raw();
   UpdateLoad64Value(inst, (uint64_t)target.raw());
+  // On POWER8 the value is encoded in instruction immediates, so the
+  // update rewrites code. The only current caller (BaselineInterpreter)
+  // patches while its Linker is still live, whose writable scope flushes

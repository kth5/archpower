+void MacroAssemblerPPC64Compat::ma_fcpsgn(FloatRegister dest, FloatRegister signSrc,
+                                    FloatRegister magSrc) {
+  if (HasVSX()) {
+    as_fcpsgn(dest, signSrc, magSrc);
+    return;

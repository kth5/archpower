From 048d9fd8b1d9c2dad8b1d5b0a0e6bda66435fdc4 Mon Sep 17 00:00:00 2001
From: daedalao <daedalao@hotmail.com>
Date: Sat, 10 Oct 2026 12:39:57 -0700
Subject: [PATCH] PPC64 JIT: POWER4-tier fallbacks for pre-ISA-2.07 CPUs

When HasISA207() is false (PowerPC 970/G5, or MOZ_PPC64_FORCE_POWER4=1)
the backend must not emit anything newer than the 64-bit ISA 2.01 plus
VMX 1.0. POWER8 and later keep their current code; every fallback is
selected at code-generation time.

Assembler-level replacements, so every caller is covered:
- mfvsrd/mtvsrd/mtvsrwa/mtvsrwz/mtvsrws move the bits through one
  doubleword at -48(r1), inside the 288-byte protected zone of the
  64-bit ELF ABIs (doubleword accesses, so endian-neutral). The word
  forms pre-extend into r0, which is never allocated.
- isel becomes a conditional branch on the same CR bit around one or
  two register moves, in a no-pool window, leaving CR untouched.
- lfiwax becomes lwax r0 + the transfer slot; fcfids becomes
  fcfid + frsp, exact for every int32/uint32 source.
- mfocrf is emitted as mfcr.

MacroAssembler-level replacements:
- floor/ceil/round to int32 truncate with fctidz and step the integer
  by one when the truncation went the wrong way; nearbyIntDouble does
  the same in the integer unit for |x| < 2^52 and restores the sign of
  a zero result with src * +0.0. HasRoundInstruction() is false on the
  tier, as frim/frip/friz do not exist there.
- copysign splices the sign bit in a GPR.
- Double/float32 min/max replace xsmindp/xsmaxdp with a branch on the
  fcmpu result that is still in CR0.
- Float32 bit moves use stfs/lwz and stw/lfs; float constants are
  loaded as their exactly widened doubles; zeroDouble no longer uses
  xxlxor.
- popcnt uses the SWAR reduction, ctz uses cntlz((x-1) & ~x).
- int64/uint64 to float32/double conversions pre-round with a sticky
  bit so that fcfid + frsp rounds once, and halve/double values with
  the top bit set, instead of fcfids/fcfidu/fcfidus.
- 8- and 16-bit atomics (lbarx/lharx/stbcx./sthcx. are ISA 2.06) use
  lwarx/stwcx. on the containing word with a lane mask, with the lane
  position computed for either endianness. Lowering allocates the lane
  shift/mask temps on the tier.
- Simd128 spills and fills (volatile VRs saved around calls, Simd128
  move cycles, the inline-string concat fast path) go through an
  aligned red-zone slot with VMX stvx/lvx and two doubleword copies.

The irregexp skip loop no longer picks its VSX SIMD variant on the
tier.

Wasm-only emitters (fctiduz, ldbrx/stdbrx, the SIMD128 lowering) are
left alone; wasm is disabled on the tier by the next patch.
---
 .../irregexp/RegExpNativeMacroAssembler.cpp   |   6 +
 js/src/jit/ppc64/Assembler-ppc64.cpp          | 130 +++++-
 js/src/jit/ppc64/Assembler-ppc64.h            |  18 +-
 js/src/jit/ppc64/Lowering-ppc64.cpp           |  22 +-
 js/src/jit/ppc64/MacroAssembler-ppc64-inl.h   | 200 ++++++++-
 js/src/jit/ppc64/MacroAssembler-ppc64.cpp     | 396 +++++++++++++++++-
 js/src/jit/ppc64/MacroAssembler-ppc64.h       |  29 +-
 7 files changed, 766 insertions(+), 35 deletions(-)

diff --git a/js/src/irregexp/RegExpNativeMacroAssembler.cpp b/js/src/irregexp/RegExpNativeMacroAssembler.cpp
index 0d8e6072bb..9d309af354 100644
--- a/js/src/irregexp/RegExpNativeMacroAssembler.cpp
+++ b/js/src/irregexp/RegExpNativeMacroAssembler.cpp
@@ -539,6 +539,12 @@ bool SMRegExpMacroAssembler::SkipUntilBitInTableUseSimd(int advance_by) {
   if (!js::jit::Assembler::HasSSSE3()) {
     return false;
   }
+#  elif defined(JS_CODEGEN_PPC64)
+  // The ppc64 SIMD lowering needs VSX (ISA 2.07). The POWER4 tier (PowerPC
+  // 970) uses the scalar loop.
+  if (!js::jit::HasISA207()) {
+    return false;
+  }
 #  endif
   // V8 found that using SIMD instead of the scalar version was only
   // faster when we are advancing by 1 byte per iteration.
diff --git a/js/src/jit/ppc64/Assembler-ppc64.cpp b/js/src/jit/ppc64/Assembler-ppc64.cpp
index 1f562ba115..d60a4dbce0 100644
--- a/js/src/jit/ppc64/Assembler-ppc64.cpp
+++ b/js/src/jit/ppc64/Assembler-ppc64.cpp
@@ -498,6 +498,13 @@ BufferOffset Assembler::as_mtcrf(uint32_t mask, Register rs) {
 }
 
 BufferOffset Assembler::as_mfocrf(Register rd, CRegisterID crfs) {
+  if (!HasISA207()) {
+    // POWER4 tier: plain mfcr. It returns every CR field, a superset of the
+    // single field mfocrf defines. (The 970 has the ISA 2.01 mfocrf, but it
+    // is microcoded there and the tier sticks to mfcr/mtcrf.)
+    spew("mfcr\t%3s", rd.name());
+    return writeInst(PPC_mfcr | rd.code() << 21);
+  }
   spew("mfocrf\t%3s,cr%d", rd.name(), crfs);
   // FXM is a one-hot 8-bit mask at bits 12-19. Bit (7-crfs) selects the CR.
   return writeInst(PPC_mfocrf | rd.code() << 21 | (1 << (7 - crfs)) << 12);
@@ -1153,14 +1160,59 @@ BufferOffset Assembler::as_isel(Register rt, Register ra, Register rb,
 
 BufferOffset Assembler::as_isel0(Register rt, Register ra, Register rb,
                                  uint16_t bc, CRegisterID cr) {
-  spew("isel\t%3s,%3s,%3s,cr%d:0x%02x", rt.name(), ra.name(), rb.name(), cr,
-       bc);
   MOZ_ASSERT((bc < 0x40) && ((bc & 0x0f) == 0x0c));
   uint16_t nbc = (bc >> 4) + (cr << 2);
+  if (!HasISA207()) {
+    return iselPOWER4(rt, ra, rb, nbc);
+  }
+  spew("isel\t%3s,%3s,%3s,cr%d:0x%02x", rt.name(), ra.name(), rb.name(), cr,
+       bc);
   return writeInst(PPC_isel | rt.code() << 21 | ra.code() << 16 |
                    rb.code() << 11 | nbc << 6);
 }
 
+// POWER4 tier (no isel, ISA 2.03): rt = CR[crbit] ? (ra|0) : rb, as a short
+// branch around one or two moves. The sequence uses fixed displacements, so
+// keep pools and veneer islands out of it. Leaves CR untouched like isel.
+BufferOffset Assembler::iselPOWER4(Register rt, Register ra, Register rb,
+                                   uint16_t crbit) {
+  auto branchOnBit = [&](bool ifSet, int16_t disp) {
+    // bc BO,BI,disp: BO=12 branch if CR bit set, BO=4 branch if clear.
+    spew("b%s\tcrbit %d,.+%d", ifSet ? "t" : "f", crbit, disp);
+    return writeInst(PPC_bc | (ifSet ? 12u : 4u) << 21 | uint32_t(crbit) << 16 |
+                     (uint16_t(disp) & 0xfffc));
+  };
+  auto moveA = [&]() {
+    // The isel RA operand reads as literal 0 when it is r0.
+    if (ra == r0) {
+      xs_li(rt, 0);
+    } else {
+      xs_mr(rt, ra);
+    }
+  };
+  m_buffer.enterNoPool(4);
+  BufferOffset start;
+  if (rt == rb) {
+    if (rt == ra && ra != r0) {
+      start = as_nop();
+    } else {
+      start = branchOnBit(false, 8);
+      moveA();
+    }
+  } else if (rt == ra && ra != r0) {
+    start = branchOnBit(true, 8);
+    xs_mr(rt, rb);
+  } else {
+    start = branchOnBit(true, 12);
+    xs_mr(rt, rb);
+    spew("b\t.+8");
+    writeInst(PPC_b | 8);
+    moveA();
+  }
+  m_buffer.leaveNoPool();
+  return start;
+}
+
 BufferOffset Assembler::as_setbc(Register rt, uint16_t bc, CRegisterID cr) {
   spew("setbc\t%3s,cr%d:0x%02x", rt.name(), cr, bc);
   MOZ_ASSERT((bc < 0x40) && ((bc & 0x0f) == 0x0c));
@@ -1212,7 +1264,6 @@ DEF_FPUDS(fabs)
 DEF_FPUDS(fneg)
 DEF_FPUDS(fmr)
 DEF_FPUDS(fcfid)
-DEF_FPUDS(fcfids)
 DEF_FPUDS(fcfidu)
 DEF_FPUDS(fcfidus)
 DEF_FPUDS(fctid)
@@ -1227,6 +1278,34 @@ DEF_FPUDS(fsqrt)
 DEF_FPUDS(fsqrts)
 #undef DEF_FPUDS
 
+// fcfids is ISA 2.06. The POWER4 tier converts to double and rounds once
+// more to single. That is exact for every source of at most 53 significant
+// bits (all int32/uint32 callers); the int64 callers pre-round in the
+// MacroAssembler so the second rounding cannot change the result.
+BufferOffset Assembler::as_fcfids(FloatRegister rd, FloatRegister rs) {
+  if (!HasISA207()) {
+    BufferOffset bo = as_fcfid(rd, rs);
+    as_frsp(rd, rd);
+    return bo;
+  }
+  spew("fcfids\t%3s,%3s", rd.name(), rs.name());
+  return writeInst(XForm(PPC_fcfids, rd, f0, rs, false));
+}
+
+// lfiwax is ISA 2.05. The POWER4 tier loads the word sign-extended into r0
+// and moves it over through the transfer slot. The returned offset is the
+// faulting load.
+BufferOffset Assembler::as_lfiwax(FloatRegister rd, Register ra, Register rb) {
+  if (!HasISA207()) {
+    BufferOffset bo = as_lwax(r0, ra, rb);
+    as_std(r0, StackPointer, POWER4TransferSlot);
+    as_lfd(rd, StackPointer, POWER4TransferSlot);
+    return bo;
+  }
+  spew("lfiwax\t%3s,%3s,%3s", rd.name(), ra.name(), rb.name());
+  return writeInst(XForm(PPC_lfiwax, rd, ra, rb, false));
+}
+
 // --- FP loads/stores (D-form) ---
 
 DEF_DFORM_F(lfd)
@@ -1238,8 +1317,7 @@ DEF_DFORM_F(stfsu)
 
 // --- FP loads/stores (X-form, indexed) ---
 
-DEF_FMEMx(lfdx) DEF_FMEMx(lfsx) DEF_FMEMx(lfiwax)
-    DEF_FMEMx(stfdx) DEF_FMEMx(stfsx)
+DEF_FMEMx(lfdx) DEF_FMEMx(lfsx) DEF_FMEMx(stfdx) DEF_FMEMx(stfsx)
 // Clean up macros.
 #undef DEF_XFORM
 #undef DEF_XFORM_RC
@@ -1282,27 +1360,69 @@ BufferOffset Assembler::as_mcrfs(CRegisterID bf, uint8_t bfa) {
 
 // --- VSX (FPR-only subset) ---
 
+// POWER4 tier: there are no direct GPR<->FPR moves before ISA 2.07, so the
+// mfvsr*/mtvsr* emitters bounce the bits through one doubleword of the
+// ABI-protected zone below the stack pointer (POWER4TransferSlot). Full
+// doubleword stores and loads keep this independent of endianness. Only
+// FPR-encoded VSRs (0-31) can take this path; Simd128 registers belong to
+// wasm SIMD, which the tier does not support. Sequences that need a
+// pre-processed GPR value use r0, which is never allocated.
 BufferOffset Assembler::as_mfvsrd(Register ra, FloatRegister xs) {
+  if (!HasISA207()) {
+    MOZ_RELEASE_ASSERT(xs.encoding() < 32);
+    BufferOffset bo = as_stfd(xs, StackPointer, POWER4TransferSlot);
+    as_ld(ra, StackPointer, POWER4TransferSlot);
+    return bo;
+  }
   spew("mfvsrd\t%3s,%3s", ra.name(), xs.name());
   return writeInst(XX1FormMfvsr(PPC_mfvsrd, ra.code(), xs.encoding()));
 }
 
 BufferOffset Assembler::as_mtvsrd(FloatRegister xt, Register ra) {
+  if (!HasISA207()) {
+    MOZ_RELEASE_ASSERT(xt.encoding() < 32);
+    BufferOffset bo = as_std(ra, StackPointer, POWER4TransferSlot);
+    as_lfd(xt, StackPointer, POWER4TransferSlot);
+    return bo;
+  }
   spew("mtvsrd\t%3s,%3s", xt.name(), ra.name());
   return writeInst(XX1Form(PPC_mtvsrd, xt.encoding(), ra.code(), 0));
 }
 
 BufferOffset Assembler::as_mtvsrwa(FloatRegister xt, Register ra) {
+  if (!HasISA207()) {
+    MOZ_RELEASE_ASSERT(xt.encoding() < 32);
+    BufferOffset bo = as_extsw(r0, ra);
+    as_std(r0, StackPointer, POWER4TransferSlot);
+    as_lfd(xt, StackPointer, POWER4TransferSlot);
+    return bo;
+  }
   spew("mtvsrwa\t%3s,%3s", xt.name(), ra.name());
   return writeInst(XX1Form(PPC_mtvsrwa, xt.encoding(), ra.code(), 0));
 }
 
 BufferOffset Assembler::as_mtvsrws(FloatRegister xt, Register ra) {
+  if (!HasISA207()) {
+    // Word splat: both words of doubleword 0 get the low word of ra.
+    MOZ_RELEASE_ASSERT(xt.encoding() < 32);
+    BufferOffset bo = as_rldicl(r0, ra, 0, 32);
+    as_rldimi(r0, ra, 32, 0);
+    as_std(r0, StackPointer, POWER4TransferSlot);
+    as_lfd(xt, StackPointer, POWER4TransferSlot);
+    return bo;
+  }
   spew("mtvsrws\t%3s,%3s", xt.name(), ra.name());
   return writeInst(XX1Form(PPC_mtvsrws, xt.encoding(), ra.code(), 0));
 }
 
 BufferOffset Assembler::as_mtvsrwz(FloatRegister xt, Register ra) {
+  if (!HasISA207()) {
+    MOZ_RELEASE_ASSERT(xt.encoding() < 32);
+    BufferOffset bo = as_rldicl(r0, ra, 0, 32);
+    as_std(r0, StackPointer, POWER4TransferSlot);
+    as_lfd(xt, StackPointer, POWER4TransferSlot);
+    return bo;
+  }
   spew("mtvsrwz\t%3s,%3s", xt.name(), ra.name());
   return writeInst(XX1Form(PPC_mtvsrwz, xt.encoding(), ra.code(), 0));
 }
diff --git a/js/src/jit/ppc64/Assembler-ppc64.h b/js/src/jit/ppc64/Assembler-ppc64.h
index f1ead56ded..6f778e8ed5 100644
--- a/js/src/jit/ppc64/Assembler-ppc64.h
+++ b/js/src/jit/ppc64/Assembler-ppc64.h
@@ -106,6 +106,13 @@ static constexpr Register SavedScratchRegister = r16;
 
 static constexpr Register SecondScratchReg = r12;
 
+// POWER4 tier (no ISA 2.07 VSX, e.g. PowerPC 970): GPR<->FPR moves go through
+// this doubleword below the stack pointer. It lies inside the 288-byte
+// protected zone that both 64-bit PowerPC ELF ABIs guarantee is not touched
+// by signal delivery, and clear of the other red-zone users in this backend
+// (-8 and -16..-1/-32..-17 for atomics and the wasm SIMD stash).
+static constexpr int16_t POWER4TransferSlot = -48;
+
 static constexpr FloatRegister ScratchFloat32Reg{FloatRegisters::f0,
                                                  FloatRegisters::Single};
 static constexpr FloatRegister ScratchDoubleReg = f0;
@@ -516,6 +523,7 @@ enum PPCOpcodes {
   PPC_stdbrx = 0x7C000528,  // XO=660 (POWER7+)
   PPC_mcrxrx = 0x7C000480,
   PPC_mcrfs = 0xFC000080,
+  PPC_mfcr = 0x7C000026,
   PPC_mfocrf = 0x7C100026,
   PPC_mffs = 0xFC00048E,
   PPC_mfspr = 0x7C0002A6,
@@ -1661,6 +1669,9 @@ class Assembler : public AssemblerShared {
                        CRegisterID cr = cr0);
   BufferOffset as_isel0(Register rt, Register ra, Register rb, uint16_t rc,
                         CRegisterID cr = cr0);
+  // POWER4-tier isel replacement (see Assembler-ppc64.cpp).
+  BufferOffset iselPOWER4(Register rt, Register ra, Register rb,
+                          uint16_t crbit);
 
   // FP compare.
   BufferOffset as_fcmpu(CRegisterID cr, FloatRegister ra, FloatRegister rb);
@@ -2096,7 +2107,12 @@ class Assembler : public AssemblerShared {
   static bool HasRoundInstruction(RoundingMode mode) {
     // PPC64 has friz (trunc), frip (ceil), frim (floor), which are all correct.
     // frin (round-to-nearest) does NOT implement proper IEEE banker's rounding
-    // (ties to even), so NearestTiesToEven is not supported.
+    // (ties to even), so NearestTiesToEven is not supported. The fri* forms
+    // are ISA 2.02, so the POWER4 tier (PowerPC 970, ISA 2.01) has none and
+    // Math.floor/ceil/trunc on doubles take the shared non-inline paths.
+    if (!HasISA207()) {
+      return false;
+    }
     return mode == RoundingMode::TowardsZero || mode == RoundingMode::Up ||
            mode == RoundingMode::Down;
   }
diff --git a/js/src/jit/ppc64/Lowering-ppc64.cpp b/js/src/jit/ppc64/Lowering-ppc64.cpp
index 278d3e38b1..73c29ea24a 100644
--- a/js/src/jit/ppc64/Lowering-ppc64.cpp
+++ b/js/src/jit/ppc64/Lowering-ppc64.cpp
@@ -514,6 +514,12 @@ void LIRGenerator::visitCompareExchangeTypedArrayElement(
     // for the 32-bit cmpw. offsetTemp/maskTemp are unused (no round-down
     // + bit-isolate dance), and remain BogusTemp.
     valueTemp = temp();
+    if (!HasISA207()) {
+      // POWER4 tier: no lbarx/lharx; the lwarx-on-the-containing-word
+      // fallback needs the lane shift and mask registers too.
+      offsetTemp = temp();
+      maskTemp = temp();
+    }
   }
 
   auto* lir = new (alloc()) LCompareExchangeTypedArrayElement(
@@ -550,7 +556,13 @@ void LIRGenerator::visitAtomicExchangeTypedArrayElement(
   // PPC64 sub-word atomic exchange uses lbarx/lharx + stbcx./sthcx. directly
   // (POWER7+); valueTemp/offsetTemp/maskTemp are never read by the
   // implementation (see MacroAssembler-ppc64.cpp's AtomicExchange template).
-  // Leave them as BogusTemp.
+  // Leave them as BogusTemp, except on the POWER4 tier (no lbarx/lharx),
+  // where the masked lwarx fallback needs all three.
+  if (Scalar::byteSize(ins->arrayType()) < 4 && !HasISA207()) {
+    valueTemp = temp();
+    offsetTemp = temp();
+    maskTemp = temp();
+  }
 
   auto* lir = new (alloc()) LAtomicExchangeTypedArrayElement(
       elements, index, value, valueTemp, offsetTemp, maskTemp);
@@ -595,7 +607,13 @@ void LIRGenerator::visitAtomicTypedArrayElementBinop(
   // condition-stored (MacroAssembler-ppc64.cpp's AtomicFetchOp); the
   // for-effect variant uses an internal scratch and needs no temps at
   // all. offsetTemp/maskTemp are unused in either path.
-  if (Scalar::byteSize(ins->arrayType()) < 4 && !ins->isForEffect()) {
+  if (Scalar::byteSize(ins->arrayType()) < 4 && !HasISA207()) {
+    // POWER4 tier (no lbarx/lharx): the masked lwarx fallback needs a lane
+    // temp, the lane shift and the lane mask for both variants.
+    valueTemp = temp();
+    offsetTemp = temp();
+    maskTemp = temp();
+  } else if (Scalar::byteSize(ins->arrayType()) < 4 && !ins->isForEffect()) {
     valueTemp = temp();
   }
 
diff --git a/js/src/jit/ppc64/MacroAssembler-ppc64-inl.h b/js/src/jit/ppc64/MacroAssembler-ppc64-inl.h
index 29b53925df..238b4b05e3 100644
--- a/js/src/jit/ppc64/MacroAssembler-ppc64-inl.h
+++ b/js/src/jit/ppc64/MacroAssembler-ppc64-inl.h
@@ -61,6 +61,13 @@ void MacroAssembler::move32To64SignExtend(Register src, Register64 dest) {
 }
 
 void MacroAssembler::moveFloat32ToGPR(FloatRegister src, Register dest) {
+  if (!HasISA207()) {
+    // POWER4 tier: stfs performs the double-format -> single conversion
+    // (non-signalling, like xscvdpspn) and lwz zero-extends the bits.
+    as_stfs(src, StackPointer, POWER4TransferSlot);
+    as_lwz(dest, StackPointer, POWER4TransferSlot);
+    return;
+  }
   // FPR holds double-format value (PPC convention). Convert to
   // single-precision bits in bits 0:31 of the VSR, then extract.
   as_xscvdpspn(ScratchDoubleReg, src);
@@ -69,6 +76,13 @@ void MacroAssembler::moveFloat32ToGPR(FloatRegister src, Register dest) {
 }
 
 void MacroAssembler::moveGPRToFloat32(Register src, FloatRegister dest) {
+  if (!HasISA207()) {
+    // POWER4 tier: a word store plus lfs, which widens the single to the
+    // FPR double format without touching a signalling NaN.
+    as_stw(src, StackPointer, POWER4TransferSlot);
+    as_lfs(dest, StackPointer, POWER4TransferSlot);
+    return;
+  }
   // Place raw single-precision bits in VSR bits 0:31, then convert
   // to double-precision format (matching PPC's FPR convention, like lfs).
   if (HasPOWER9()) {
@@ -1150,7 +1164,14 @@ void MacroAssembler::minFloat32(FloatRegister other, FloatRegister srcDest,
   ma_b(Assembler::DoubleEqual, &equal);
   // Ordered and distinct: the base min/max form is exact on this
   // domain (NaN and equal/zero cases were branched out above).
-  as_xsmindp(srcDest, srcDest, other);
+  if (HasISA207()) {
+    as_xsmindp(srcDest, srcDest, other);
+  } else {
+    // POWER4 tier: CR0 still holds fcmpu(srcDest, other), ordered and
+    // unequal here, so a branch around fmr picks the minimum.
+    ma_b(Assembler::DoubleLessThan, &done);
+    as_fmr(srcDest, other);
+  }
   jump(&done);
 
   bind(&equal);
@@ -1191,7 +1212,14 @@ void MacroAssembler::minDouble(FloatRegister other, FloatRegister srcDest,
   ma_b(Assembler::DoubleEqual, &equal);
   // Ordered and distinct: the base min/max form is exact on this
   // domain (NaN and equal/zero cases were branched out above).
-  as_xsmindp(srcDest, srcDest, other);
+  if (HasISA207()) {
+    as_xsmindp(srcDest, srcDest, other);
+  } else {
+    // POWER4 tier: CR0 still holds fcmpu(srcDest, other), ordered and
+    // unequal here, so a branch around fmr picks the minimum.
+    ma_b(Assembler::DoubleLessThan, &done);
+    as_fmr(srcDest, other);
+  }
   jump(&done);
 
   bind(&equal);
@@ -1227,7 +1255,14 @@ void MacroAssembler::maxFloat32(FloatRegister other, FloatRegister srcDest,
   ma_b(Assembler::DoubleEqual, &equal);
   // Ordered and distinct: the base min/max form is exact on this
   // domain (NaN and equal/zero cases were branched out above).
-  as_xsmaxdp(srcDest, srcDest, other);
+  if (HasISA207()) {
+    as_xsmaxdp(srcDest, srcDest, other);
+  } else {
+    // POWER4 tier: CR0 still holds fcmpu(srcDest, other), ordered and
+    // unequal here, so a branch around fmr picks the maximum.
+    ma_b(Assembler::DoubleGreaterThan, &done);
+    as_fmr(srcDest, other);
+  }
   jump(&done);
 
   bind(&equal);
@@ -1261,7 +1296,14 @@ void MacroAssembler::maxDouble(FloatRegister other, FloatRegister srcDest,
   ma_b(Assembler::DoubleEqual, &equal);
   // Ordered and distinct: the base min/max form is exact on this
   // domain (NaN and equal/zero cases were branched out above).
-  as_xsmaxdp(srcDest, srcDest, other);
+  if (HasISA207()) {
+    as_xsmaxdp(srcDest, srcDest, other);
+  } else {
+    // POWER4 tier: CR0 still holds fcmpu(srcDest, other), ordered and
+    // unequal here, so a branch around fmr picks the maximum.
+    ma_b(Assembler::DoubleGreaterThan, &done);
+    as_fmr(srcDest, other);
+  }
   jump(&done);
 
   bind(&equal);
@@ -1538,7 +1580,7 @@ void MacroAssembler::clz64(Register64 src, Register64 dest) {
 void MacroAssembler::ctz64(Register64 src, Register64 dest) {
   if (HasPOWER9()) {
     as_cnttzd(dest.reg, src.reg);
-  } else {
+  } else if (HasISA207()) {
     UseScratchRegisterScope temps(*this);

+static __inline v32u Box2_VSX(v8u s, v8u t, v8u one, v32u two, int hi) {
+  v8u q = hi ? SHUFFLE_VSX(s, t, 8, 12, 24, 28, 9, 13, 25, 29, 10, 14, 26, 30,
+                           11, 15, 27, 31)

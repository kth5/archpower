+++ b/mozglue/baseprofiler/moz.build
@@ -35,7 +35,8 @@ if not CONFIG["JS_STANDALONE"]:
         )
         or (
             CONFIG["OS_TARGET"] == "Linux"
-            and CONFIG["TARGET_CPU"] in ("aarch64", "arm", "x86", "x86_64", "mips64")
+            and CONFIG["TARGET_CPU"]
+            in ("aarch64", "arm", "x86", "x86_64", "mips64", "ppc64")
         )
         or (
             CONFIG["OS_TARGET"] == "FreeBSD"
diff --git a/mozglue/baseprofiler/public/ProfilerPlatformMacros.h b/mozglue/baseprofiler/public/ProfilerPlatformMacros.h
index 6d5d7e91ef78..1648df9a3c08 100644
--- a/mozglue/baseprofiler/public/ProfilerPlatformMacros.h
+++ b/mozglue/baseprofiler/public/ProfilerPlatformMacros.h
@@ -22,6 +22,7 @@
 #undef GP_PLAT_amd64_linux
 #undef GP_PLAT_arm_linux
 #undef GP_PLAT_mips64_linux
+#undef GP_PLAT_ppc64_linux
 #undef GP_PLAT_amd64_darwin
 #undef GP_PLAT_arm64_darwin
 #undef GP_PLAT_x86_windows
@@ -36,6 +37,7 @@
 #undef GP_ARCH_arm
 #undef GP_ARCH_arm64
 #undef GP_ARCH_mips64
+#undef GP_ARCH_ppc64
 #undef GP_ARCH_unknown
 
 #undef GP_OS_android
@@ -93,6 +95,11 @@
 #  define GP_ARCH_mips64 1
 #  define GP_OS_linux 1
 
+#elif defined(__linux__) && defined(__powerpc64__)
+#  define GP_PLAT_ppc64_linux 1
+#  define GP_ARCH_ppc64 1

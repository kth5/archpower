From 91d9816f6ad191eb38461b460f35affffb4fc959 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Trung=20L=C3=AA?= <8@tle.id.au>
Date: Tue, 29 Sep 2026 23:52:05 +1000
Subject: [PATCH 9/9] Include <algorithm> in TestFontOverlapPrevention.cpp

std::find_if is used but only <string> and <vector> were included. This
compiles where the header is pulled in transitively, but fails with
libstdc++ 16, which no longer does so:

  error: 'find_if' is not a member of 'std'; did you mean 'find'?
---
 gfx/tests/gtest/TestFontOverlapPrevention.cpp | 1 +
 1 file changed, 1 insertion(+)

diff --git a/gfx/tests/gtest/TestFontOverlapPrevention.cpp b/gfx/tests/gtest/TestFontOverlapPrevention.cpp
index 79a33ce97cd9..583925786e79 100644
--- a/gfx/tests/gtest/TestFontOverlapPrevention.cpp
+++ b/gfx/tests/gtest/TestFontOverlapPrevention.cpp
@@ -2,6 +2,7 @@
  * http://creativecommons.org/publicdomain/zero/1.0/
  */
 
+#include <algorithm>
 #include <string>
 #include <vector>
 

+// ========================================================================
+// Label-use chains.
+//
+// Unbound labels hold the offset of their most recent use (the chain head).
+// Each use links to the next one: tagged stanzas through the absolute offset
+// stored in the word after the tw, short `b`/`bc` through a relative byte
+// displacement in their own displacement field (0 = end), mirroring ARM64's
+// use of the branch immediate as the link.
+//
+// Invariant (as on ARM64): the tail of every chain can reach the current
+// end of the buffer. A short `bc` that is still registered with the buffer
+// has a deadline beyond nextOffset(); one whose deadline expired was given a
+// veneer `b`, which the buffer inserted *after* it in the chain
+// (PatchShortRangeBranchToVeneer), so it is never the tail. A `b` reaches
+// +/-32 MiB and a tagged stanza any offset.
+// ========================================================================
+
+BufferOffset Assembler::nextLink(BufferOffset cur) {
+  Instruction* inst = editSrc(cur);
+  uint32_t enc = inst->encode();
+  if (IsTaggedTrapInst(enc)) {
+    uint32_t word = inst->next()->encode();
+    if (word == LabelBase::INVALID_OFFSET) {
+      return BufferOffset();
+    }
+    return BufferOffset(int(word));
+  }
+  int32_t disp;
+  if (IsShortChainBc(enc)) {
+    disp = DecodeBcDisplacement(enc);
+  } else if (IsShortChainB(enc)) {
+    disp = DecodeBDisplacement(enc);
+  } else {
+    MOZ_CRASH("Unexpected instruction in label use chain");
+  }
+  if (disp == 0) {
+    return BufferOffset();
+  }
+  return BufferOffset(cur.getOffset() + disp);
+}
+
+bool Assembler::setNextLink(BufferOffset cur, BufferOffset next) {
+  Instruction* inst = editSrc(cur);
+  uint32_t enc = inst->encode();
+  if (IsTaggedTrapInst(enc)) {
+    inst->next()->setData(next.assigned() ? uint32_t(next.getOffset())
+                                          : LabelBase::INVALID_OFFSET);
+    return true;
+  }
+  int32_t disp = 0;
+  if (next.assigned()) {
+    disp = next.getOffset() - cur.getOffset();
+    MOZ_ASSERT(disp != 0, "a branch cannot link to itself");
+  }
+  if (IsShortChainBc(enc)) {
+    if (!BOffImm16::IsInRange(disp)) {
+      return false;
+    }
+    inst->setData(EncodeBcDisplacement(enc, disp));
+    return true;
+  }
+  if (IsShortChainB(enc)) {
+    if (!JOffImm26::IsInRange(disp)) {
+      return false;
+    }
+    inst->setData(EncodeBDisplacement(enc, disp));
+    return true;
+  }
+  MOZ_CRASH("Unexpected instruction in label use chain");
+}
+
+BufferOffset Assembler::chainTail(BufferOffset head) {
+  BufferOffset tail = head;
+  for (BufferOffset next = nextLink(tail); next.assigned();
+       next = nextLink(tail)) {
+    tail = next;
+  }
+  return tail;
+}
+
+void Assembler::linkShortBranchUse(BufferOffset branch, Label* label) {
+  MOZ_ASSERT(!label->bound());
+  if (oom() || !branch.assigned()) {
+    return;
+  }
+  MOZ_ASSERT(nextLink(branch).assigned() == false,
+             "fresh short branch must carry an end-of-chain link");
+  if (!label->used()) {
+    label->use(branch.getOffset());
+    return;
+  }
+  // Common case: prepend; the new branch links back to the current head.
+  BufferOffset head(label);
+  if (setNextLink(branch, head)) {
+    label->use(branch.getOffset());
     return;
   }
+  // The head is out of (backward) reach of the new branch. Append the new
+  // branch at the tail instead: by the chain invariant the tail reaches the
+  // current end of the buffer, i.e. the new branch.
+  BufferOffset tail = chainTail(head);
+  if (!setNextLink(tail, branch)) {
+    JitSpew(JitSpew_Codegen,
+            "ppc64: label chain tail @%d cannot reach new use @%d",
+            tail.getOffset(), branch.getOffset());
+    MOZ_ASSERT(IsShortChainB(editSrc(tail)->encode()),
+               "only a >32 MiB b link can fail here");
+    m_buffer.fail_oom();
+  }
+}
 

+  // Short-range branch tracking. Range 0 is the 16-bit `bc` displacement
+  // (BD field, -32768..+32764 bytes). The deadline registered for a `bc` at
+  // offset X is X + BcMaxForwardOffset, the last offset it reaches directly.
+  static constexpr unsigned BcRangeIdx = 0;
+  static constexpr int32_t BcMaxForwardOffset = 32764;
+
+  // Label-use chain encodings. A chain element is one of:
+  //   - a tw-tagged stanza (BTag/BCTag/CallTag): link = absolute buffer
+  //     offset in the following word, LabelBase::INVALID_OFFSET = end;
+  //   - a short `bc` (AA=0, LK=0): link = signed byte displacement in BD;
+  //   - a short `b` (AA=0, LK=0; forward jump or veneer): link = signed byte
+  //     displacement in LI.
+  // For the short forms a displacement of 0 means end of chain.
+  static bool IsTaggedTrapInst(uint32_t enc) {
+    return (enc & 0xFC0007FE) == uint32_t(PPC_tw);
+  }
+  static bool IsShortChainBc(uint32_t enc) {
+    return (enc & uint32_t(PPC_MAJOR_OPCODE_MASK)) == uint32_t(PPC_bc) &&
+           (enc & 3) == 0;
+  }
+  static bool IsShortChainB(uint32_t enc) {
+    return (enc & uint32_t(PPC_MAJOR_OPCODE_MASK)) == uint32_t(PPC_b) &&
+           (enc & 3) == 0;
+  }
+  static int32_t DecodeBcDisplacement(uint32_t enc) {
+    return int32_t(int16_t(uint16_t(enc & 0xFFFC)));
+  }
+  static int32_t DecodeBDisplacement(uint32_t enc) {
+    return int32_t((enc & 0x03FFFFFC) << 6) >> 6;
+  }
+  static uint32_t EncodeBcDisplacement(uint32_t enc, int32_t disp) {
+    MOZ_ASSERT(BOffImm16::IsInRange(disp) && (disp & 3) == 0);
+    return (enc & 0xFFFF0003) | (uint32_t(disp) & 0xFFFC);
+  }
+  static uint32_t EncodeBDisplacement(uint32_t enc, int32_t disp) {
+    MOZ_ASSERT(JOffImm26::IsInRange(disp) && (disp & 3) == 0);
+    return (enc & 0xFC000003) | (uint32_t(disp) & 0x03FFFFFC);
+  }
+

From cf2fad10bef7fc116f484eaa34bf896dcb7607f1 Mon Sep 17 00:00:00 2001
From: daedalao <daedalao@hotmail.com>
Date: Sat, 10 Oct 2026 12:40:27 -0700
Subject: [PATCH] PPC64 simulator: fence off non-970 instructions on the POWER4
 tier

With the POWER4 tier active (MOZ_PPC64_FORCE_POWER4=1 under
JS_SIMULATOR) the simulator now checks every instruction against what a
PowerPC 970 implements, the 64-bit PowerPC ISA 2.01 user instructions
plus VMX 1.0, before executing it, and crashes with a description of
the offending instruction otherwise (also printed on stderr, since
release builds do not print MOZ_CRASH messages). Running the jit-tests
on a simulator build this way checks that the tier's fallbacks are
complete, which running on POWER8 hardware cannot: POWER8 executes the
newer instructions just fine.

The check is an allow-list by primary opcode and extended opcode for
the encodings this backend can produce, and names the common
offenders (isel, mfvsrd/mtvsrd, VSX, lbarx/lharx, fri*, fcpsgn,
fcfid[u]s, popcnt, mod*, ...). mfocrf/mtocrf are rejected as well, as
the tier sticks to mfcr/mtcrf.

MOZ_PPC64_SIM_POWER4_FENCE=1 enables the fence for the normal POWER8
code paths as a negative control: the first isel already trips it.
---
 js/src/jit/ppc64/Simulator-ppc64.cpp | 297 +++++++++++++++++++++++++++
 1 file changed, 297 insertions(+)

diff --git a/js/src/jit/ppc64/Simulator-ppc64.cpp b/js/src/jit/ppc64/Simulator-ppc64.cpp
index 79ce92e6c1..b1de4f85b3 100644
--- a/js/src/jit/ppc64/Simulator-ppc64.cpp
+++ b/js/src/jit/ppc64/Simulator-ppc64.cpp
@@ -6957,6 +6957,288 @@ void Simulator::decodePrefixed(SimInstruction* prefix) {
 // Top-level instruction decoder.
 // =============================================================================
 
+// =============================================================================
+// POWER4 tier fence.
+//
+// With MOZ_PPC64_FORCE_POWER4=1 the JIT promises to emit only instructions
+// that a PowerPC 970 (G5) implements: the 64-bit PowerPC ISA 2.01 user
+// instruction set plus VMX (AltiVec) 1.0. The simulator then refuses
+// everything else, which makes it a completeness check for the tier's
+// fallbacks. This is not a full decoder; it recognises the encodings this
+// backend can produce and rejects anything it does not know.
+// =============================================================================
+
+static bool InU16List(const uint16_t* list, size_t len, uint32_t v) {
+  for (size_t i = 0; i < len; i++) {
+    if (list[i] == v) {
+      return true;
+    }
+  }
+  return false;
+}
+
+template <size_t N>
+static bool InList(const uint16_t (&list)[N], uint32_t v) {
+  return InU16List(list, N, v);
+}
+
+// Returns nullptr if the 970 implements |inst|, else a short description.
+static const char* POWER4FenceCheck(uint32_t inst) {
+  const uint32_t op = inst >> 26;
+  const uint32_t xo10 = (inst >> 1) & 0x3ff;
+  const uint32_t xo5 = (inst >> 1) & 0x1f;
+
+  if (op >= 32 && op <= 55) {
+    return nullptr;  // D-form integer/FP loads and stores
+  }
+
+  switch (op) {
+    case 2:   // tdi
+    case 3:   // twi
+    case 7:   // mulli
+    case 8:   // subfic
+    case 10:  // cmpli
+    case 11:  // cmpi
+    case 12:  // addic
+    case 13:  // addic.
+    case 14:  // addi
+    case 15:  // addis
+    case 16:  // bc
+    case 18:  // b
+    case 20:  // rlwimi
+    case 21:  // rlwinm
+    case 23:  // rlwnm
+    case 24:  // ori
+    case 25:  // oris
+    case 26:  // xori
+    case 27:  // xoris
+    case 28:  // andi.
+    case 29:  // andis.
+      return nullptr;
+    case 17:
+      return "sc";
+    case 1:
+      return "prefixed instruction (ISA 3.1)";
+    case 4: {
+      // VMX. VA-form ops have a 6-bit XO >= 32; every VMX 1.0 VX/VC-form XO
+      // has its low 6 bits below 32.
+      const uint32_t xo6 = inst & 0x3f;
+      if (xo6 >= 32) {
+        static const uint16_t va[] = {32, 33, 34, 36, 37, 38, 39,
+                                      40, 41, 42, 43, 44, 46, 47};
+        return InList(va, xo6) ? nullptr : "VMX VA-form op newer than VMX 1.0";
+      }
+      if (xo6 == 6) {
+        // VC-form compares; bit 0x400 is Rc.
+        static const uint16_t vc[] = {6,   70,  134, 198, 454, 518, 582,
+                                      646, 710, 774, 838, 902, 966};
+        return InList(vc, inst & 0x3ff) ? nullptr
+                                        : "VMX compare newer than VMX 1.0";
+      }
+      static const uint16_t vx[] = {
+          0,    64,   128,  384,  512,  576,  640,  768,  832,  896,  1024,
+          1088, 1152, 1408, 1536, 1600, 1664, 1792, 1856, 1920, 2,    66,
+          130,  258,  322,  386,  514,  578,  642,  770,  834,  898,  1026,
+          1090, 1154, 1282, 1346, 1410, 4,    68,   132,  260,  324,  388,
+          452,  516,  580,  644,  708,  772,  836,  900,  1028, 1092, 1156,
+          1220, 1284, 1540, 1604, 8,    72,   264,  328,  520,  584,  776,
+          840,  1544, 1800, 1608, 1672, 1928, 10,   74,   266,  330,  394,
+          458,  522,  586,  650,  714,  778,  842,  906,  970,  1034, 1098,
+          12,   76,   140,  268,  332,  396,  524,  588,  652,  780,  844,
+          908,  1036, 1100, 14,   78,   142,  206,  270,  334,  398,  462,
+          526,  590,  654,  718,  782,  846,  974};
+      return InList(vx, inst & 0x7ff) ? nullptr : "VMX op newer than VMX 1.0";
+    }
+    case 19: {
+      if (xo5 == 2) {
+        return "addpcis (ISA 3.0)";
+      }
+      static const uint16_t xl[] = {0,   16,  18,  33,  129, 150, 193,
+                                    225, 257, 289, 417, 449, 528};
+      return InList(xl, xo10) ? nullptr : "op 19 form not in ISA 2.01";
+    }
+    case 30: {
+      const uint32_t md = (inst >> 2) & 7;
+      if (md <= 3) {
+        return nullptr;  // rldicl, rldicr, rldic, rldimi
+      }
+      const uint32_t mds = (inst >> 1) & 0xf;
+      if (mds == 8 || mds == 9) {
+        return nullptr;  // rldcl, rldcr
+      }
+      return "op 30 form not in ISA 2.01";
+    }
+    case 31: {
+      if (xo5 == 15) {
+        return "isel (ISA 2.06 server)";
+      }
+      if (xo10 == 19) {
+        return ((inst >> 20) & 1) ? "mfocrf (avoided on the 970 tier)"
+                                  : nullptr;  // mfcr
+      }
+      if (xo10 == 144) {
+        return ((inst >> 20) & 1) ? "mtocrf (avoided on the 970 tier)"
+                                  : nullptr;  // mtcrf
+      }
+      if (xo10 == 598) {
+        uint32_t l = (inst >> 21) & 3;
+        return l <= 1 ? nullptr : "ptesync/sync L>1";
+      }
+      static const uint16_t x[] = {
+          0, 4, 6, 7, 20, 21, 23, 24, 26, 27, 28, 32, 38, 39, 53, 54, 55, 58,
+          60, 68, 71, 83, 84, 86, 87, 103, 119, 124, 135, 149, 150, 151, 167,
+          181, 183, 199, 214, 215, 231, 246, 247, 278, 279, 284, 311, 316, 339,
+          341, 342, 343, 359, 371, 373, 374, 375, 407, 412, 439, 444, 467, 476,
+          487, 512, 533, 534, 535, 536, 539, 567, 597, 599, 631, 661, 662, 663,
+          695, 725, 727, 759, 790, 792, 794, 822, 824, 826, 827, 854, 918, 922,
+          954, 982, 983, 986, 1014,
+          // XO-form arithmetic (OE=0); the mulh* forms have no OE variant.
+          8, 9, 10, 11, 40, 73, 75, 104, 136, 138, 200, 202, 232, 233, 234, 235,
+          266, 457, 459, 489, 491};
+      if (InList(x, xo10)) {
+        return nullptr;
+      }
+      static const uint16_t xoOE[] = {8,   10,  40,  104, 136, 138,
+                                      200, 202, 232, 233, 234, 235,
+                                      266, 457, 459, 489, 491};
+      if ((xo10 & 0x200) && InList(xoOE, xo10 & 0x1ff)) {
+        return nullptr;
+      }
+      switch (xo10) {
+        case 122:
+          return "popcntb (ISA 2.02)";
+        case 378:
+          return "popcntw (ISA 2.06)";
+        case 506:
+          return "popcntd (ISA 2.06)";
+        case 538:
+          return "cnttzw (ISA 3.0)";
+        case 570:
+          return "cnttzd (ISA 3.0)";
+        case 508:
+          return "cmpb (ISA 2.05)";
+        case 52:
+          return "lbarx (ISA 2.06)";
+        case 116:
+          return "lharx (ISA 2.06)";
+        case 694:
+          return "stbcx. (ISA 2.06)";
+        case 726:
+          return "sthcx. (ISA 2.06)";
+        case 532:
+          return "ldbrx (ISA 2.06)";
+        case 660:
+          return "stdbrx (ISA 2.06)";
+        case 855:
+          return "lfiwax (ISA 2.05)";
+        case 887:
+          return "lfiwzx (ISA 2.06)";
+        case 265:
+        case 267:
+        case 777:
+        case 779:
+          return "mod* (ISA 3.0)";
+        case 51:
+        case 115:
+        case 179:
+        case 211:
+        case 243:
+        case 307:
+        case 403:
+        case 435:
+          return "mfvsr*/mtvsr* (VSX)";
+        case 252:
+          return "bpermd (ISA 2.06)";
+        case 128:
+          return "setb (ISA 3.0)";
+        case 576:
+          return "mcrxrx (ISA 3.0)";
+        default:
+          return "op 31 form not in ISA 2.01 or VMX 1.0";
+      }
+    }
+    case 58:
+      return (inst & 3) <= 2 ? nullptr : "op 58 form not in ISA 2.01";
+    case 62:
+      return (inst & 3) <= 1 ? nullptr : "stq";
+    case 59: {
+      if (xo5 >= 16) {
+        static const uint16_t a[] = {18, 20, 21, 22, 24, 25, 28, 29, 30, 31};
+        return InList(a, xo5) ? nullptr : "single A-form not in ISA 2.01";
+      }
+      return xo10 == 846 ? "fcfids (ISA 2.06)"
+                         : (xo10 == 974 ? "fcfidus (ISA 2.06)"
+                                        : "single X-form not in ISA 2.01");
+    }
+    case 63: {
+      if (xo5 >= 16) {
+        static const uint16_t a[] = {18, 20, 21, 22, 23, 25,
+                                     26, 28, 29, 30, 31};
+        return InList(a, xo5) ? nullptr : "fre or A-form not in ISA 2.01";
+      }
+      if (xo10 == 583) {
+        // Plain mffs has zero bits 11-20; ISA 3.0 put mffsce/mffsl/... there.
+        return ((inst >> 11) & 0x3ff) == 0 ? nullptr : "mffs variant (ISA 3.0)";
+      }
+      if (xo10 == 711 || xo10 == 134) {
+        // mtfsf / mtfsfi without the ISA 2.05 L/W extensions.
+        return ((inst >> 16) & 1) == 0 &&
+                       (xo10 == 134 || ((inst >> 25) & 1) == 0)
+                   ? nullptr
+                   : "mtfsf/mtfsfi L or W form (ISA 2.05)";
+      }
+      static const uint16_t x[] = {0,  12, 14,  15,  32,  38,  40, 64,
+                                   70, 72, 136, 264, 814, 815, 846};
+      if (InList(x, xo10)) {
+        return nullptr;
+      }
+      switch (xo10) {
+        case 8:
+          return "fcpsgn (ISA 2.05)";
+        case 392:
+          return "frin (ISA 2.02)";
+        case 424:
+          return "friz (ISA 2.02)";
+        case 456:
+          return "frip (ISA 2.02)";
+        case 488:
+          return "frim (ISA 2.02)";
+        case 974:
+          return "fcfidu (ISA 2.06)";
+        case 942:
+        case 943:
+          return "fctidu[z] (ISA 2.06)";
+        case 142:
+        case 143:
+          return "fctiwu[z] (ISA 2.06)";
+        default:
+          return "FP X-form not in ISA 2.01";
+      }
+    }
+    case 60:
+      return "VSX";
+    case 61:
+      return "lxv/stxv (ISA 3.0)";
+    case 56:
+      return "lq";
+    case 57:
+      return "lfdp/lxsd (ISA 2.05+)";
+    default:
+      return "primary opcode not in ISA 2.01";
+  }
+}
+
+// The fence is on whenever the POWER4 tier is (MOZ_PPC64_FORCE_POWER4=1).
+// MOZ_PPC64_SIM_POWER4_FENCE=1 turns it on for the POWER8+ code paths too,
+// as a negative control showing that the fence catches newer instructions.
+static bool POWER4FenceActive() {
+  static const bool forced = [] {
+    const char* env = getenv("MOZ_PPC64_SIM_POWER4_FENCE");
+    return env && env[0] == '1';
+  }();
+  return forced || !HasISA207();
+}
+
 void Simulator::instructionDecode(SimInstruction* instr) {
   if (!SimulatorProcess::ICacheCheckingDisableCount) {
     AutoLockSimulatorCache als;
@@ -6984,6 +7266,21 @@ void Simulator::instructionDecode(SimInstruction* instr) {
     return;
   }
 
+  if (MOZ_UNLIKELY(POWER4FenceActive())) {
+    if (const char* what = POWER4FenceCheck(instrBits)) {
+      // Release builds do not print MOZ_CRASH messages; say it on stderr.
+      fprintf(stderr,
+              "POWER4 tier fence: %s: instruction 0x%08x (opcode %u) at %p "
+              "is not implemented by the PowerPC 970\n",
+              what, instrBits, instrBits >> 26, (void*)instr);
+      fflush(stderr);
+      MOZ_CRASH_UNSAFE_PRINTF(
+          "POWER4 tier fence: %s: instruction 0x%08x (opcode %u) at %p is "
+          "not implemented by the PowerPC 970",
+          what, instrBits, instrBits >> 26, (void*)instr);
+    }
+  }
+
   uint32_t opcode = instr->opcode();
 
   // Power ISA v3.1 prefixed instructions: primary opcode 1 marks a
-- 
2.55.0


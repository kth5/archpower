diff --git a/security/sandbox/chromium/sandbox/linux/bpf_dsl/seccomp_macros.h b/security/sandbox/chromium/sandbox/linux/bpf_dsl/seccomp_macros.h
index 87d5825aa3..394e16c448 100644
--- a/security/sandbox/chromium/sandbox/linux/bpf_dsl/seccomp_macros.h
+++ b/security/sandbox/chromium/sandbox/linux/bpf_dsl/seccomp_macros.h
@@ -343,6 +343,95 @@ struct regs_struct {
 #define SECCOMP_PT_PARM4(_regs) (_regs).regs[3]
 #define SECCOMP_PT_PARM5(_regs) (_regs).regs[4]
 #define SECCOMP_PT_PARM6(_regs) (_regs).regs[5]
+
+#elif defined(__powerpc64__)
+// The kernel's struct pt_regs. glibc's gregset_t has the same layout, which
+// is how a ucontext_t exposes it; <asm/ptrace.h> names the slots after the
+// GPRs (PT_NIP, PT_CCR, ...).
+struct regs_struct {
+  unsigned long gpr[32];
+  unsigned long nip;
+  unsigned long msr;
+  unsigned long orig_gpr3;
+  unsigned long ctr;
+  unsigned long link;
+  unsigned long xer;
+  unsigned long ccr;
+  unsigned long softe;
+  unsigned long trap;
+  unsigned long dar;
+  unsigned long dsisr;
+  unsigned long result;
+};
+
+#if defined(ARCH_CPU_LITTLE_ENDIAN)
+#define SECCOMP_ARCH AUDIT_ARCH_PPC64LE
+#else
+#define SECCOMP_ARCH AUDIT_ARCH_PPC64
+#endif
+
+#define SECCOMP_PPC64_PT_NIP 32
+#define SECCOMP_PPC64_PT_ORIG_R3 34
+#define SECCOMP_PPC64_PT_CCR 38
+#define SECCOMP_PPC64_PT_TRAP 40
+// CR0.SO, which "sc" sets to flag an error.
+#define SECCOMP_PPC64_CR0_SO 0x10000000UL
+// The trap slot's value when the syscall came from "scv".
+#define SECCOMP_PPC64_TRAP_SCV 0x3000UL
+#define SECCOMP_PPC64_TRAP_MASK 0x1fUL
+
+// glibc's ucontext for ppc64 has gregset_t but no greg_t.
+typedef unsigned long greg_t;
+
+#define SECCOMP_REG(_ctx, _reg) ((_ctx)->uc_mcontext.gp_regs[_reg])
+
+// The syscall number is in r0 and the arguments in r3-r8. While seccomp
+// runs the kernel has replaced r3 with -ENOSYS and keeps the first argument
+// in orig_gpr3 (see do_seccomp() in arch/powerpc/kernel/ptrace); the result
+// goes back in r3.
+#define SECCOMP_RESULT(_ctx) SECCOMP_REG(_ctx, 3)
+#define SECCOMP_SYSCALL(_ctx) SECCOMP_REG(_ctx, 0)
+#define SECCOMP_IP(_ctx) SECCOMP_REG(_ctx, SECCOMP_PPC64_PT_NIP)
+#define SECCOMP_CCR(_ctx) SECCOMP_REG(_ctx, SECCOMP_PPC64_PT_CCR)
+#define SECCOMP_TRAP(_ctx) SECCOMP_REG(_ctx, SECCOMP_PPC64_PT_TRAP)
+#define SECCOMP_PARM1(_ctx) SECCOMP_REG(_ctx, SECCOMP_PPC64_PT_ORIG_R3)
+#define SECCOMP_PARM2(_ctx) SECCOMP_REG(_ctx, 4)
+#define SECCOMP_PARM3(_ctx) SECCOMP_REG(_ctx, 5)
+#define SECCOMP_PARM4(_ctx) SECCOMP_REG(_ctx, 6)
+#define SECCOMP_PARM5(_ctx) SECCOMP_REG(_ctx, 7)
+#define SECCOMP_PARM6(_ctx) SECCOMP_REG(_ctx, 8)
+
+#define SECCOMP_NR_IDX (offsetof(struct arch_seccomp_data, nr))
+#define SECCOMP_ARCH_IDX (offsetof(struct arch_seccomp_data, arch))
+#if defined(ARCH_CPU_LITTLE_ENDIAN)
+#define SECCOMP_IP_MSB_IDX \
+  (offsetof(struct arch_seccomp_data, instruction_pointer) + 4)
+#define SECCOMP_IP_LSB_IDX \
+  (offsetof(struct arch_seccomp_data, instruction_pointer) + 0)
+#define SECCOMP_ARG_MSB_IDX(nr) \
+  (offsetof(struct arch_seccomp_data, args) + 8 * (nr) + 4)
+#define SECCOMP_ARG_LSB_IDX(nr) \
+  (offsetof(struct arch_seccomp_data, args) + 8 * (nr) + 0)
+#else
+#define SECCOMP_IP_MSB_IDX \
+  (offsetof(struct arch_seccomp_data, instruction_pointer) + 0)
+#define SECCOMP_IP_LSB_IDX \
+  (offsetof(struct arch_seccomp_data, instruction_pointer) + 4)
+#define SECCOMP_ARG_MSB_IDX(nr) \
+  (offsetof(struct arch_seccomp_data, args) + 8 * (nr) + 0)
+#define SECCOMP_ARG_LSB_IDX(nr) \
+  (offsetof(struct arch_seccomp_data, args) + 8 * (nr) + 4)
+#endif
+
+#define SECCOMP_PT_RESULT(_regs) (_regs).gpr[3]
+#define SECCOMP_PT_SYSCALL(_regs) (_regs).gpr[0]
+#define SECCOMP_PT_IP(_regs) (_regs).nip
+#define SECCOMP_PT_PARM1(_regs) (_regs).gpr[3]
+#define SECCOMP_PT_PARM2(_regs) (_regs).gpr[4]
+#define SECCOMP_PT_PARM3(_regs) (_regs).gpr[5]
+#define SECCOMP_PT_PARM4(_regs) (_regs).gpr[6]
+#define SECCOMP_PT_PARM5(_regs) (_regs).gpr[7]
+#define SECCOMP_PT_PARM6(_regs) (_regs).gpr[8]
 #else
 #error Unsupported target platform
 
diff --git a/security/sandbox/chromium/sandbox/linux/seccomp-bpf/syscall.cc b/security/sandbox/chromium/sandbox/linux/seccomp-bpf/syscall.cc
index b0cdc71b8f..9834018197 100644
--- a/security/sandbox/chromium/sandbox/linux/seccomp-bpf/syscall.cc
+++ b/security/sandbox/chromium/sandbox/linux/seccomp-bpf/syscall.cc
@@ -19,7 +19,7 @@ namespace sandbox {
 namespace {
 
 #if defined(ARCH_CPU_X86_FAMILY) || defined(ARCH_CPU_ARM_FAMILY) || \
-    defined(ARCH_CPU_MIPS_FAMILY)
+    defined(ARCH_CPU_MIPS_FAMILY) || defined(ARCH_CPU_PPC64_FAMILY)
 // Number that's not currently used by any Linux kernel ABIs.
 const int kInvalidSyscallNumber = 0x351d3;
 #else
@@ -309,6 +309,40 @@ asm(// We need to be able to tell the kernel exactly where we made a
     "2:ret\n"
     ".cfi_endproc\n"
     ".size SyscallAsm, .-SyscallAsm\n"
+#elif defined(__powerpc64__)
+    ".text\n"
+    ".align 2\n"
+    ".type SyscallAsm, @function\n"
+    "SyscallAsm:\n"
+    ".cfi_startproc\n"
+    // Not the ABI's calling convention: the number is in r3 and a pointer
+    // to the arguments in r4. A negative number asks for the address the
+    // kernel sees after "sc", for BPF code to inspect.
+    "cmpdi 3, 0\n"
+    "bge 1f\n"
+    "mflr 0\n"
+    "bl 3f\n"
+    "3:mflr 3\n"
+    "addi 3, 3, 2f-3b\n"
+    "mtlr 0\n"
+    "blr\n"
+    // The number goes in r0 and the arguments in r3-r8, all volatile.
+    "1:mr 0, 3\n"
+    "ld 3, 0(4)\n"
+    "ld 5, 16(4)\n"
+    "ld 6, 24(4)\n"
+    "ld 7, 32(4)\n"
+    "ld 8, 40(4)\n"
+    "ld 4, 8(4)\n"
+    // Enter the kernel
+    "sc\n"
+    // The kernel flags an error in CR0.SO with a positive errno in r3;
+    // callers expect -errno.
+    "2:bns+ 4f\n"
+    "neg 3, 3\n"
+    "4:blr\n"
+    ".cfi_endproc\n"
+    ".size SyscallAsm, .-SyscallAsm\n"
 #endif
     );  // asm
 
@@ -425,6 +459,19 @@ intptr_t Syscall::Call(int nr,
                  : "memory", "x1", "x2", "x3", "x4", "x5", "x8", "x30");
     ret = inout;
   }
+#elif defined(__powerpc64__)
+  intptr_t ret;
+  {
+    register intptr_t inout __asm__("r3") = nr;
+    register const intptr_t* data __asm__("r4") = args;
+    asm volatile("bl SyscallAsm\n"
+                 : "+r"(inout), "+r"(data)
+                 :
+                 : "memory", "lr", "ctr", "xer", "cr0", "cr1", "cr5", "cr6",
+                   "cr7", "r0", "r5", "r6", "r7", "r8", "r9", "r10", "r11",
+                   "r12");
+    ret = inout;
+  }
 
 #else
 #error "Unimplemented architecture"
@@ -444,6 +491,20 @@ void Syscall::PutValueInUcontext(intptr_t ret_val, ucontext_t* ctx) {
     SECCOMP_PARM4(ctx) = 1;
   } else
     SECCOMP_PARM4(ctx) = 0;
+#elif defined(__powerpc64__)
+  // A syscall made with "sc" reports an error through CR0.SO with a positive
+  // errno in r3; one made with "scv" returns -errno in r3 like the
+  // Syscall::Call() convention that |ret_val| follows. The trap slot says
+  // which instruction this syscall used.
+  if ((SECCOMP_TRAP(ctx) & ~SECCOMP_PPC64_TRAP_MASK) !=
+      SECCOMP_PPC64_TRAP_SCV) {
+    if (ret_val <= -1 && ret_val >= -4095) {
+      ret_val = -ret_val;
+      SECCOMP_CCR(ctx) |= SECCOMP_PPC64_CR0_SO;
+    } else {
+      SECCOMP_CCR(ctx) &= ~SECCOMP_PPC64_CR0_SO;
+    }
+  }
 #endif
   SECCOMP_RESULT(ctx) = static_cast<greg_t>(ret_val);
 }

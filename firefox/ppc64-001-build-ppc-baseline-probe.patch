From 3b57b18edbf5fa107d0540c57477ddf0c403c05a Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Trung=20L=C3=AA?= <8@tle.id.au>
Date: Tue, 6 Oct 2026 13:41:54 +1100
Subject: [PATCH 01/30] Probe the PowerPC target baseline for AltiVec, VSX and
 POWER8 crypto

Whether a PowerPC build may use AltiVec, VSX or the POWER8 crypto
instructions depends on the target baseline, and that is decided by the
build's own CFLAGS (e.g. -mcpu=970 for a PowerMac G5), not by the compiler's
default. Probe for __ALTIVEC__, __VSX__ and __CRYPTO__ with those flags and
export the answers as PPC_TARGET_HAS_ALTIVEC, PPC_TARGET_HAS_VSX and
PPC_TARGET_HAS_CRYPTO, so that code with PowerPC vector paths can be built
only where the target can run it.
---
 build/moz.configure/toolchain.configure | 47 +++++++++++++++++++++++++
 1 file changed, 47 insertions(+)

diff --git a/build/moz.configure/toolchain.configure b/build/moz.configure/toolchain.configure
index 7e1270fa43..4b3c072115 100644
--- a/build/moz.configure/toolchain.configure
+++ b/build/moz.configure/toolchain.configure
@@ -2485,6 +2485,53 @@ set_config(
     when=depends(target.cpu)(lambda cpu: cpu.startswith("ppc")),
 )
 
+# The flags above only say how to *ask* for these instruction sets. Whether the
+# build's own baseline already has them is a different question, and the answer
+# depends on the user's CFLAGS (e.g. -mcpu=970 for a PowerMac G5), so probe with
+# those flags rather than with the bare compiler default.
+
+
+@depends("CFLAGS")
+def ppc_baseline_probe_flags(cflags):
+    flags = []
+    for f in cflags or ():
+        flags.extend(f.split())
+    return flags
+
+
+ppc_target_has_altivec = c_compiler.try_compile(
+    body="""
+        #ifndef __ALTIVEC__
+        #error No AltiVec in the target baseline.
+        #endif""",
+    flags=ppc_baseline_probe_flags,
+    check_msg="whether the target baseline has AltiVec",
+    when=depends(target.cpu)(lambda cpu: cpu.startswith("ppc")),
+)
+set_config("PPC_TARGET_HAS_ALTIVEC", ppc_target_has_altivec)
+
+ppc_target_has_vsx = c_compiler.try_compile(
+    body="""
+        #ifndef __VSX__
+        #error No VSX in the target baseline.
+        #endif""",
+    flags=ppc_baseline_probe_flags,
+    check_msg="whether the target baseline has VSX",
+    when=depends(target.cpu)(lambda cpu: cpu.startswith("ppc")),
+)
+set_config("PPC_TARGET_HAS_VSX", ppc_target_has_vsx)
+
+ppc_target_has_crypto = c_compiler.try_compile(
+    body="""
+        #ifndef __CRYPTO__
+        #error No POWER8 crypto instructions in the target baseline.
+        #endif""",
+    flags=ppc_baseline_probe_flags,
+    check_msg="whether the target baseline has the POWER8 crypto instructions",
+    when=depends(target.cpu)(lambda cpu: cpu.startswith("ppc")),
+)
+set_config("PPC_TARGET_HAS_CRYPTO", ppc_target_has_crypto)
+
 # TARGET_XPCOM_ABI
 # ==============================================================
 

diff --git a/mozglue/misc/SIMD_vsx.cpp b/mozglue/misc/SIMD_vsx.cpp
new file mode 100644
index 0000000000..c8798c0ea9
--- /dev/null
+++ b/mozglue/misc/SIMD_vsx.cpp
@@ -0,0 +1,189 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// VSX (Power ISA 2.07) kernels for mozglue/misc/SIMD.cpp.
+//
+// This is the only translation unit of mozglue built with -mcpu=power8
+// -mvsx. SIMD.cpp calls into it only after checking AT_HWCAP/AT_HWCAP2 for
+// VSX and ISA 2.07, so the rest of the library stays runnable on CPUs
+// without VSX such as the PowerPC 970.
+//
+// Keep this file free of Mozilla and C++ standard library headers: any
+// inline function or template they instantiate here would be emitted as a
+// COMDAT/weak definition compiled for POWER8, and the linker is free to
+// pick that copy for every caller in the library. Everything below is
+// either static or one of the extern "C++" entry points declared in
+// SIMD.cpp.
+
+#if !defined(__powerpc64__) || !defined(__VSX__) || !defined(__POWER8_VECTOR__)
+#  error "SIMD_vsx.cpp must be compiled with -mcpu=power8 -mvsx"
+#endif
+
+#include <altivec.h>
+#include <stddef.h>
+#include <stdint.h>
+
+namespace mozilla {
+namespace {
+
+// Maps the size of the value types of the memchrX functions below to the
+// matching 16-byte vector type. All lanes are unsigned, which is
+// bit-preserving, so lane-wise equality is exact regardless of the scalar
+// type used at the callsite. The explicit lane type also matters for
+// vec_splats: char16_t would otherwise promote to int and pick the wrong
+// overload, and uint64_t (unsigned long) is ambiguous.
+template <size_t Size>
+struct VSXLaneFor;
+
+template <>
+struct VSXLaneFor<1> {
+  using vector_t = __vector unsigned char;
+  using scalar_t = unsigned char;
+};
+
+template <>
+struct VSXLaneFor<2> {
+  using vector_t = __vector unsigned short;
+  using scalar_t = unsigned short;
+};
+
+template <>
+struct VSXLaneFor<4> {
+  using vector_t = __vector unsigned int;
+  using scalar_t = unsigned int;
+};
+
+template <>
+struct VSXLaneFor<8> {
+  using vector_t = __vector unsigned long long;
+  using scalar_t = unsigned long long;
+};
+
+template <typename TValue>
+static inline typename VSXLaneFor<sizeof(TValue)>::vector_t LoadVSX(
+    uintptr_t addr) {
+  using Lane = typename VSXLaneFor<sizeof(TValue)>::scalar_t;
+  return vec_xl(0, reinterpret_cast<const Lane*>(addr));
+}
+
+template <typename TMask>
+static inline bool AnyLaneSetVSX(TMask mask) {
+  const __vector unsigned char zero = vec_splats(static_cast<unsigned char>(0));
+  return vec_any_ne(reinterpret_cast<__vector unsigned char>(mask), zero);
+}
+
+// PPC64 has no cheap movemask equivalent, so the hot loops only ask "did
+// anything in here match?" and the block that did is rescanned scalar. That
+// also keeps the code endianness-neutral.
+template <typename TValue>
+static const TValue* FindInBufferVSX(const TValue* ptr, TValue value, size_t length) {
+  using V = typename VSXLaneFor<sizeof(TValue)>::vector_t;
+  using Lane = typename VSXLaneFor<sizeof(TValue)>::scalar_t;
+
+  const V needle = vec_splats(static_cast<Lane>(value));
+
+  uintptr_t cur = reinterpret_cast<uintptr_t>(ptr);
+  const uintptr_t end = cur + length * sizeof(TValue);
+
+  // Skip four blocks at a time while none of them match.
+  while (end - cur >= 4 * sizeof(V)) {
+    const V a = LoadVSX<TValue>(cur);
+    const V b = LoadVSX<TValue>(cur + sizeof(V));
+    const V c = LoadVSX<TValue>(cur + 2 * sizeof(V));
+    const V d = LoadVSX<TValue>(cur + 3 * sizeof(V));
+    if (AnyLaneSetVSX(vec_or(
+            vec_or(vec_cmpeq(a, needle), vec_cmpeq(b, needle)),
+            vec_or(vec_cmpeq(c, needle), vec_cmpeq(d, needle))))) {
+      break;
+    }
+    cur += 4 * sizeof(V);
+  }
+
+  while (end - cur >= sizeof(V)) {
+    if (vec_any_eq(LoadVSX<TValue>(cur), needle)) {
+      break;
+    }
+    cur += sizeof(V);
+  }
+
+  // Either the block at cur matched, or less than a block is left.
+  const TValue* p = reinterpret_cast<const TValue*>(cur);
+  const TValue* bufferEnd = reinterpret_cast<const TValue*>(end);
+  while (p < bufferEnd) {
+    if (*p == value) {
+      return p;
+    }
+    p++;
+  }
+  return nullptr;
+}
+
+// Searches for v1 immediately followed by v2. Each iteration loads the block
+// at cur and the block one element further on, so every pair starting in the
+// block is checked with two compares and no state is carried across blocks.
+template <typename TValue>
+static const TValue* FindTwoInBufferVSX(const TValue* ptr, TValue v1, TValue v2,
+                                 size_t length) {
+  using V = typename VSXLaneFor<sizeof(TValue)>::vector_t;
+  using Lane = typename VSXLaneFor<sizeof(TValue)>::scalar_t;
+
+  const V needle1 = vec_splats(static_cast<Lane>(v1));
+  const V needle2 = vec_splats(static_cast<Lane>(v2));
+
+  uintptr_t cur = reinterpret_cast<uintptr_t>(ptr);
+  const uintptr_t end = cur + length * sizeof(TValue);
+
+  while (end - cur >= sizeof(V) + sizeof(TValue)) {
+    const V first = LoadVSX<TValue>(cur);
+    const V second = LoadVSX<TValue>(cur + sizeof(TValue));
+    if (AnyLaneSetVSX(
+            vec_and(vec_cmpeq(first, needle1), vec_cmpeq(second, needle2)))) {
+      break;
+    }
+    cur += sizeof(V);
+  }
+
+  // Either a pair starts in the block at cur, or at most a block is left.
+  const TValue* p = reinterpret_cast<const TValue*>(cur);
+  const TValue* bufferEnd = reinterpret_cast<const TValue*>(end);
+  while (p + 1 < bufferEnd) {
+    if (p[0] == v1 && p[1] == v2) {
+      return p;
+    }
+    p++;
+  }
+  return nullptr;
+}
+
+}  // namespace
+
+namespace detail {
+
+const char16_t* memchr16VSX(const char16_t* ptr, char16_t value,
+                            size_t length) {
+  return FindInBufferVSX(ptr, value, length);
+}
+
+const uint32_t* memchr32VSX(const uint32_t* ptr, uint32_t value,
+                            size_t length) {
+  return FindInBufferVSX(ptr, value, length);
+}
+
+const uint64_t* memchr64VSX(const uint64_t* ptr, uint64_t value,
+                            size_t length) {
+  return FindInBufferVSX(ptr, value, length);
+}
+
+const unsigned char* memchr2x8VSX(const unsigned char* ptr, unsigned char v1,
+                                  unsigned char v2, size_t length) {
+  return FindTwoInBufferVSX(ptr, v1, v2, length);
+}
+
+const char16_t* memchr2x16VSX(const char16_t* ptr, char16_t v1, char16_t v2,
+                              size_t length) {
+  return FindTwoInBufferVSX(ptr, v1, v2, length);
+}
+
+}  // namespace detail
+}  // namespace mozilla

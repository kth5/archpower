+macro_rules! fn_vsx {
+    {} => {};
+    {$(
+        fn $name:ident $(<$(const $gen:ident: $gen_ty:ty),*>)?
+        ($this:ident: $self_ty:ty $(, $arg:ident: $ty:ty)* $(,)?) $(-> $ret:ty )?
+        $body: block

+/// Multiplies signed 32-bit lanes and keeps the high half of each 64-bit product.
+///
+/// # Safety
+/// VSX and the POWER8 vector extensions must be available.
+#[inline(always)]
+unsafe fn mul_high_i32(a: vector_signed_int, b: vector_signed_int) -> vector_signed_int {
+    // SAFETY: the caller guarantees the target features.
+    unsafe {
+        let (even, odd) = if BIG_ENDIAN {
+            (vmulesw(a, b), vmulosw(a, b))
+        } else {
+            (vmulosw(a, b), vmulesw(a, b))
+        };
+        shuffle(even, odd, const { mul_high_idx(4) })
+    }
+}
+
+/// Multiplies signed 16-bit lanes and keeps the high half of each 32-bit product.
+///
+/// # Safety
+/// VSX and the POWER8 vector extensions must be available.
+#[inline(always)]
+unsafe fn mul_high_i16(a: vector_signed_short, b: vector_signed_short) -> vector_signed_short {
+    // SAFETY: the caller guarantees the target features.
+    unsafe {
+        let (even, odd) = if BIG_ENDIAN {
+            (vmulesh(a, b), vmulosh(a, b))
+        } else {
+            (vmulosh(a, b), vmulesh(a, b))
+        };
+        shuffle(even, odd, const { mul_high_idx(2) })
+    }
+}

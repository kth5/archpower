+// Copyright (c) the JPEG XL Project Authors. All rights reserved.
+//
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+#![allow(unsafe_code)]
+#![allow(clippy::identity_op)]
+
+// The backend requires VSX and the POWER8 vector extensions at compile time: they are the
+// powerpc64le baseline, and on big-endian they can be enabled with e.g. `-C target-cpu=pwr8`.
+// LLVM does not inline the AltiVec intrinsics into functions that only enable VSX through
+// `#[target_feature]`, so detecting POWER8 at runtime would leave every vector operation as a
+// function call. POWER9 is detected at runtime on little-endian (see `Power9::is_available`).
+#[cfg(all(
+    feature = "vsx",
+    target_feature = "vsx",
+    target_feature = "power8-vector"
+))]
+pub(super) mod vsx;
+
+#[macro_export]
+macro_rules! simd_function {
+    (
+        $dname:ident,
+        $descr:ident: $descr_ty:ident,
+        $(#[$($attr:meta)*])*
+        $pub:vis fn $name:ident($($arg:ident: $ty:ty),* $(,)?) $(-> $ret:ty )? $body: block
+    ) => {
+        #[inline(always)]
+        $(#[$($attr)*])*
+        $pub fn $name<$descr_ty: $crate::SimdDescriptor>($descr: $descr_ty, $($arg: $ty),*) $(-> $ret)? $body
+        $(#[$($attr)*])*
+        $pub fn $dname($($arg: $ty),*) $(-> $ret)? {
+            #[allow(unused)]
+            use $crate::SimdDescriptor;
+            $crate::simd_function_body_vsx!($name($($arg: $ty),*) $(-> $ret)?; ($($arg),*));
+            $name($crate::ScalarDescriptor::new().unwrap(), $($arg),*)
+        }
+    };
+}
+
+#[cfg(all(
+    feature = "vsx",
+    target_feature = "vsx",
+    target_feature = "power8-vector"
+))]
+#[doc(hidden)]
+#[macro_export]
+macro_rules! simd_function_body_vsx {
+    ($name:ident($($arg:ident: $ty:ty),* $(,)?) $(-> $ret:ty )?; ($($val:expr),* $(,)?)) => {
+        if let Some(d) = $crate::VsxDescriptor::<$crate::Power9>::new() {
+            return d.call(
+                #[inline(always)]
+                |d| $name(d, $($val),*),
+            );
+        }
+        if let Some(d) = $crate::VsxDescriptor::<$crate::Power8>::new() {
+            return $name(d, $($val),*);
+        }
+    };
+}
+
+#[cfg(not(all(
+    feature = "vsx",
+    target_feature = "vsx",
+    target_feature = "power8-vector"
+)))]
+#[doc(hidden)]
+#[macro_export]
+macro_rules! simd_function_body_vsx {
+    ($($ignore:tt)*) => {};
+}
+
+#[macro_export]
+macro_rules! test_all_instruction_sets {
+    (
+        $name:ident
+    ) => {
+        paste::paste! {
+            #[test]
+            fn [<$name _scalar>]() {
+                use $crate::SimdDescriptor;
+                $name($crate::ScalarDescriptor::new().unwrap())
+            }
+        }
+
+        $crate::test_vsx!($name);
+    };
+}
+
+#[cfg(all(
+    feature = "vsx",
+    target_feature = "vsx",
+    target_feature = "power8-vector"
+))]
+#[doc(hidden)]
+#[macro_export]
+macro_rules! test_vsx {
+    ($name:ident) => {
+        paste::paste! {
+            #[test]
+            fn [<$name _power8>]() {
+                use $crate::SimdDescriptor;
+                let Some(d) = $crate::VsxDescriptor::<$crate::Power8>::new() else { return; };
+                d.call($name)
+            }
+
+            #[test]
+            fn [<$name _power9>]() {
+                use $crate::SimdDescriptor;
+                let Some(d) = $crate::VsxDescriptor::<$crate::Power9>::new() else { return; };
+                d.call($name)
+            }
+        }
+    };
+}
+
+#[cfg(not(all(
+    feature = "vsx",
+    target_feature = "vsx",
+    target_feature = "power8-vector"
+)))]
+#[doc(hidden)]
+#[macro_export]
+macro_rules! test_vsx {
+    ($name:ident) => {};
+}
+
+#[macro_export]
+macro_rules! bench_all_instruction_sets {
+    (
+        $name:ident,
+        $criterion:ident
+    ) => {
+        use $crate::SimdDescriptor;
+        // `simd_function_body_*` does early return; wrap it with an immediately-invoked closure
+        (|| {
+            $crate::simd_function_body_vsx!(
+                $name($criterion: &mut ::criterion::BenchmarkGroup<'_, impl ::criterion::measurement::Measurement>);
+                ($criterion, "vsx")
+            );
+        })();
+        $name(
+            $crate::ScalarDescriptor::new().unwrap(),
+            $criterion,
+            "scalar",
+        );
+    };
+}
diff --git a/third_party/rust/jxl_simd/src/powerpc64/vsx.rs b/third_party/rust/jxl_simd/src/powerpc64/vsx.rs
new file mode 100644
index 0000000000..8e17bd3758
--- /dev/null
+++ b/third_party/rust/jxl_simd/src/powerpc64/vsx.rs
@@ -0,0 +1,1886 @@
+// Copyright (c) the JPEG XL Project Authors. All rights reserved.
+//
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//! VSX backend for POWER8 and newer, modelled on Highway's `ppc_vsx-inl.h`.
+//!
+//! This module is only compiled when VSX and the POWER8 vector extensions are enabled at compile
+//! time (see `mod.rs`). Every vector type here holds a [`VsxDescriptor`], which is only
+//! constructed when the features of its [`VsxLevel`] are available. That is the safety argument
+//! for the intrinsic calls in the methods of these types. The free helper functions that use
+//! intrinsics are `unsafe` and require VSX to be available.
+//!
+//! The vector types are generic over a [`VsxLevel`]. All levels share the same implementation,
+//! but [`SimdDescriptor::call`] on a higher level enables that level's target features, so the
+//! code inlined into it is compiled for the newer ISA, and a few operations use instructions
+//! that are only available there.
+//!
+//! Lanes are numbered in memory order on both little- and big-endian targets. The stdarch
+//! intrinsics used here are lane-order agnostic or already adjusted for the target endianness;
+//! shuffles go through [`shuffle`], which takes byte indices in memory order. Shuffles that move
+//! parts of lanes build their indices with [`lane_byte`].
+
+// `fn_vsx!` wraps the method bodies it is given in an `unsafe` block, see the module docs.
+#![allow(clippy::macro_metavars_in_unsafe)]
+
+use std::arch::asm;
+use std::arch::powerpc64::*;
+use std::fmt::Debug;
+use std::marker::PhantomData;
+use std::mem::transmute;
+use std::ops::{
+    Add, AddAssign, BitAnd, BitAndAssign, BitOr, BitOrAssign, BitXor, BitXorAssign, Div, DivAssign,
+    Mul, MulAssign, Neg, Sub, SubAssign,
+};
+
+use super::super::{
+    F32SimdVec, I16SimdVec, I32SimdVec, SimdDescriptor, SimdMask, SimdMask16, U8SimdVec, U16SimdVec,
+};
+use crate::{U32SimdVec, U64SimdVec, impl_i16_array_interface};
+
+mod private {
+    pub trait Sealed {}
+}
+
+/// A POWER ISA level supported by the VSX backend.
+pub trait VsxLevel: private::Sealed + Copy + Debug + Send + Sync + 'static {
+    /// Whether the POWER9 (ISA 3.0) vector instructions are available.
+    const POWER9: bool;
+
+    /// Whether the level is supported by the current CPU.
+    fn is_available() -> bool;
+
+    /// Calls `f` in a context where the target features of this level are enabled.
+    ///
+    /// # Safety
+    /// The level must be available (see [`VsxLevel::is_available`]).
+    unsafe fn call<D, R>(d: D, f: impl FnOnce(D) -> R) -> R;
+}
+
+/// POWER8 (ISA 2.07), the powerpc64le baseline. It must be enabled at compile time.
+#[derive(Clone, Copy, Debug)]
+pub struct Power8;
+
+impl private::Sealed for Power8 {}
+
+impl VsxLevel for Power8 {
+    const POWER9: bool = false;
+
+    fn is_available() -> bool {
+        // The module is only compiled when the POWER8 features are part of the compilation target.
+        true
+    }
+
+    unsafe fn call<D, R>(d: D, f: impl FnOnce(D) -> R) -> R {
+        f(d)
+    }
+}
+
+/// POWER9 (ISA 3.0).
+#[derive(Clone, Copy, Debug)]
+pub struct Power9;
+
+impl private::Sealed for Power9 {}
+
+impl VsxLevel for Power9 {
+    const POWER9: bool = true;
+
+    fn is_available() -> bool {
+        if cfg!(target_feature = "power9-vector") {
+            return true;
+        }
+        // On big-endian, LLVM does not inline the AltiVec intrinsics into functions that enable
+        // more target features than the rest of the crate, so POWER9 must be enabled at compile
+        // time there (e.g. with `-C target-cpu=pwr9`).
+        cfg!(target_endian = "little") && std::arch::is_powerpc64_feature_detected!("power9-vector")
+    }
+
+    unsafe fn call<D, R>(d: D, f: impl FnOnce(D) -> R) -> R {
+        #[target_feature(enable = "power9-altivec,power9-vector")]
+        #[inline(never)]
+        unsafe fn inner<D, R>(d: D, f: impl FnOnce(D) -> R) -> R {
+            f(d)
+        }
+        // SAFETY: the caller guarantees that POWER9 is available.
+        unsafe { inner(d, f) }
+    }
+}

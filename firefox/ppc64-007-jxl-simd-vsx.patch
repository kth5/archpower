+impl<L: VsxLevel> SimdMask for MaskVsx<L> {
+    type Descriptor = VsxDescriptor<L>;
+
+    fn_vsx! {
+        fn if_then_else_f32(this: MaskVsx<L>, if_true: F32VecVsx<L>, if_false: F32VecVsx<L>) -> F32VecVsx<L> {
+            F32VecVsx(vec_sel(if_false.0, if_true.0, this.0), this.1)
+        }
+
+        fn if_then_else_i32(this: MaskVsx<L>, if_true: I32VecVsx<L>, if_false: I32VecVsx<L>) -> I32VecVsx<L> {

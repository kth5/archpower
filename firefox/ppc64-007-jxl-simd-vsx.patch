+impl_bytes!(
+    vector_float,
+    vector_signed_int,
+    vector_unsigned_int,
+    vector_bool_int,
+    vector_signed_short,
+    vector_unsigned_short,
+    vector_bool_short,
+    vector_signed_char,
+    vector_unsigned_long

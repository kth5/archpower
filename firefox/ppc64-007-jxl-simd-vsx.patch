+        // SAFETY: VSX is available by the safety invariant on the descriptor.
+        let (o0, o1) = unsafe { interleave2::<4, _>(a.0, b.0) };
+        Self(o0, a.1).store(&mut dest[..8]);
+        Self(o1, a.1).store(&mut dest[4..8]);

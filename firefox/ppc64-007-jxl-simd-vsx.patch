+/// Reinterprets a 128-bit vector as bytes and back.
+trait Bytes: Copy {
+    fn to_bytes(self) -> vector_unsigned_char;
+    fn from_bytes(v: vector_unsigned_char) -> Self;
+}
+
+macro_rules! impl_bytes {
+    ($($t:ty),*) => {$(
+        impl Bytes for $t {
+            #[inline(always)]
+            fn to_bytes(self) -> vector_unsigned_char {
+                // SAFETY: all 128-bit vector types are plain bags of bits of the same size.
+                unsafe { transmute::<$t, vector_unsigned_char>(self) }
+            }
+            #[inline(always)]
+            fn from_bytes(v: vector_unsigned_char) -> Self {
+                // SAFETY: all 128-bit vector types are plain bags of bits of the same size.
+                unsafe { transmute::<vector_unsigned_char, $t>(v) }
+            }
+        }
+    )*};
+}
+
+impl Bytes for vector_unsigned_char {
+    #[inline(always)]
+    fn to_bytes(self) -> vector_unsigned_char {
+        self
+    }
+    #[inline(always)]
+    fn from_bytes(v: vector_unsigned_char) -> Self {
+        v
+    }
+}

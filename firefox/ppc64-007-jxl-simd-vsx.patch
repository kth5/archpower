+const BIG_ENDIAN: bool = cfg!(target_endian = "big");
+
+/// Memory position of byte `byte` (0 is the least significant) of lane `lane` of a vector with
+/// `es`-byte lanes.
+const fn lane_byte(es: usize, lane: usize, byte: usize) -> u8 {
+    (lane * es + if BIG_ENDIAN { es - 1 - byte } else { byte }) as u8
+}
+
+/// Indices widening the four 16-bit lanes of `a` to 32-bit lanes, placing each at bit `shift`
+/// (0 or 16). The remaining bytes select byte 16 of `a || b`.
+const fn widen16_idx(shift: usize) -> [u8; 16] {
+    let mut res = [16u8; 16];
+    let mut lane = 0;
+    while lane < 4 {
+        res[lane_byte(4, lane, shift / 8) as usize] = lane_byte(2, lane, 0);
+        res[lane_byte(4, lane, shift / 8 + 1) as usize] = lane_byte(2, lane, 1);
+        lane += 1;
+    }
+    res
+}
+
+/// Indices narrowing 32-bit lanes of `a || b` to 16 bits, keeping the half at bit `shift`
+/// (0 or 16).
+const fn narrow32_idx(shift: usize) -> [u8; 16] {
+    let mut res = [0u8; 16];
+    let mut lane = 0;
+    while lane < 8 {
+        res[lane_byte(2, lane, 0) as usize] = lane_byte(4, lane, shift / 8);
+        res[lane_byte(2, lane, 1) as usize] = lane_byte(4, lane, shift / 8 + 1);
+        lane += 1;
+    }
+    res
+}
+
+/// Indices splitting each 64-bit lane into its low and high 32-bit halves, in this order.
+const fn split64_idx() -> [u8; 16] {
+    let mut res = [0u8; 16];
+    let mut lane = 0;
+    while lane < 4 {
+        let mut byte = 0;
+        while byte < 4 {
+            res[lane_byte(4, lane, byte) as usize] = lane_byte(8, lane / 2, 4 * (lane % 2) + byte);
+            byte += 1;
+        }
+        lane += 1;
+    }
+    res
+}
+
+/// Converts element indices into the concatenation of two vectors into byte indices.
+const fn elems_to_bytes(es: usize, elems: [u8; 16]) -> [u8; 16] {
+    let mut res = [0u8; 16];
+    let mut i = 0;
+    while i < 16 {
+        res[i] = elems[i / es] * es as u8 + (i % es) as u8;
+        i += 1;
+    }
+    res
+}
+
+/// Indices for half `half` of the interleaving of two vectors with `es`-byte elements.
+const fn interleave2_idx(es: usize, half: usize) -> [u8; 16] {
+    let n = 16 / es;
+    let mut elems = [0u8; 16];
+    let mut p = 0;
+    while p < n {
+        let g = half * n + p;
+        elems[p] = ((g % 2) * n + g / 2) as u8;
+        p += 1;
+    }
+    elems_to_bytes(es, elems)
+}
+
+/// Indices extracting component `comp` from two vectors of 2-way interleaved elements.
+const fn deinterleave2_idx(es: usize, comp: usize) -> [u8; 16] {
+    let n = 16 / es;
+    let mut elems = [0u8; 16];
+    let mut i = 0;
+    while i < n {
+        elems[i] = (2 * i + comp) as u8;
+        i += 1;
+    }
+    elems_to_bytes(es, elems)
+}
+
+/// Indices producing output vector `v` of the 3-way interleaving of `a`, `b` and `c`: the first
+/// shuffle picks the `a` and `b` elements from `a || b`, the second inserts the `c` elements.
+const fn interleave3_idx(es: usize, v: usize) -> ([u8; 16], [u8; 16]) {
+    let n = 16 / es;
+    let mut first = [0u8; 16];
+    let mut second = [0u8; 16];
+    let mut p = 0;
+    while p < n {
+        let g = v * n + p;
+        let (src, e) = (g % 3, g / 3);
+        if src < 2 {
+            first[p] = (src * n + e) as u8;
+            second[p] = p as u8;
+        } else {
+            second[p] = (n + e) as u8;
+        }
+        p += 1;
+    }
+    (elems_to_bytes(es, first), elems_to_bytes(es, second))
+}
+
+/// Indices extracting component `comp` from three vectors of 3-way interleaved elements: the
+/// first shuffle picks from `v0 || v1`, the second from `v2`.
+const fn deinterleave3_idx(es: usize, comp: usize) -> ([u8; 16], [u8; 16]) {
+    let n = 16 / es;
+    let mut first = [0u8; 16];
+    let mut second = [0u8; 16];
+    let mut i = 0;
+    while i < n {
+        let s = 3 * i + comp;
+        if s < 2 * n {
+            first[i] = s as u8;
+            second[i] = i as u8;
+        } else {
+            second[i] = (n + s - 2 * n) as u8;
+        }
+        i += 1;
+    }
+    (elems_to_bytes(es, first), elems_to_bytes(es, second))
+}
+
+/// Byte shuffle in memory order: byte `i` of the result is byte `idx[i]` of the 32-byte
+/// concatenation `a || b`.
+///
+/// # Safety
+/// VSX must be available.
+#[inline(always)]
+unsafe fn shuffle<T: Bytes>(a: T, b: T, idx: [u8; 16]) -> T {
+    // SAFETY: the caller guarantees VSX; `[u8; 16]` and the vector have the same size.
+    T::from_bytes(unsafe {
+        shuffle_var(
+            a.to_bytes(),
+            b.to_bytes(),
+            transmute::<[u8; 16], vector_unsigned_char>(idx),
+        )
+    })
+}
+
+/// Same as [`shuffle`], with indices that are only known at runtime.
+///
+/// # Safety
+/// VSX must be available.
+#[inline(always)]
+unsafe fn shuffle_var(
+    a: vector_unsigned_char,
+    b: vector_unsigned_char,
+    idx: vector_unsigned_char,
+) -> vector_unsigned_char {
+    // `vperm` numbers bytes in big-endian order, which is memory order on big-endian. On
+    // little-endian, stdarch's `vec_perm` swaps the inputs and complements the indices (like
+    // altivec.h), which also makes the indices refer to memory order.
+    // SAFETY: the caller guarantees VSX.
+    unsafe { vec_perm(a, b, idx) }
+}
+
+// The shuffle helpers take the element size in bytes as a const parameter, so that the index
+// tables are computed at compile time.
+
+/// # Safety
+/// VSX must be available.
+#[inline(always)]
+unsafe fn interleave2<const ES: usize, T: Bytes>(a: T, b: T) -> (T, T) {
+    // SAFETY: the caller guarantees VSX.
+    unsafe {
+        (
+            shuffle(a, b, const { interleave2_idx(ES, 0) }),
+            shuffle(a, b, const { interleave2_idx(ES, 1) }),
+        )
+    }
+}
+
+/// # Safety
+/// VSX must be available.
+#[inline(always)]
+unsafe fn interleave3<const ES: usize, T: Bytes>(a: T, b: T, c: T) -> (T, T, T) {
+    // SAFETY: the caller guarantees VSX.
+    let out = |(first, second)| unsafe { shuffle(shuffle(a, b, first), c, second) };
+    (
+        out(const { interleave3_idx(ES, 0) }),
+        out(const { interleave3_idx(ES, 1) }),
+        out(const { interleave3_idx(ES, 2) }),
+    )
+}
+
+/// Returns `[a0 b0 c0 d0 ...]` spread over four vectors.
+///
+/// # Safety
+/// VSX must be available.
+#[inline(always)]
+unsafe fn interleave4<const ES: usize, T: Bytes>(a: T, b: T, c: T, d: T) -> (T, T, T, T) {
+    let lo = const { interleave2_idx(2 * ES, 0) };
+    let hi = const { interleave2_idx(2 * ES, 1) };
+    // SAFETY: the caller guarantees VSX.
+    unsafe {
+        let (ab0, ab1) = interleave2::<ES, _>(a, b);
+        let (cd0, cd1) = interleave2::<ES, _>(c, d);
+        (
+            shuffle(ab0, cd0, lo),
+            shuffle(ab0, cd0, hi),
+            shuffle(ab1, cd1, lo),
+            shuffle(ab1, cd1, hi),
+        )
+    }
+}
+
+/// # Safety
+/// VSX must be available.
+#[inline(always)]
+unsafe fn deinterleave3<const ES: usize, T: Bytes>(v0: T, v1: T, v2: T) -> (T, T, T) {
+    // SAFETY: the caller guarantees VSX.
+    let out = |(first, second)| unsafe { shuffle(shuffle(v0, v1, first), v2, second) };
+    (
+        out(const { deinterleave3_idx(ES, 0) }),
+        out(const { deinterleave3_idx(ES, 1) }),
+        out(const { deinterleave3_idx(ES, 2) }),
+    )
+}
+
+/// # Safety
+/// `ptr` must be valid for writing 8 bytes.
+#[inline(always)]
+unsafe fn store_lo64<T: Bytes>(v: T, ptr: *mut u8) {
+    // SAFETY: vectors are plain bags of bits, lane 0 is the first 8 bytes in memory.
+    let lanes = unsafe { transmute::<vector_unsigned_char, [u64; 2]>(v.to_bytes()) };
+    // SAFETY: the caller guarantees that `ptr` is valid for 8 bytes.
+    unsafe { ptr.cast::<u64>().write_unaligned(lanes[0]) }
+}
+
+/// # Safety
+/// `ptr` must be valid for writing 4 bytes.
+#[inline(always)]
+unsafe fn store_lo32<T: Bytes>(v: T, ptr: *mut u8) {
+    // SAFETY: vectors are plain bags of bits, lane 0 is the first 4 bytes in memory.
+    let lanes = unsafe { transmute::<vector_unsigned_char, [u32; 4]>(v.to_bytes()) };
+    // SAFETY: the caller guarantees that `ptr` is valid for 4 bytes.
+    unsafe { ptr.cast::<u32>().write_unaligned(lanes[0]) }
+}
+
+/// Loads 8 bytes into the low half of a vector, zeroing the high half.
+///
+/// # Safety
+/// `ptr` must be valid for reading 8 bytes.
+#[inline(always)]
+unsafe fn load_lo64(ptr: *const u8) -> vector_unsigned_char {
+    // SAFETY: the caller guarantees that `ptr` is valid for 8 bytes.
+    let lo = unsafe { ptr.cast::<u64>().read_unaligned() };
+    // SAFETY: `[u64; 2]` and the vector have the same size.
+    unsafe { transmute::<[u64; 2], vector_unsigned_char>([lo, 0u64]) }
+}

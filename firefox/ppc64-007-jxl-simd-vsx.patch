+        Self(o0, a.1).store(&mut dest[..32]);
+        Self(o1, a.1).store(&mut dest[8..32]);
+        Self(o2, a.1).store(&mut dest[16..32]);
+        Self(o3, a.1).store(&mut dest[24..32]);
+    }
+
+    #[inline(always)]
+    fn bitcast_i16(self) -> I16VecVsx<L> {
+        I16VecVsx(cast(self.0), self.1)
+    }
+}

+/// Indices selecting the high half of each double-width product from the widening multiplies of
+/// lanes 0, 2, ... and lanes 1, 3, ... of `es`-byte lanes.
+const fn mul_high_idx(es: usize) -> [u8; 16] {
+    let n = 16 / es;
+    // Index of the high half within a double-width product.
+    let high = if BIG_ENDIAN { 0 } else { 1 };
+    let mut elems = [0u8; 16];
+    let mut i = 0;
+    while i < n {
+        let src = if i % 2 == 0 { 0 } else { n };
+        elems[i] = (src + (i / 2) * 2 + high) as u8;
+        i += 1;
+    }
+    elems_to_bytes(es, elems)
+}

-    defined(__BYTE_ORDER__) && (__BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__)
+#if defined(__powerpc64__) && defined(__VSX__)
 #define WEBP_USE_VSX
 #endif
 

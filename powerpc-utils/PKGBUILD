# Maintainer: Alexander Baldeck <alex.bldck@gmail.com>
pkgname=powerpc-utils
pkgver=1.3.10
pkgrel=1
pkgdesc="Contains utilities which are intended for maintenance of IBM powerpc platforms"
arch=(powerpc64le powerpc64 powerpc espresso)
url="https://github.com/ibm-power-utilities/powerpc-utils"
license=('GPL')
depends=(librtas numactl)
makedepends=(git)
source=("${pkgname}-${pkgver}::git+https://github.com/ibm-power-utilities/powerpc-utils.git?#tag=v${pkgver}"
        ibm-powerpc-utils-1.3.10-c23.patch)
md5sums=('8e0bad5776921fde3bf9651edef830df'
         '3a0dd3c2e9e8eff5a6a30cdf32a849ec')

prepare() {
  cd "$srcdir/${pkgname}-${pkgver}"

  patch -Np1 -i ${srcdir}/ibm-powerpc-utils-1.3.10-c23.patch

  sh autogen.sh
}

build() {
  cd "$srcdir/${pkgname}-${pkgver}"
  ./configure --prefix=/usr \
              --sbindir=/usr/bin \
              --with-systemd=/usr/lib/systemd/system \
              --disable-werror
  make
}

check() {
  cd "$srcdir/${pkgname}-${pkgver}"
  make -k check
}

package() {
  cd "$srcdir/${pkgname}-${pkgver}"
  make DESTDIR="$pkgdir/" install
}

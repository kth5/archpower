pkgbase=libmygpo-qt
pkgname=(libmygpo-qt6)
pkgver=1.2.0
pkgrel=2
pkgdesc='A C++/Qt client library for gpodder.net'
arch=(x86_64 powerpc64le powerpc64 powerpc espresso)
url=http://wiki.gpodder.org/wiki/Libmygpo-qt
license=(LGPL-2.1-or-later)
depends=(
  glibc
  libgcc
  libstdc++
  qt6-base
)
makedepends=(
  cmake
  doxygen
  git
  ninja
)
source=(git+https://github.com/gpodder/libmygpo-qt#tag=$pkgver)
b2sums=('e785b2f4e374f4d6a76fb8696903a145024344a1335050ad742a25047b8ea70f91292ba0abc04f500537eda02ef80f248f6298791fa35d9d0ce921f9c99be724')

build() {
  cmake -B build -S libmygpo-qt -G Ninja \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DMYGPO_BUILD_TESTS=OFF \
    -DBUILD_WITH_QT6=ON
  cmake --build build
}

package_libmygpo-qt6() {
  DESTDIR="${pkgdir}" cmake --install build
}

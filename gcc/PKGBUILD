# toolchain build order: linux-api-headers->glibc->binutils->gcc->glibc->binutils->gcc
# NOTE: libtool requires rebuilt with each new gcc version

pkgname=(
  gcc
  gcc-fortran
  gcc-go
  gcc-libs
  gcc-m2
  gcc-objc
  gcc-rust
  libasan
  libatomic
  libgcc
  libgccjit
  libgfortran
  libgm2
  libgo
  libgomp
  libitm
  libobjc
  libstdc++
  libubsan
  lto-dump
)
case ${CARCH} in
  x86_64) pkgname+=(gcc-ada gcc-d gcc-gcobol lib32-gcc-libs libcobol libgphobos libhwasan liblsan libquadmath libtsan) ;;
  powerpc64le) pkgname+=(gcc-ada lblsan ibtsan libquadmath) ;;
  powerpc64) pkgname+=(libtsan) ;;
  powerpc) pkgname+=(gcc-ada) ;;
esac
pkgver=16.2.1+r23+gd564253eb6c8
_commit=d564253eb6c859e266d3cae18e82fb4db9a88316
pkgrel=2
pkgdesc='The GNU Compiler Collection'
#arch=(x86_64 powerpc64le powerpc64 powerpc espresso)
arch=(powerpc64)
license=(
  'GPL-3.0-or-later WITH GCC-exception-3.1'
  GFDL-1.3-or-later
)
url='https://gcc.gnu.org'
makedepends=(
  binutils
  doxygen
  git
  libisl
  libmpc
  python
  rust
  zstd
)
makedepends_powerpc=(
  gcc-ada
)
makedepends_powerpc64le=(
  gcc-ada
)
makedepends_x86_64=(
  gcc-ada
  gcc-d
  lib32-glibc
  lib32-gcc-libs
)
checkdepends=(
  dejagnu
  expect
  inetutils
  python-pytest
  tcl
)
options=(
  !emptydirs
  !lto
)
_libdir=usr/lib/gcc/$CHOST/${pkgver%%.*}
source=(
  git+https://forge.sourceware.org/gcc/gcc#commit=$_commit
  c89
  c99
  gcc-ada-repro.patch
  tune_branch_prediction_cost.patch
  gcc-16.1.1-espresso.patch
)
sha256sums=('c4def1816bc86f2bb981deb958a572ca63eb0ef784418f0414f1071a4efee44d'
            '7b09ec947f90b98315397af675369a1e3dfc527fa70013062e6e85c4be0275ab'
            '44ea973558842f3f4bd666bdaf6e810fd7b7c7bd36b5cc4c69f93d2cd0124fc7'
            '1773f5137f08ac1f48f0f7297e324d5d868d55201c03068670ee4602babdef2f'
            '838e14d4ef76079107a5373316598025915eaf747a10522ec9f8842125ca9a8e'
            '5f81d9f9b2624a8f1f650faaa7e17fe13a54b9db80b684fa14c877de34e04253')
pkgver() {
  cd gcc
  echo "$(cat gcc/BASE-VER)+$(git describe --abbrev=12 --tags | sed 's/[^-]*-[^-]*-//;s/[^-]*-/r&/;s/-/+/g;s/_/./')"
}

prepare() {
  [[ ! -d gcc ]] && ln -s gcc-${pkgver/+/-} gcc
  cd gcc

  # Arch installs 64bit libraries /lib
  sed -i '/m64=/s/lib64/lib/' gcc/config/i386/t-linux64
  sed -i 's@/lib64@/lib@g' gcc/config/rs6000/t-*

  # add WiiU Espresso CPU bug work around
  if [[ "${CFLAGS}" == *"mcpu=espresso"* ]]; then
    msg2 "Patching for WiiU Espresso CPU bug to support SMP"
    patch -Np1 < "$srcdir/gcc-16.1.1-espresso.patch"
  fi

  # Reproducible gcc-ada
  patch -Np0 < "$srcdir"/gcc-ada-repro.patch

  # tune branch prediction cost
  patch -Np1 < ../tune_branch_prediction_cost.patch

  mkdir -p "$srcdir"/gcc-build
  mkdir -p "$srcdir"/libgccjit-build
}

build() {
  local _confflags=(
      --prefix=/usr
      --libdir=/usr/lib
      --libexecdir=/usr/lib
      --mandir=/usr/share/man
      --infodir=/usr/share/info
      --with-bugurl=https://git.archlinuxpower.org/ArchPOWER/packages/issues \
      --with-gcc-major-version-only
      --with-linker-hash-style=gnu
      --with-system-zlib
      --enable-checking=release
      --enable-clocale=gnu
      --enable-default-pie
      --enable-default-ssp
      --enable-gnu-indirect-function
      --enable-gnu-unique-object
      --enable-libstdcxx-backtrace
      --enable-link-serialization=1
      --enable-linker-build-id
      --enable-plugin
      --enable-shared
      --enable-threads=posix
      --disable-fixincludes
      --disable-libssp
      --disable-libstdcxx-pch
      --disable-werror
  )

  case "${CARCH}" in
    x86_64) _confflags+=(
             --with-build-config=bootstrap-lto
             --enable-lto
             --enable-multilib
             --enable-cet=auto
           )
           extra_lang=",ada,d,cobol"
    ;;
    powerpc64le)
           _confflags+=(
             --with-build-config=bootstrap-lto
             --enable-lto
             --enable-multilib
           )
           extra_lang=",ada"
    ;;
    powerpc)
           _confflags+=(
             --enable-multilib
           )
           extra_lang=",ada"
          # ensure staged binaries can actually run on espresso
          if [[ "${CFLAGS}" == *"mcpu=espresso"* ]]; then
            msg2 "Adding CFLAGS for WiiU Espresso CPU bug to support SMP"
           _confflags+=(
              --with-cpu=espresso
           )
          fi
    ;;
    powerpc64)
          _confflags+=(
             --with-build-config=bootstrap-lto
             --enable-lto
             --disable-multilib
             --with-abi=elfv2
         )
    ;;
  esac

  cd gcc-build

  # Credits @allanmcrae
  # https://github.com/allanmcrae/toolchain/blob/f18604d70c5933c31b51a320978711e4e6791cf1/gcc/PKGBUILD
  # TODO: properly deal with the build issues resulting from this
  CFLAGS=${CFLAGS/-Werror=format-security/}
  CXXFLAGS=${CXXFLAGS/-Werror=format-security/}

  ../gcc/configure \
    --enable-languages=c,c++,fortran,go,lto,m2,objc,obj-c++,rust${extra_lang} \
    --enable-bootstrap \
    "${_confflags[@]:?_confflags unset}"

  # see https://bugs.archlinux.org/task/71777 for rationale re *FLAGS handling
  make -O STAGE1_CFLAGS="-O2" \
          BOOT_CFLAGS="$CFLAGS" \
          BOOT_LDFLAGS="$LDFLAGS" \
          LDFLAGS_FOR_TARGET="$LDFLAGS" \
          bootstrap

  # make documentation
  make -O -C $CHOST/libstdc++-v3/doc doc-man-doxygen

  # Build libgccjit separately, to avoid building all compilers with --enable-host-shared
  # which brings a performance penalty
  cd "$srcdir"/libgccjit-build

  ../gcc/configure \
    --enable-languages=jit \
    --disable-bootstrap \
    --enable-host-shared \
    "${_confflags[@]:?_confflags unset}"

  make -O all-gcc

  cp -a gcc/libgccjit.so* ../gcc-build/gcc/
}

check() {
  # skip checks by default on powerpc*
  case "${CARCH}" in
    powerpc*) return 0 ;;
  esac

  cd gcc-build

  # disable libphobos test to avoid segfaults
  sed -i '/maybe-check-target-libphobos \\/d' Makefile

  # do not abort on error as some are "expected"
  make -O -k check || true
  "$srcdir"/gcc/contrib/test_summary
}

_pick() {
  local p="$1" f d; shift
  for f; do
    d="$srcdir/$p/${f#$pkgdir/}"
    mkdir -vp "$(dirname "$d")"
    mv -v "$f" "$d"
    rmdir -vp --ignore-fail-on-non-empty "$(dirname "$f")"
  done
}

_install_runtime_library_exception() {
  # Install Runtime Library Exception
  install -Dm644 "$srcdir"/gcc/COPYING.RUNTIME \
    "$pkgdir"/usr/share/licenses/$pkgname/RUNTIME.LIBRARY.EXCEPTION
}

package_gcc() {
  pkgdesc="The GNU Compiler Collection - C and C++ frontends"
  depends=(
    "libasan=$pkgver-$pkgrel"
    "libgcc=$pkgver-$pkgrel"
    "libstdc++=$pkgver-$pkgrel"
    "libubsan=$pkgver-$pkgrel"
    'binutils>=2.28'
    'glibc>=2.27'
    gmp
    libisl.so
    libmpc
    mpfr
    zlib
    zstd
  )
  depends_powerpc64=(
    "libtsan=$pkgver-$pkgrel"
  )
  depends_powerpc64le=(
    "libtsan=$pkgver-$pkgrel"
    "liblsan=$pkgver-$pkgrel"
  )
  depends_x86_64=(
    "libhwasan=$pkgver-$pkgrel"
    "liblsan=$pkgver-$pkgrel"
    "libtsan=$pkgver-$pkgrel"
  )
  optdepends_x86_64=(
    'lib32-gcc-libs: for generating code for 32-bit ABI'
  )
  provides=(
    $pkgname-multilib
  )
  replaces=(
    $pkgname-multilib
  )
  options=(
    !emptydirs
    staticlibs
  )

  cd gcc-build
  make DESTDIR="$pkgdir" install
  make -C gcc DESTDIR="$pkgdir" jit.install-common jit.install-info

  (
    cd "$pkgdir"

    # prepare internal *.so symlinks to ensure shared linking for those shared libs
    # where we ALSO ship a matching static lib in the internal _libdir
    _runtime_libs=(libatomic.so libstdc++.so);
    [ "${CARCH}" == 'x86_64' ] && _runetime_libs+=(libgphobos.so libgdruntime.so)
    for _so in ${_runtime_libs[@]}; do
      ln -srv usr/lib/$_so $_libdir/$_so
      [ "${CARCH}" == 'x86_64' ] && ln -srv usr/lib32/$_so $_libdir/32/$_so
    done

    case "${CARCH}" in
      x86_64)
        _pick gcc-ada usr/bin/gnat{,bind,chop,clean,kr,link,ls,make,name,prep}
        _pick gcc-ada $_libdir/{,32/}ada_target_properties
        _pick gcc-ada $_libdir/{,32/}ada{include,lib}/
        _pick gcc-ada $_libdir/gnat1
        _pick gcc-ada usr/share/info/gnat{-style,_rm,_ugn}.info
      ;;
      powerpc64le|powerpc)
        _pick gcc-ada usr/bin/gnat{,bind,chop,clean,kr,link,ls,make,name,prep}
        _pick gcc-ada $_libdir/ada_target_properties
        _pick gcc-ada $_libdir/ada{include,lib}/
        _pick gcc-ada $_libdir/gnat1
        _pick gcc-ada usr/share/info/gnat{-style,_rm,_ugn}.info
      ;;
    esac

    case "${CARCH}" in
      x86_64)
        _pick gcc-d usr/bin/{gdc,$CHOST-gdc}
        _pick gcc-d $_libdir/d21
        _pick gcc-d $_libdir/include/d/

        _pick gcc-d $_libdir/{,32/}libg{druntime,phobos}.so
        _pick gcc-d usr/lib{,32}/libg{druntime,phobos}.a
        _pick gcc-d usr/lib{,32}/libgphobos.spec
        _pick gcc-d usr/share/info/gdc.info
        _pick gcc-d usr/share/man/man1/gdc.1
      ;;
    esac

    _pick gcc-fortran usr/bin/{gfortran,$CHOST-gfortran}
    case "${CARCH}" in
      x86_64)
        _pick gcc-fortran $_libdir/{,32/}finclude/
        _pick gcc-fortran $_libdir/{,32/}libcaf_{shmem,single}.a
        _pick gcc-fortran usr/lib{,32}/libgfortran.spec
      ;;
      *)
        _pick gcc-fortran $_libdir/finclude/
        _pick gcc-fortran $_libdir/libcaf_{shmem,single}.a
        _pick gcc-fortran usr/lib/libgfortran.spec
      ;;
    esac
    _pick gcc-fortran $_libdir/f951
    _pick gcc-fortran $_libdir/include/ISO_Fortran_binding.h
    _pick gcc-fortran usr/share/info/gfortran.info
    _pick gcc-fortran usr/share/man/man1/gfortran.1

    case "${CARCH}" in
      x86_64)
        _pick gcc-gcobol usr/bin/{gcobc,gcobol,$CHOST-{gcobc,gcobol}}
        _pick gcc-gcobol $_libdir/cobol/
        _pick gcc-gcobol $_libdir/cobol1
        _pick gcc-gcobol usr/lib/libgcobol.spec
        _pick gcc-gcobol usr/share/man/man1/gcobol.1
        _pick gcc-gcobol usr/share/man/man3/gcobol-io.3
        _pick libgcobol usr/lib/libgcobol.{a,so*}
      ;;
    esac

    _pick gcc-go usr/bin/{gccgo,go,gofmt,$CHOST-gccgo}
    _pick gcc-go $_libdir/{buildid,cgo,go1,test2json,vet}
    case "${CARCH}" in
      x86_64)
        _pick gcc-go usr/lib{,32}/go/
        _pick gcc-go usr/lib{,32}/lib{go,gobegin,golibbegin}.a
      ;;
      *)
        _pick gcc-go usr/lib/go/
        _pick gcc-go usr/lib/lib{go,gobegin,golibbegin}.a
      ;;
    esac
    _pick gcc-go usr/share/info/gccgo.info
    _pick gcc-go usr/share/man/man1/{gccgo,go,gofmt}.1

    _pick gcc-m2 usr/bin/{gm2,$CHOST-gm2}
    _pick gcc-m2 $_libdir/cc1gm2
    _pick gcc-m2 usr/share/info/m2.info
    _pick gcc-m2 usr/share/man/man1/gm2.1

    _pick gcc-objc $_libdir/include/objc/
    _pick gcc-objc $_libdir/cc1obj*

    _pick gcc-rust usr/bin/{gccrs,$CHOST-gccrs}
    _pick gcc-rust $_libdir/crab1

    case "${CARCH}" in
      x86_64)
        _pick lib32-gcc-libs usr/lib32/libasan.{a,so*}
        _pick lib32-gcc-libs usr/lib32/libatomic.so*
        _pick lib32-gcc-libs $_libdir/32/libatomic.so
        _pick lib32-gcc-libs usr/lib32/libgcc_s.so.*
        _pick lib32-gcc-libs usr/lib32/libgdruntime.so*
        _pick lib32-gcc-libs usr/lib32/libgfortran.{a,so*}
        _pick lib32-gcc-libs usr/lib32/libgo.so*
        _pick lib32-gcc-libs usr/lib32/libgomp.{a,so*}
        _pick lib32-gcc-libs usr/lib32/libgphobos.so*
        _pick lib32-gcc-libs usr/lib32/libitm.{a,so*}
        _pick lib32-gcc-libs usr/lib32/libobjc.{a,so*}
        _pick lib32-gcc-libs usr/lib32/libquadmath.{a,so*}
        _pick lib32-gcc-libs usr/lib32/libstdc++.so*
        _pick lib32-gcc-libs usr/lib32/libubsan.{a,so*}
      ;;
    esac

    _pick libasan usr/lib/libasan.{a,so*}

    _pick libatomic usr/lib/libatomic.so*
    _pick libatomic $_libdir/libatomic.so

    _pick libgcc usr/lib/libgcc_s.so.*

    _pick libgccjit usr/include/libgccjit*
    _pick libgccjit usr/lib/libgccjit.so*
    _pick libgccjit usr/share/info/libgccjit.info

    _pick libgfortran usr/lib/libgfortran.{a,so*}

    case "${CARCH}" in
      x86_64)
        _pick libgm2 $_libdir/{,32/}m2/
        _pick libgm2 usr/lib{,32}/libm2{cor,iso,log,min,pim}.{a,so*}
      ;;
      *)
        _pick libgm2 $_libdir/m2/
        _pick libgm2 usr/lib/libm2{cor,iso,log,min,pim}.{a,so*}
      ;;
    esac

    _pick libgo usr/lib/libgo.so*

    _pick libgomp usr/lib/libgomp.{a,so*}
    _pick libgomp usr/share/info/libgomp.info

    case "${CARCH}" in
      x86_64)
        _pick libgphobos usr/lib/libgdruntime.so*
        _pick libgphobos usr/lib/libgphobos.so*

        _pick libhwasan usr/lib/libhwasan.{a,so*}
      ;;
    esac

    _pick libitm usr/lib/libitm.{a,so*}
    _pick libitm usr/share/info/libitm.info

    case "${CARCH}" in
      powerpc64le|x86_64)
        _pick liblsan usr/lib/liblsan.{a,so*}
        _pick libquadmath usr/lib/libquadmath.{a,so*}
        _pick libquadmath usr/share/info/libquadmath.info
      ;;
    esac

    _pick libobjc usr/lib/libobjc.{a,so*}

    _pick libstdc++ usr/lib/libstdc++.so*
    _pick libstdc++ usr/share/locale/{de,fr}/LC_MESSAGES/libstdc++.mo

    case "${CARCH}" in
      powerpc64*|x86_64)
        _pick libtsan usr/lib/libtsan.{a,so*}
      ;;
    esac

    _pick libubsan usr/lib/libubsan.{a,so*}

    _pick lto-dump usr/bin/lto-dump
    _pick lto-dump usr/share/man/man1/lto-dump.1

    # move specific files into the internal "_libdir"
    mv -v usr/lib/libgcc_s{,_asneeded}.so $_libdir/
    mv -v usr/lib/libatomic{,_asneeded}.a usr/lib/libatomic_asneeded.so $_libdir/
    mv -v usr/lib/*_preinit.o $_libdir/
    mv -v usr/lib/*.spec $_libdir/
    mv -v usr/lib/libstdc++{,exp,fs}.a $_libdir/
    mv -v usr/lib/libsupc++.a $_libdir/
    case "${CARCH}" in
      x86_64)
        mv -v usr/lib32/libgcc_s{,_asneeded}.so $_libdir/32/
        mv -v usr/lib32/libatomic{,_asneeded}.a usr/lib32/libatomic_asneeded.so $_libdir/32/
        mv -v usr/lib32/*_preinit.o $_libdir/32/
        mv -v usr/lib32/*.spec $_libdir/32/
        mv -v usr/lib32/libstdc++{,exp,fs}.a $_libdir/32/
        mv -v usr/lib32/libsupc++.a $_libdir/32/
      ;;
    esac
  )

  install -d "$pkgdir"/usr/share/gdb/auto-load/usr/lib
  mv ../libstdc++/usr/lib/libstdc++.so.6.*-gdb.py \
    "$pkgdir"/usr/share/gdb/auto-load/usr/lib/

  install -dm755 "$pkgdir"/usr/lib/bfd-plugins/
  ln -s /$_libdir/liblto_plugin.so \
    "$pkgdir"/usr/lib/bfd-plugins/

  # many packages expect this symlink
  ln -s gcc "$pkgdir"/usr/bin/cc

  # create cc-rs compatible symlinks
  # https://github.com/rust-lang/cc-rs/blob/1.0.73/src/lib.rs#L2578-L2581
  for binary in {c++,g++,gcc,gcc-ar,gcc-nm,gcc-ranlib}; do
    if [[ "${CFLAGS}" == *"mcpu=espresso"* ]]; then
      ln -sf "/usr/bin/${binary}" "${pkgdir}"/usr/bin/powerpc-espresso-linux-gnu-${binary}
    else
      ln -sf "/usr/bin/${binary}" "${pkgdir}"/usr/bin/${CHOST}-${binary}
    fi
  done

  # POSIX conformance launcher scripts for c89 and c99
  install -Dm755 "$srcdir"/c89 "$pkgdir"/usr/bin/c89
  install -Dm755 "$srcdir"/c99 "$pkgdir"/usr/bin/c99

  # install the libstdc++ man pages
  make -C $CHOST/libstdc++-v3/doc DESTDIR="$pkgdir" doc-install-man

  # byte-compile python libraries
  python -m compileall "$pkgdir"/usr/share/gcc-${pkgver%%.*}/
  python -O -m compileall "$pkgdir"/usr/share/gcc-${pkgver%%.*}/

  _install_runtime_library_exception
}

package_gcc-ada() {
  pkgdesc='Ada front-end for GCC (GNAT)'
  depends=(
    "gcc=$pkgver-$pkgrel"
    'glibc>=2.27'
    gmp
    libgcc
    libisl.so
    libmpc
    mpfr
    zlib
    zstd
  )
  provides=(
    $pkgname-multilib
  )
  replaces=(
    $pkgname-multilib
  )
  options=(
    !emptydirs
    staticlibs
  )

  mv -v $pkgname/* "$pkgdir"
  ln -s gcc "$pkgdir"/usr/bin/gnatgcc

  # insist on dynamic linking, but keep static libraries because gnatmake complains
  mv "$pkgdir"/$_libdir/adalib/libgna{rl,t}-${pkgver%%.*}.so "$pkgdir"/usr/lib
  ln -s libgnarl-${pkgver%%.*}.so "$pkgdir"/usr/lib/libgnarl.so
  ln -s libgnat-${pkgver%%.*}.so "$pkgdir"/usr/lib/libgnat.so
  rm -f "$pkgdir"/$_libdir/adalib/libgna{rl,t}.so

  case "${CARCH}" in
    x86_64)
      install -d "$pkgdir"/usr/lib32/
      mv "$pkgdir"/$_libdir/32/adalib/libgna{rl,t}-${pkgver%%.*}.so "$pkgdir"/usr/lib32
      ln -s libgnarl-${pkgver%%.*}.so "$pkgdir"/usr/lib32/libgnarl.so
      ln -s libgnat-${pkgver%%.*}.so "$pkgdir"/usr/lib32/libgnat.so
      rm -f "$pkgdir"/$_libdir/32/adalib/libgna{rl,t}.so
    ;;
  esac

  _install_runtime_library_exception
}

package_gcc-d() {
  pkgdesc="D frontend for GCC"
  depends=(
    "gcc=$pkgver-$pkgrel"
    'glibc>=2.27'
    gmp
    libgphobos
    libisl.so
    libmpc
    mpfr
    zlib
    zstd
  )
  provides=(
    gdc
  )
  replaces=(
    gdc
  )
  options=(
    !emptydirs
    staticlibs
  )

  mv -v $pkgname/* "$pkgdir"
  mkdir -pv "$pkgdir"/$_libdir/32
  mv -v "$pkgdir"/usr/lib/libg{druntime,phobos}.a "$pkgdir"/$_libdir/
  mv -v "$pkgdir"/usr/lib/libgphobos.spec "$pkgdir"/$_libdir/
  case "${CARCH}" in
    x86_64)
      mv -v "$pkgdir"/usr/lib32/libg{druntime,phobos}.a "$pkgdir"/$_libdir/32
      mv -v "$pkgdir"/usr/lib32/libgphobos.spec "$pkgdir"/$_libdir/32
    ;;
  esac

  _install_runtime_library_exception
}

package_gcc-fortran() {
  pkgdesc='Fortran front-end for GCC'
  depends=(
    "gcc=$pkgver-$pkgrel"
    'glibc>=2.27'
    gmp
    libgfortran
    libisl.so
    libmpc
    mpfr
    zlib
    zstd
  )
  provides=(
    $pkgname-multilib
  )
  replaces=(
    $pkgname-multilib
  )

  mv -v $pkgname/* "$pkgdir"
  ln -s gfortran "$pkgdir"/usr/bin/f95
  mv -v "$pkgdir"/usr/lib/libgfortran.spec "$pkgdir"/$_libdir/
  case "${CARCH}" in
    x86_64)
      mv -v "$pkgdir"/usr/lib32/libgfortran.spec "$pkgdir"/$_libdir/32
    ;;
  esac

  _install_runtime_library_exception
}

package_gcc-gcobol() {
  pkgdesc="Cobol frontend for GCC"
  depends=(
    "gcc=$pkgver-$pkgrel"
    'glibc>=2.27'
    gmp
    libgcobol
    libisl.so
    libmpc
    mpfr
    zlib
    zstd
  )

  mv -v $pkgname/* "$pkgdir"
  mv -v "$pkgdir"/usr/lib/libgcobol.spec "$pkgdir"/$_libdir/
  _install_runtime_library_exception
}

package_gcc-go() {
  pkgdesc='Go front-end for GCC'
  depends=(
    "gcc=$pkgver-$pkgrel"
    'glibc>=2.27'
    gmp
    libgo
    libisl.so
    libmpc
    mpfr
    zlib
    zstd
  )
  provides=(
    "go=1.17"
    $pkgname-multilib
  )
  replaces=(
    $pkgname-multilib
  )
  conflicts=(
    go
  )

  mv -v $pkgname/* "$pkgdir"
  _install_runtime_library_exception
}

package_gcc-libs() {
  pkgdesc='Runtime libraries shipped by GCC'
  depends=(
    'glibc>=2.27'
    libasan
    libatomic
    libgcc
    libgfortran
    libgomp
    libobjc
    libstdc++
    libubsan
  )
  depends_powerpc64=(libtsan)
  depends_powerpc64le=(liblsan libquadmath libtsan)
  depends_x86_64=(libhwasan liblsan libquadmath libtsan)
  provides=(
    $pkgname-multilib
  )
}


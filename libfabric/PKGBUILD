# Maintainer: Jakub Klinkovský <lahwaacz at archlinux dot org>

pkgname=libfabric
pkgver=2.7.0
pkgrel=1
pkgdesc="User-space API for OpenFabrics Interfaces (OFI)"
arch=(x86_64 powerpc64le powerpc64 powerpc espresso)
url="https://ofiwg.github.io/libfabric/"
license=('BSD-2-Clause OR GPL-2.0-or-later')
depends=(glibc numactl)
options=(!lto)
source=(https://github.com/ofiwg/libfabric/releases/download/v${pkgver}/libfabric-${pkgver}.tar.bz2)
sha512sums=('1f1614aeb8fac2166ccc0e6dffb9c32704dbff7cbc4988126e5603280fc33f6b65d22cd29ae4fe16516999b5fb44be46b6f6ecd823e2bc2cc586d26242389c9e')

prepare() {
  cd ${pkgname}-${pkgver}
  autoreconf -fvi
}

build() {
  case "${CARCH}" in
    powerpc) export CFLAGS+=' -latomic' ;;
  esac

  cd ${pkgname}-${pkgver}
  ./configure --prefix=/usr
  sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool
  make
}

check() {
  cd ${pkgname}-${pkgver}
  make test
}

package() {
  cd ${pkgname}-${pkgver}
  make DESTDIR="${pkgdir}" install
  install -vDm 644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname/"
}

pkgname = linux-wii
	pkgdesc = The Linux (powerpc / Wii-Linux) kernel and modules
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = wii-linux-firmware: OpenFWWF firmware for the Wii's Broadcom 4318 WiFi card
	provides = KSMBD-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	replaces = virtualbox-guest-modules-arch
	replaces = wireguard-arch

pkgname = linux-wii-headers
	pkgdesc = Headers and scripts for building modules for the Linux (powerpc / Wii-Linux) kernel
	depends = pahole

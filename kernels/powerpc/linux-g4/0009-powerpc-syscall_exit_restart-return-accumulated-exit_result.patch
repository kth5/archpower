--- a/arch/powerpc/kernel/interrupt.c
+++ b/arch/powerpc/kernel/interrupt.c
@@ -175,7 +175,13 @@
 	current_thread_info()->exit_flags &= ~_TIF_RESTOREALL;
 	regs->exit_result |= ret;
 
-	return ret;
+	/*
+	 * Return the accumulated result, not just what this restart added.
+	 * The asm uses this to choose between a full GPR restore and the
+	 * fast path that zeroes r4-r12, so dropping the _TIF_RESTOREALL
+	 * that start_thread() set would zero the ELFv2 entry point in r12.
+	 */
+	return regs->exit_result;
 }
 #endif
 

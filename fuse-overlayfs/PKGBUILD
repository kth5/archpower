pkgdesc='FUSE implementation of overlayfs'
pkgname=fuse-overlayfs
pkgver=1.17
pkgrel=1
arch=(x86_64 powerpc64le powerpc64 powerpc espresso)
url=https://github.com/containers/fuse-overlayfs
license=(GPL-2.0-only)
depends=(fuse3)
makedepends=(git)
source=("git+https://github.com/containers/fuse-overlayfs.git#tag=v$pkgver?signed")
validpgpkeys=('AC404C1C0BF735C63FF4D562263D6DF2E163E1EA')
sha512sums=('d023fd140141249b3dd398ebff8ec753464821626232d31d94eb4b81b85991266b4c18924f27e8fb1f57d16b75c7248d5b41503aabd74c1e12dcf28a8dcb4f27')

build () {
	cd "${pkgname}"
	autoreconf -fis
	./configure \
		--prefix=/usr \
		--sbindir=/usr/bin
	make
}

check(){
	cd "${pkgname}"
	make check
}

package (){
	cd "${pkgname}"
	make DESTDIR="${pkgdir}" install
}

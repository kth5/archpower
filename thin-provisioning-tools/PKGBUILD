# Maintainer: Eric Bélanger <eric@archlinux.org>
# Contributor: Jason Hall <cakersq@gmail.com>

pkgname=thin-provisioning-tools
pkgver=1.3.4
pkgrel=1
pkgdesc='Suite of tools for manipulating the metadata of the dm-thin device-mapper target'
arch=(x86_64 powerpc64le powerpc64 powerpc espresso)
url='https://github.com/jthornber/thin-provisioning-tools'
license=('GPL-3.0-only')
depends=('glibc'
         'libgcc' 'libgcc_s.so'
         'systemd-libs' 'libudev.so')
makedepends=('git' 'cargo' 'clang' 'device-mapper')
source=("git+https://github.com/jthornber/thin-provisioning-tools#tag=v${pkgver}"
        hotfix-no-atomic64.diff)
sha256sums=('e5614cfe9065509afb7eb614ccdc5ef3f6a4c0571e3228cffb3d0f1cc664f7d0'
            '6eb1ecd180a3184374ac930b5a69414dc664cde14ba7945b008d5c3357e5784d')

prepare() {
  cd "${srcdir}/${pkgname}"

  case "${CARCH}" in
    powerpc)
      # T2 is awesome
      patch -Np1 -i ${srcdir}/hotfix-no-atomic64.diff
    ;;
  esac

  cargo fetch --locked --target host-tuple
}

build() {
  cd "${srcdir}/${pkgname}"

  # Use LTO
  export CARGO_PROFILE_RELEASE_LTO=true
  export CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1

  cargo build --frozen --release
}

check() {
  cd "${srcdir}/${pkgname}"

  case "${CARCH}" in
    powerpc) return 0 ;;
  esac

  cargo test --frozen --all-features
}

package() {
  cd "${srcdir}/${pkgname}"

  make \
    DESTDIR="${pkgdir}"/usr \
    BINDIR="${pkgdir}"/usr/bin \
    DATADIR="${pkgdir}"/usr/share \
    install
}

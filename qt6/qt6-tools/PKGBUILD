# Maintainer: Felix Yan <felixonmars@archlinux.org>
# Contributor: Andrea Scarpino <andrea@archlinux.org>

pkgname=qt6-tools
_pkgver=6.12.0
pkgver=${_pkgver/-/}
pkgrel=1
arch=(x86_64 powerpc64le powerpc64 powerpc espresso)
url='https://www.qt.io'
license=(GPL-3.0-only
         LGPL-3.0-only
         LicenseRef-Qt-Commercial
         Qt-GPL-exception-1.0)
pkgdesc='A cross-platform application and UI framework (Development Tools, QtHelp)'
depends=(glibc
         libstdc++
         litehtml
         libgcc
         qt6-base
         zstd)
makedepends=(clang21
             cmake
             git
             llvm
             ninja
             qt6-declarative
             vulkan-headers)
optdepends=('clang: for qdoc and lupdate'
            'qt6-declarative: for qdistancefieldgenerator, qdoc and lupdate')
groups=(qt6)
_pkgfn=${pkgname/6-/}
source=(git+https://code.qt.io/qt/$_pkgfn#tag=v$_pkgver
        git+https://code.qt.io/playground/qlitehtml
        ppc32-undef-ppc.patch)
sha256sums=('3a444970b514ccf63ff5f67595fad30320447f1580828a7d16e37ed3f3e6ddd2'
            'SKIP'
            '7f59aa3e24209609aabd26964c78840bf541f7d6cc12a6e681acda91bff9626d')

prepare() {
  cd $_pkgfn
  git submodule init
  git submodule set-url src/assistant/qlitehtml "$srcdir"/qlitehtml
  git -c protocol.file.allow=always submodule update
  patch -Np1 < ../ppc32-undef-ppc.patch
# Drop unneeded litehtml include
  sed -e '/litehtml\/types.h/d' -i src/assistant/qlitehtml/src/container_qpainter_p.h
}

build() {
  export CLANG_INSTALL_DIR=/usr/lib/llvm21
  export LLVM_INSTALL_DIR=/usr/lib/llvm21

  cmake -B build -S $_pkgfn -G Ninja \
    -DQT_INSTALL_XDG_DESKTOP_ENTRIES=ON \
    -DQLITEHTML_USE_SYSTEM_LITEHTML=ON \
    -Dlitehtml_DIR=/usr/lib/cmake/litehtml0.9 \
    -DCMAKE_MESSAGE_LOG_LEVEL=STATUS
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  install -d "$pkgdir"/usr/share/licenses
  ln -s /usr/share/licenses/qt6-base "$pkgdir"/usr/share/licenses/$pkgname
}

pkgbase = ruby-tilt
	pkgdesc = Generic interface to multiple Ruby template engines.
	pkgver = 2.8.0
	pkgrel = 1
	url = https://github.com/jeremyevans/tilt
	arch = any
	license = MIT
	makedepends = ruby-rdoc
	depends = ruby
	optdepends = asciidoctor: .ad, .adoc, .asciidoc
	optdepends = ruby-builder: .builder
	optdepends = ruby-csv: .rcsv
	optdepends = ruby-erb: .erb, .rhtml
	optdepends = ruby-erubi: .erb, .rhtml, .erubi
	optdepends = ruby-haml: .haml
	optdepends = ruby-kramdown: .markdown, .mkd, .md
	optdepends = ruby-liquid: .liquid
	optdepends = ruby-maruku: .markdown, .mkd, .md
	optdepends = ruby-nokogiri: .nokogiri
	optdepends = ruby-pandoc-ruby: .markdown, .mkd, .md, .rst
	optdepends = ruby-rdiscount: .erb, .rhtml
	optdepends = ruby-rdoc: .rdoc
	optdepends = ruby-redcarpet: .markdown, .mkd, .md
	optdepends = ruby-redcloth: .textile
	optdepends = ruby-sass-embedded: .sass, .scss
	optdepends = ruby-slim: .slim
	options = !emptydirs

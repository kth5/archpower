# Maintainer : Daniel Bermond <dbermond@archlinux.org>
# Contributor: drakkan <nicola.murino at gmail dot com>

pkgname=openh264
pkgver=2.7.0
pkgrel=1
# https://github.com/cisco/openh264/blob/v2.7.0/Makefile#L33
_gtestver=1.15.2
pkgdesc='H.264 encoder and decoder'
arch=(x86_64 powerpc64le powerpc64 powerpc espresso)
url='https://www.openh264.org/'
license=('BSD-2-Clause')
depends=(
    'glibc'
    'libgcc'
    'libstdc++')
makedepends=(
    'nasm')
provides=('libopenh264.so')
source=("https://github.com/cisco/openh264/archive/v${pkgver}/${pkgname}-${pkgver}.tar.gz"
        "https://github.com/google/googletest/archive/v${_gtestver}/googletest-${_gtestver}.tar.gz")
sha256sums=('5178775c8b440073e70920e97d195efff721c0e56d0a78cc82c919e95d54924d'
            '7b42b4d6ed48810c5362c265a17faebe90dc2373c885e5216439d37927f02926')

prepare() {
    ln -sf "../googletest-${_gtestver}" "${pkgname}-${pkgver}/gtest"
}

build() {
    make -C "${pkgname}-${pkgver}"
}

check() {
    case "${CARCH}" in
      powerpc|powerpc64) return 0 ;;
    esac

    make -C "${pkgname}-${pkgver}" test
    cd "${pkgname}-${pkgver}/testbin"
    ./CmdLineExample.sh
}

package() {
    make -C "${pkgname}-${pkgver}" DESTDIR="$pkgdir" PREFIX='/usr' install-shared
    install -D -m755 "${pkgname}-${pkgver}"/h264{dec,enc} -t "${pkgdir}/usr/bin"
    install -D -m644 "${pkgname}-${pkgver}/LICENSE" -t "${pkgdir}/usr/share/licenses/${pkgname}"
}

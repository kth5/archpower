diff --git a/lrzip_private.h b/lrzip_private.h
index d524b89..4abea03 100644
--- a/lrzip_private.h
+++ b/lrzip_private.h
@@ -33,14 +33,9 @@
 #include <semaphore.h>
 #include <stdatomic.h>
 
-/* lrzip requires a 64-bit platform (large windows, no 32-bit path left). */
-#if defined(__SIZEOF_POINTER__) && (__SIZEOF_POINTER__ < 8)
-# error "lrzip requires a 64-bit architecture"
-#elif defined(UINTPTR_MAX) && (UINTPTR_MAX < 0xffffffffffffffffULL)
-# error "lrzip requires a 64-bit architecture"
-#endif
-_Static_assert(sizeof(void *) >= 8, "lrzip requires a 64-bit architecture");
-_Static_assert(sizeof(long) >= 8, "lrzip requires a 64-bit architecture");
+/* ILP32 is supported. Lengths are i64 and single read/write calls are
+ * capped by MAX_RW_COUNT. BITS32 keeps compression windows inside the
+ * 32-bit address space (see setup_ram). */
 
 #ifdef HAVE_PTHREAD_H
 # include <pthread.h>
@@ -269,6 +264,8 @@ typedef sem_t cksem_t;
 
 #define NO_MD5		(!(HASH_CHECK) && !(HAS_MD5))
 
+#define BITS32		(sizeof(void *) < 8)
+
 #define CTYPE_NONE 3
 #define CTYPE_BZIP2 4
 #define CTYPE_LZO 5
@@ -291,6 +288,10 @@ typedef sem_t cksem_t;
 #define SALT_LEN 8
 #define CBC_LEN 16
 
+/* ~1GB. Historical 32-bit chunk cap: signed sizes and the
+ * kernel/user split cannot hold a multi-gigabyte window. */
+#define one_g		((i64)1000 * 1024 * 1024)
+
 #ifndef PAGE_SIZE
 # ifdef _SC_PAGE_SIZE
 #  define PAGE_SIZE (sysconf(_SC_PAGE_SIZE))

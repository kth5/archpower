diff --git a/util.c b/util.c
index 60679ae..197fb24 100644
--- a/util.c
+++ b/util.c
@@ -143,6 +143,33 @@ void setup_overhead(rzip_control *control)
 		if (dictsize > dictcap)
 			dictsize = dictcap;
 
+		if (BITS32) {
+			/* ILP32 LZMA rejects dictionaries above 128MB. The
+			 * encoder also needs ~11.5x that dictionary, and
+			 * open_stream_out probes the whole reservation with
+			 * one malloc, so keep it inside a 1GB budget. */
+			i64 threads = control->threads > 0 ? control->threads : 1;
+			i64 fixed = ((i64)6 << 20) + 16384;
+			i64 per = one_g / threads;
+			i64 max_dict = (i64)1 << 20;
+
+			if (per > fixed) {
+				max_dict = (per - fixed) * 2 / 23;
+				if (max_dict > ((i64)1 << 27))
+					max_dict = (i64)1 << 27;
+				if (max_dict >= ((i64)1 << 20)) {
+					i64 pow = (i64)1 << 20;
+
+					while ((pow << 1) <= max_dict)
+						pow <<= 1;
+					max_dict = pow;
+				} else
+					max_dict = (i64)1 << 20;
+			}
+			if (dictsize > max_dict)
+				dictsize = max_dict;
+		}
+
 		control->lzma_dictsize = dictsize;
 		print_maxverbose("Using lzma dictionary size %"PRId64" for single block ultra\n",
 				 dictsize);
@@ -169,7 +196,16 @@ void setup_ram(rzip_control *control)
 		control->maxram = control->ramsize / 6;
 	else
 		control->maxram = control->ramsize / 3;
-	control->usable_ram = control->maxram;
+	if (BITS32) {
+		/* 32-bit userspace: the kernel/user split leaves at most
+		 * about 3GB, and the rzip window has to share that with
+		 * the backend buffers. Keep the heuristic under 1GB.
+		 */
+		control->usable_ram = MAX(control->ramsize - 900000000ll, 900000000ll);
+		control->maxram = MIN(control->maxram, control->usable_ram);
+		control->maxram = MIN(control->maxram, one_g * 2 / 3);
+	} else
+		control->usable_ram = control->maxram;
 	round_to_page(&control->maxram);
 }
 

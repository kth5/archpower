-		print_maxverbose("lz4 testing OK for chunk %ld. Compressed size = %5.2F%% of chunk, %d Passes (applied to all blocks)\n",
+		print_maxverbose("lz4 testing OK for chunk %"PRId64". Compressed size = %5.2F%% of chunk, %d Passes (applied to all blocks)\n",

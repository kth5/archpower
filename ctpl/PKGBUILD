pkgname=ctpl
pkgver=0.3.5
pkgrel=3
pkgdesc='Template engine library written in C'
arch=(x86_64 powerpc64le powerpc64 powerpc espresso)
url='https://ctpl.tuxfamily.org/'
license=(GPL-2.0-or-later)
makedepends=(gtk-doc)
source=("https://git.tuxfamily.org/ctpl/ctpl.git/snapshot/ctpl-$pkgver.tar.xz")
b2sums=('6ec45d9b3579304dfd93a42ffaa7f886ecbcd5ec5ef66043fb18da95a1854f9853ee8ed94e421c076a170c19560cb9f4a91628c66a9cf3ebf47d42128ca5eda7')

build() {
  cd $pkgname-$pkgver
  ./autogen.sh
  ./configure --prefix=/usr
  make
}

package() {
  make -C $pkgname-$pkgver DESTDIR="$pkgdir" install
}
